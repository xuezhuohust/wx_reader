/** Notion-inspired Design System **/
page {
  /* Brand & Primary */
  --notion-primary: rgb(19, 30, 56);
  --notion-primary-pressed: rgb(10, 15, 30);
  --notion-brand-navy: rgb(19, 30, 56);
  
  /* UI Surface & Backgrounds */
  --bg-canvas: #ffffff;
  --bg-surface: #f6f5f4;
  --bg-surface-soft: #fafaf9;
  
  /* Ink & Text */
  --ink-deep: #000000;
  --ink: #1a1a1a;
  --charcoal: #37352f;
  --slate: #5d5b54;
  --steel: #787671;
  --stone: #a4a097;
  --muted: #bbb8b1;
  
  /* Borders & Hairlines */
  --hairline: #e5e3df;
  --hairline-soft: #ede9e4;
  --hairline-strong: #c8c4be;
  
  /* Semantic */
  --semantic-success: #1aae39;
  --semantic-warning: #dd5b00;
  --semantic-error: #e03131;

  /* Theme Colors */
  --theme-reader: #131e38;
  --theme-publisher: rgb(10, 120, 105); /* Updated to exact color requested */
  --theme-active: var(--theme-reader); /* Default */
  
  /* Card Tints */
  --tint-peach: #ffe8d4;
  --tint-rose: #fde0ec;
  --tint-mint: #d9f3e1;
  --tint-lavender: #e6e0f5;
  --tint-sky: #dcecfa;
  --tint-yellow: #fef7d6;
  --tint-yellow-bold: #f9e79f;
  --tint-cream: #f8f5e8;
  --tint-gray: #f0eeec;

  /* Chart Colors */
  --chart-1: #5645d4; /* Purple */
  --chart-2: #2a9d99; /* Teal */
  --chart-3: #dd5b00; /* Orange */
  --chart-4: #ff64c8; /* Pink */
  --chart-5: #1aae39; /* Green */

  /* Radius */
  --radius-xs: 4rpx;
  --radius-sm: 6rpx;
  --radius-md: 8rpx;
  --radius-lg: 12rpx;
  --radius-xl: 16rpx;
  --radius-full: 9999rpx;

  background: var(--bg-canvas);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  -webkit-font-smoothing: antialiased;
  line-height: 1.55;
}

view,
text,
button,
input,
textarea,
picker,
scroll-view {
  box-sizing: border-box;
}

/* Typography */
.text-hero {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.1;
  letter-spacing: -1rpx;
}

.text-h1 { font-size: 48rpx; font-weight: 600; line-height: 1.2; }
.text-h2 { font-size: 36rpx; font-weight: 600; line-height: 1.2; }
.text-h3 { font-size: 32rpx; font-weight: 600; line-height: 1.3; }
.text-body { font-size: 30rpx; line-height: 1.55; color: var(--charcoal); }
.text-sm { font-size: 26rpx; line-height: 1.5; color: var(--slate); }
.text-caption { font-size: 24rpx; line-height: 1.4; color: var(--steel); }

/* Common Components */
.btn-primary {
  background: var(--notion-primary);
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 36rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-primary:active {
  background: var(--notion-primary-pressed);
}

.btn-secondary {
  background: transparent;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 36rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--hairline-strong);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-ghost {
  background: transparent;
  color: var(--ink);
  font-size: 28rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-base {
  background: var(--bg-canvas);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--hairline);
  padding: 32rpx;
}

/* Page Shell */
.page-shell {
  min-height: 100vh;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  animation: fadeIn 0.4s ease-out;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(20rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

