/** Academic Immersive Reading Design System **/

/* Hide scrollbars - 微信小程序不应显示滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

page {
  height: 100%;
  min-height: 100%;
  overflow-x: hidden;
  /* Primary - Sage Green */
  --primary: #1e40af; /* Academic Navy Blue */
  --primary-pressed: #1e3a8a;
  --primary-container: #2563eb;
  --on-primary: #ffffff;
  --on-primary-container: #eff6ff;

  /* Surface & Backgrounds */
  --bg-canvas: #f8fafc;
  --bg-surface: #f1f5f9;
  --bg-surface-soft: #f8fafc;
  --surface-container-low: #f3f4f5;
  --surface-container: #edeeef;
  --surface-container-high: #e7e8e9;
  --surface-lowest: #ffffff;

  /* Ink & Text */
  --ink: #0f172a;
  --charcoal: #0f172a;
  --on-surface-variant: #334155;
  --slate: #475569;
  --steel: #64748b;
  --stone: #94a3b8;
  --muted: #cbd5e1;

  /* Borders */
  --outline: #94a3b8;
  --outline-variant: #e2e8f0;
  --hairline: #e2e8f0;
  --hairline-soft: #f1f5f9;
  --hairline-strong: #cbd5e1;

  /* Semantic */
  --semantic-success: #3c692b;
  --semantic-warning: #dd5b00;
  --semantic-error: #ba1a1a;
  --error-container: #ffdad6;

  /* Secondary - Deep Navy */
  --secondary: #485f84;
  --secondary-container: #bbd3fd;

  /* Legacy compat aliases */
  --notion-primary: var(--primary);
  --notion-primary-pressed: var(--primary-pressed);
  --ink-deep: #191c1d;

  /* Card Tints */
  --tint-peach: #ffe8d4;
  --tint-rose: #ffdad8;
  --tint-mint: #bdf1a3;
  --tint-lavender: #d5e3ff;
  --tint-sky: #bbece8;
  --tint-cream: #f3f4f5;
  --tint-gray: #e7e8e9;

  /* Radius */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 10rpx;
  --radius-xl: 12rpx;
  --radius-full: 9999rpx;

  background: var(--bg-canvas);
  color: var(--ink);
  font-family: "PingFang SC", "HarmonyOS Sans SC", "MiSans", "Noto Sans CJK SC", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  line-height: 1.55;
}

view, text, button, input, textarea, picker, scroll-view {
  box-sizing: border-box;
}

/* Typography */
.text-hero { font-size: 64rpx; font-weight: 700; line-height: 1.2; letter-spacing: -1rpx; }
.text-h1 { font-size: 48rpx; font-weight: 600; line-height: 1.2; }
.text-h2 { font-size: 36rpx; font-weight: 600; line-height: 1.3; }
.text-h3 { font-size: 32rpx; font-weight: 500; line-height: 1.3; }
.text-body { font-size: 30rpx; line-height: 1.55; color: var(--ink); }
.text-sm { font-size: 26rpx; line-height: 1.5; color: var(--on-surface-variant); }
.text-caption { font-size: 24rpx; line-height: 1.4; color: var(--steel); }
.text-label { font-size: 22rpx; line-height: 1.4; color: var(--stone); letter-spacing: 0.5rpx; }

/* Buttons */
.btn-primary {
  background: var(--primary-container);
  color: var(--on-primary);
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 40rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-primary:active {
  background: var(--primary);
  transform: scale(0.98);
}

.btn-secondary {
  background: transparent;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 36rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--outline-variant);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-ghost {
  background: transparent;
  color: var(--primary);
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
}

/* Cards */
.card-base {
  background: var(--surface-lowest);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--hairline);
  padding: 32rpx;
}

.levitating-paper {
  background: var(--surface-lowest);
  box-shadow: 0 4rpx 20rpx rgba(0, 27, 60, 0.05);
  border-radius: var(--radius-xl);
}

/* Page Shell */
.page-shell {
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(20rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes skeletonPulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

.skeleton-pulse { animation: skeletonPulse 1.5s ease-in-out infinite; }
.skeleton-bg { background: var(--hairline-soft); border-radius: var(--radius-sm); }

/* Academic Scientific UI Extensions */
.font-mono {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
}
.academic-badge {
  display: inline-flex;
  align-items: center;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  letter-spacing: 0.5rpx;
  border: 1rpx solid transparent;
}
.academic-badge--primary {
  background: #eff6ff;
  color: #1e40af;
  border-color: #bfdbfe;
}
.academic-badge--neutral {
  background: #f1f5f9;
  color: #475569;
  border-color: #e2e8f0;
}
.academic-badge--success {
  background: #f0fdf4;
  color: #15803d;
  border-color: #bbf7d0;
}

/* Apple Human Interface Guidelines (HIG) System Variables & Materials */
:root, page {
  /* Apple System Colors */
  --apple-blue: #0071e3;
  --apple-blue-pressed: #0077ed;
  --apple-bg: #f5f5f7; /* iOS / macOS system grouped background */
  --apple-surface: #ffffff;
  --apple-label: #1d1d1f;
  --apple-secondary-label: #86868b;
  --apple-tertiary-label: #6e6e73;
  --apple-separator: rgba(0, 0, 0, 0.08);

  /* Override primary tokens with Apple HIG Blue & Clean Light Palette */
  --primary: #0071e3;
  --primary-pressed: #0077ed;
  --primary-container: #0071e3;
  --on-primary: #ffffff;
  --on-primary-container: #f0f7ff;

  --bg-canvas: #f5f5f7;
  --bg-surface: #ffffff;
  --bg-surface-soft: #fbfbfd;
  --surface-lowest: #ffffff;

  --ink: #1d1d1f;
  --charcoal: #1d1d1f;
  --on-surface-variant: #515154;
  --slate: #6e6e73;
  --steel: #86868b;
  --stone: #a1a1a6;
  --hairline: rgba(0, 0, 0, 0.08);

  /* Apple squircle radius standards */
  --radius-xs: 6rpx;
  --radius-sm: 10rpx;
  --radius-md: 16rpx;
  --radius-lg: 20rpx;
  --radius-xl: 28rpx;

  /* Apple System Typography */
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "SF Pro Display", "Helvetica Neue", Helvetica, Arial, sans-serif;
  letter-spacing: -0.2rpx;
}

/* Apple HIG Translucent Navigation & Vibrancy Materials */
.apple-glass {
  background: rgba(255, 255, 255, 0.82) !important;
  backdrop-filter: saturate(180%) blur(20px) !important;
  -webkit-backdrop-filter: saturate(180%) blur(20px) !important;
  border-bottom: 0.5px solid rgba(0, 0, 0, 0.12) !important;
}

/* Apple HIG Card Elevation */
.card-apple {
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04), 0 1rpx 2rpx rgba(0, 0, 0, 0.02);
  border: 0.5px solid rgba(0, 0, 0, 0.06);
}

.apple-pill-btn {
  border-radius: 999rpx;
  font-weight: 500;
  background: #0071e3;
  color: #ffffff;
}
