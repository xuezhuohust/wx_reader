/** Academic Immersive Reading Design System **/

/* Hide scrollbars - 微信小程序不应显示滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  color: transparent;
}

page {
  overflow-x: hidden;
  /* Primary - Sage Green */
  --primary: #3c692b;
  --primary-pressed: #255015;
  --primary-container: #7fb069;
  --on-primary: #ffffff;
  --on-primary-container: #174207;

  /* Surface & Backgrounds */
  --bg-canvas: #faf8f5;
  --bg-surface: #f3efe8;
  --bg-surface-soft: #f8f6f2;
  --surface-container-low: #f3f4f5;
  --surface-container: #edeeef;
  --surface-container-high: #e7e8e9;
  --surface-lowest: #ffffff;

  /* Ink & Text */
  --ink: #191c1d;
  --charcoal: #191c1d;
  --on-surface-variant: #42493d;
  --slate: #42493d;
  --steel: #72796c;
  --stone: #9a9e95;
  --muted: #c2c9ba;

  /* Borders */
  --outline: #72796c;
  --outline-variant: #c2c9ba;
  --hairline: #e1e3e4;
  --hairline-soft: #edeeef;
  --hairline-strong: #c2c9ba;

  /* Semantic */
  --semantic-success: #3c692b;
  --semantic-warning: #dd5b00;
  --semantic-error: #ba1a1a;
  --error-container: #ffdad6;

  /* Secondary - Deep Navy */
  --secondary: #485f84;
  --secondary-container: #bbd3fd;

  /* Legacy compat aliases */
  --notion-primary: var(--primary);
  --notion-primary-pressed: var(--primary-pressed);
  --ink-deep: #191c1d;

  /* Card Tints */
  --tint-peach: #ffe8d4;
  --tint-rose: #ffdad8;
  --tint-mint: #bdf1a3;
  --tint-lavender: #d5e3ff;
  --tint-sky: #bbece8;
  --tint-cream: #f3f4f5;
  --tint-gray: #e7e8e9;

  /* Radius */
  --radius-xs: 4rpx;
  --radius-sm: 8rpx;
  --radius-md: 12rpx;
  --radius-lg: 16rpx;
  --radius-xl: 24rpx;
  --radius-full: 9999rpx;

  background: var(--bg-canvas);
  color: var(--ink);
  font-family: "Noto Serif SC", "Source Han Serif SC", "STSong", "Songti SC", serif;
  -webkit-font-smoothing: antialiased;
  line-height: 1.55;
}

view, text, button, input, textarea, picker, scroll-view {
  box-sizing: border-box;
}

/* Typography */
.text-hero { font-size: 64rpx; font-weight: 700; line-height: 1.2; letter-spacing: -1rpx; }
.text-h1 { font-size: 48rpx; font-weight: 600; line-height: 1.2; }
.text-h2 { font-size: 36rpx; font-weight: 600; line-height: 1.3; }
.text-h3 { font-size: 32rpx; font-weight: 500; line-height: 1.3; }
.text-body { font-size: 30rpx; line-height: 1.55; color: var(--ink); }
.text-sm { font-size: 26rpx; line-height: 1.5; color: var(--on-surface-variant); }
.text-caption { font-size: 24rpx; line-height: 1.4; color: var(--steel); }
.text-label { font-size: 22rpx; line-height: 1.4; color: var(--stone); letter-spacing: 0.5rpx; }

/* Buttons */
.btn-primary {
  background: var(--primary-container);
  color: var(--on-primary);
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 40rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-primary:active {
  background: var(--primary);
  transform: scale(0.98);
}

.btn-secondary {
  background: transparent;
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 500;
  padding: 20rpx 36rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--outline-variant);
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-ghost {
  background: transparent;
  color: var(--primary);
  font-size: 26rpx;
  padding: 16rpx 24rpx;
  border-radius: var(--radius-sm);
}

/* Cards */
.card-base {
  background: var(--surface-lowest);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--hairline);
  padding: 32rpx;
}

.levitating-paper {
  background: var(--surface-lowest);
  box-shadow: 0 4rpx 20rpx rgba(0, 27, 60, 0.05);
  border-radius: var(--radius-xl);
}

/* Page Shell */
.page-shell {
  min-height: 100vh;
  height: 100vh;
  overflow: hidden;
}

/* Animations */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(20rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

@keyframes skeletonPulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 0.8; }
}

.skeleton-pulse { animation: skeletonPulse 1.5s ease-in-out infinite; }
.skeleton-bg { background: var(--hairline-soft); border-radius: var(--radius-sm); }
