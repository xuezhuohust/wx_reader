<view class="book-card {{mode}}-mode">
  <!-- Cover Section -->
  <view class="book-cover" bindtap="handleTap">
    <image wx:if="{{book.coverUrl}}" class="cover-image" src="{{book.coverUrl}}" mode="aspectFill" />
    <view wx:else class="cover-empty">
      <text>{{coverInitial}}</text>
    </view>
    <view class="cover-overlay"></view>
    <!-- Floating Tag -->
    <view class="floating-category" wx:if="{{book.category}}">{{book.category}}</view>
  </view>

  <!-- Content Section -->
  <view class="book-main">
    <view class="book-info">
      <view class="book-header">
        <text class="book-title">{{book.title}}</text>
      </view>
      
      <text wx:if="{{mode === 'market'}}" class="book-desc">{{book.description}}</text>

      <view wx:if="{{mode === 'owned'}}" class="owned-meta">
        <text class="meta-item">{{readTimeText}}</text>
        <text class="meta-item">对话 {{book.chatCount || 0}}</text>
      </view>
    </view>

    <view class="book-footer">
      <view class="price-section" wx:if="{{mode === 'market'}}">
        <text class="price-label">价格</text>
        <text class="price-value" wx:if="{{!book.purchased}}">{{priceText}}</text>
        <text class="status-owned" wx:else>已拥有</text>
      </view>
      
      <view class="action-trigger" bindtap="handleTap">
        <text class="action-label">{{actionText}}</text>
        <view class="action-arrow"></view>
      </view>
    </view>
  </view>
</view>
