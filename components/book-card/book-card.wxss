.book-card {
  display: flex;
  gap: 32rpx;
  padding: 28rpx;
  background: #ffffff;
  border-radius: var(--radius-lg);
  margin-bottom: 24rpx;
  border: 1rpx solid var(--hairline-soft);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Cover Section */
.book-cover {
  width: 160rpx;
  height: 224rpx;
  border-radius: var(--radius-sm);
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  background: var(--bg-surface);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  transition: transform 0.2s;
}

.book-cover:active {
  transform: scale(0.96);
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  box-shadow: inset 0 0 40rpx rgba(0,0,0,0.02);
  pointer-events: none;
}

.floating-category {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
  background: var(--notion-primary);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-xs);
  backdrop-filter: blur(4px);
  text-transform: uppercase;
  opacity: 0.9;
}

/* Content Section */
.book-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.book-info {
  display: flex;
  flex-direction: column;
}

.book-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.book-desc {
  font-size: 24rpx;
  color: var(--steel);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  opacity: 0.8;
}

.owned-meta {
  display: flex;
  gap: 12rpx;
}

.meta-item {
  font-size: 20rpx;
  color: var(--steel);
  background: var(--bg-surface);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-xs);
  font-weight: 500;
}

/* Footer Section - New Minimalist Design */
.book-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
}

.price-section {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.price-label {
  font-size: 18rpx;
  color: var(--stone);
  text-transform: uppercase;
  font-weight: 600;
}

.price-value {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--ink);
}

.status-owned {
  font-size: 24rpx;
  color: var(--semantic-success);
  font-weight: 700;
}

/* Action Trigger - Minimalist Pill */
.action-trigger {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--notion-primary);
  padding: 10rpx 28rpx;
  border-radius: var(--radius-full);
  transition: all 0.2s;
  box-shadow: 0 4rpx 12rpx rgba(19, 30, 56, 0.15);
}

.action-trigger:active {
  transform: scale(0.92);
  opacity: 0.9;
}

.action-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #ffffff;
}

.action-arrow {
  width: 10rpx;
  height: 10rpx;
  border-top: 3rpx solid #ffffff;
  border-right: 3rpx solid #ffffff;
  transform: rotate(45deg);
  transition: all 0.2s;
}
