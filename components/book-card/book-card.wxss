.book-card {
  display: flex;
  gap: 36rpx;
  padding: 32rpx;
  background: var(--bg-pure);
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-document);
  margin-bottom: 40rpx;
  position: relative;
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 
    0 4rpx 12rpx rgba(0, 0, 0, 0.02),
    0 1rpx 2rpx rgba(0, 0, 0, 0.01);
}

/* Paper-stack effect */
.book-card::before {
  content: '';
  position: absolute;
  top: 4rpx; left: 4rpx; right: -4rpx; bottom: -4rpx;
  background: var(--bg-pure);
  border: 1rpx solid var(--border-subtle);
  border-radius: var(--radius-document);
  z-index: -1;
}

.book-card:active {
  transform: translateY(2rpx) scale(0.99);
}

/* Cover Styling */
.book-cover {
  width: 200rpx;
  height: 280rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  box-shadow: 4rpx 12rpx 32rpx rgba(0, 0, 0, 0.12);
  position: relative;
  overflow: hidden;
}

.cover-inner {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 24rpx;
  position: relative;
}

.spine-shadow {
  position: absolute;
  top: 0; left: 0; bottom: 0; width: 16rpx;
  background: linear-gradient(to right, rgba(0, 0, 0, 0.15), transparent);
  z-index: 2;
}

.cover-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
  line-height: 1.25;
  z-index: 1;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.cover-author {
  font-size: 20rpx;
  color: #fff;
  opacity: 0.8;
  margin-top: 8rpx;
  z-index: 1;
}

/* Nuanced OKLCH-based Cover Themes */
.cover-sunset { background: oklch(55% 0.15 45); }
.cover-atlas { background: oklch(35% 0.05 250); }
.cover-graphite { background: oklch(45% 0.02 250); }
.cover-mint { background: oklch(50% 0.12 160); }
.cover-rose { background: oklch(50% 0.15 15); }
.cover-cobalt { background: oklch(45% 0.18 260); }
.cover-sand { background: oklch(45% 0.1 70); }
.cover-forest { background: oklch(35% 0.1 140); }

/* Main Content Area */
.book-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.book-info {
  flex: 1;
}

.book-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.book-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-ink);
  line-height: 1.3;
  flex: 1;
}

.book-category {
  font-size: 18rpx;
  color: var(--accent-literary);
  border: 1rpx solid var(--accent-literary);
  padding: 2rpx 12rpx;
  border-radius: 4rpx;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  opacity: 0.8;
  flex-shrink: 0;
  margin-top: 8rpx;
}

.book-author {
  font-size: 26rpx;
  color: var(--text-muted);
  display: block;
}

.book-desc {
  font-size: 24rpx;
  color: var(--text-body);
  margin-top: 16rpx;
  line-height: 1.6;
  opacity: 0.8;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.owned-meta {
  margin-top: 24rpx;
  display: flex;
  gap: 24rpx;
}

.meta-item {
  font-size: 22rpx;
  color: var(--text-muted);
  background: var(--bg-paper);
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* Footer & Actions */
.book-footer {
  margin-top: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--accent-literary);
}

.status-owned {
  font-size: 24rpx;
  color: var(--text-muted);
  font-style: italic;
}

.action-btn {
  margin: 0 !important;
  height: 64rpx;
  min-height: 64rpx !important;
  line-height: 64rpx;
  padding: 0 40rpx !important;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 32rpx;
  width: auto !important;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
}

.btn-ghost {
  background: transparent;
  color: var(--primary);
  border: 1rpx solid var(--border-ink);
}





