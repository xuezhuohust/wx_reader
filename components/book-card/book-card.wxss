.book-card {
  display: flex;
  gap: 32rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  position: relative;
  transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.02);
}

.book-card:active {
  transform: scale(0.98);
  background: #fafafa;
}

/* Cover Styling */
.book-cover {
  width: 160rpx;
  height: 220rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  box-shadow: 4rpx 8rpx 20rpx rgba(0, 0, 0, 0.1);
  position: relative;
  overflow: hidden;
  background: #fff;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 16rpx 12rpx;
}

.cover-content-card {
  position: relative;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.cover-title-card {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.2;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.2);
}

.cover-author-card {
  font-size: 14rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.cover-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.spine-shadow {
  position: absolute;
  top: 0; left: 0; bottom: 0; width: 14rpx;
  background: linear-gradient(to right, rgba(0, 0, 0, 0.15), transparent);
  z-index: 2;
}

/* Nuanced Cover Themes - More Literary */
.cover-sunset { background: linear-gradient(135deg, #e67e22, #d35400); }
.cover-atlas { background: linear-gradient(135deg, #34495e, #2c3e50); }
.cover-graphite { background: linear-gradient(135deg, #7f8c8d, #2c3e50); }
.cover-mint { background: linear-gradient(135deg, #27ae60, #16a085); }
.cover-rose { background: linear-gradient(135deg, #e74c3c, #c0392b); }
.cover-cobalt { background: linear-gradient(135deg, #2980b9, #2c3e50); }
.cover-sand { background: linear-gradient(135deg, #f1c40f, #f39c12); }
.cover-forest { background: linear-gradient(135deg, #2ecc71, #27ae60); }

/* Main Content Area */
.book-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.book-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.book-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.book-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-ink);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-family: "Charter", serif;
}

.book-category {
  font-size: 18rpx;
  color: var(--accent-literary);
  background: rgba(194, 65, 12, 0.08);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.book-author {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 400;
}

.book-desc {
  font-size: 22rpx;
  color: var(--text-body);
  opacity: 0.6;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 8rpx;
}

.book-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 16rpx;
}

.price-box {
  display: flex;
  flex-direction: column;
}

.price-label {
  font-size: 18rpx;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.price-value {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--accent-literary);
}

.price-free {
  font-size: 28rpx;
  font-weight: 700;
  color: #10b981;
}

.action-btn {
  height: 64rpx;
  padding: 0 32rpx;
  background: var(--primary);
  color: #fff;
  border-radius: 32rpx;
  font-size: 24rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.action-btn:active {
  opacity: 0.9;
  transform: scale(0.95);
}
