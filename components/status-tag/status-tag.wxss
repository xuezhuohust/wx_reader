.status-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 20rpx;
  border-radius: 22rpx;
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.02em;
}

.primary {
  color: var(--accent-literary);
  background: rgba(194, 65, 12, 0.08);
  border: 1rpx solid rgba(194, 65, 12, 0.15);
}

.success {
  color: #065f46;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
}

.warning {
  color: #92400e;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
}

.danger {
  color: #991b1b;
  background: #fef2f2;
  border: 1rpx solid #fecaca;
}

.neutral {
  color: #374151;
  background: #f3f4f6;
  border: 1rpx solid #e5e7eb;
}
