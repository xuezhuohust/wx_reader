.chat-page--large .drama-question-card,
.chat-page--large .drama-video-card,
.chat-page--large .drama-plan-card,
.chat-page--large .drama-clip-selector {
  min-width: 280px;
}

/* Pad / 横屏阅读器的 rpx 会随宽度等比例放大；剧创卡片改用 px，避免标题和错误信息失控。 */
.chat-page--large .drama-card-title {
  font-size: 17px;
}

.chat-page--large .drama-card-copy {
  margin-top: 6px;
  font-size: 14px;
  line-height: 1.42;
}

.chat-page--large .drama-clip-list {
  gap: 8px;
  margin-top: 12px;
}

.chat-page--large .drama-clip-chip {
  gap: 8px;
  padding: 10px;
  border-radius: 10px;
}

.chat-page--large .drama-clip-check {
  width: 22px;
  height: 22px;
  flex-basis: 22px;
  border-width: 1px;
  border-radius: 6px;
  font-size: 16px;
  line-height: 22px;
}

.chat-page--large .drama-clip-copy {
  gap: 3px;
}

.chat-page--large .drama-clip-title {
  font-size: 15px;
  line-height: 1.38;
}

.chat-page--large .drama-clip-meta,
.chat-page--large .drama-clip-intent {
  font-size: 12px;
  line-height: 1.42;
}

.chat-page--large .drama-generate-clips-button {
  margin-top: 4px;
  border-radius: 10px;
  font-size: 14px;
}

.chat-page--large .drama-position-list {
  gap: 6px;
  margin-top: 10px;
}

.chat-page--large .drama-position-chip {
  gap: 3px;
  padding: 9px 11px;
  border-radius: 9px;
}

.chat-page--large .drama-position-chapter,
.chat-page--large .drama-position-summary,
.chat-page--large .drama-status-tag {
  font-size: 12px;
}

.chat-page--large .drama-position-title {
  font-size: 15px;
}

.chat-page--large .drama-card-play {
  margin-top: 10px;
  padding: 8px 12px;
  font-size: 14px;
}

/* Recording Overlay */
.recording-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
  pointer-events: none;
}

.recording-card {
  width: 320rpx;
  height: 320rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(20px);
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
  transition: all 0.2s;
}

.recording-card--cancel {
  background: rgba(186, 26, 26, 0.86);
}

.recording-wave {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  margin-bottom: 32rpx;
}

.wave-item {
  width: 6rpx;
  height: 20rpx;
  background: #ffffff;
  border-radius: 4rpx;
  animation: wave-grow 1s ease-in-out infinite;
}

.wave-item:nth-child(2) { animation-delay: 0.2s; height: 40rpx; }
.wave-item:nth-child(3) { animation-delay: 0.4s; height: 30rpx; }
.wave-item:nth-child(4) { animation-delay: 0.6s; }

@keyframes wave-grow {
  0%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(2); }
}

.recording-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.recording-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.cancel-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-undo-white {
  width: 56rpx;
  height: 56rpx;
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M3 7v6h6"></path><path d="M21 17a9 9 0 0 0-9-15 9 9 0 0 0-6 3"></path></svg>');
  background-size: contain;
  background-repeat: no-repeat;
}

.cancel-text {
  color: #ffffff;
}

.chat-input {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--ink);
  min-height: 44rpx;
  max-height: 200rpx;
}

.bottom-space {
  width: 100%;
}

/* Scroll-down button */
.scroll-down-btn {
  position: fixed;
  bottom: 280rpx;
  right: 40rpx;
  z-index: 99;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  background: var(--notion-primary);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 113, 227, 0.25);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.scroll-down-icon {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 12rpx solid #fff;
}

.scroll-down-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.profile-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.profile-sheet {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx;
}

.profile-header {
  margin-bottom: 20rpx;
}

.profile-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.permission-content {
  margin-bottom: 28rpx;
}

.permission-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--slate);
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
}

.privacy-actions .privacy-btn {
  flex: 1;
}

/* ====================================================================
   2026-05-19 新增：对话切换面板
   ==================================================================== */

/* 遮罩层 */
.conv-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 998;
  background: rgba(0, 0, 0, 0.3);
}

/* 面板容器 */
.conv-panel {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 999;
  background: var(--bg-canvas);
  border-bottom: 1rpx solid var(--hairline);
  transform: translateY(-100%);
  transition: transform 0.25s ease;
  max-height: 60vh;
  display: flex;
  flex-direction: column;
}

.conv-panel--open {
  transform: translateY(0);
}

/* 面板头部 */
.conv-panel-header {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 24rpx 32rpx;
  flex-shrink: 0;
}

.conv-panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.conv-panel-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
  border-bottom: 1rpx solid var(--hairline);
  flex-shrink: 0;
}

.conv-panel-new {
  display: flex;
  align-items: center;
  gap: 6rpx;
  width: 100%;
  min-width: 0;
  height: 72rpx;
  justify-content: center;
  background: var(--primary);
  border-radius: 16rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.conv-panel-new:active {
  transform: scale(0.96);
}

.conv-panel-new-icon {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

/* 面板列表 */
.conv-panel-list {
  flex: 1;
  overflow-y: auto;
  padding: 12rpx 0;
}

/* 单个对话项 */
.conv-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  transition: background 0.15s ease;
}

.conv-item:active {
  background: var(--bg-card);
}

.conv-item--active {
  background: var(--bg-card);
}

.conv-item-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.conv-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.conv-item-title {
  font-size: 28rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conv-item-time {
  font-size: 22rpx;
  color: var(--slate);
}

/* 激活态圆点标记 */
.conv-item--active .conv-item-title::after {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-left: 12rpx;
  vertical-align: middle;
}
