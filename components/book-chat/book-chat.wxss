  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.62);
}

.drama-clip-chip--selected {
  border-color: #536ac4;
  background: rgba(83, 106, 196, 0.1);
}

.drama-clip-check {
  width: 30rpx;
  height: 30rpx;
  flex: 0 0 30rpx;
  border: 2rpx solid #7180b5;
  border-radius: 8rpx;
  color: #fff;
  background: transparent;
  font-size: 22rpx;
  line-height: 30rpx;
  text-align: center;
}

.drama-clip-chip--selected .drama-clip-check {
  border-color: #536ac4;
  background: #536ac4;
}

.drama-clip-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
}

.drama-clip-title {
  color: #27376f;
  font-size: 24rpx;
  font-weight: 700;
}

.drama-clip-meta,
.drama-clip-intent {
  color: #68739c;
  font-size: 21rpx;
  line-height: 1.45;
}

.drama-generate-clips-button {
  margin: 6rpx 0 0;
  border: 0;
  border-radius: 14rpx;
  color: #fff;
  background: #536ac4;
  font-size: 24rpx;
  font-weight: 700;
}

.drama-position-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  margin-top: 16rpx;
}

.drama-position-chip {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 14rpx 16rpx;
  border: 1rpx solid rgba(63, 83, 147, 0.18);
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.62);
}

.drama-position-chip:active,
.drama-card-play:active,
.drama-playlist-action:active {
  transform: scale(0.98);
  opacity: 0.82;
}

.drama-position-chapter {
  color: #6370a1;
  font-size: 21rpx;
}

.drama-position-title {
  color: var(--ink);
  font-size: 25rpx;
  font-weight: 700;
}

.drama-position-summary {
  display: -webkit-box;
  overflow: hidden;
  color: var(--stone);
  font-size: 21rpx;
  line-height: 1.42;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.drama-clip-chip {
  border-color: rgba(72, 95, 156, 0.32);
  background: rgba(72, 95, 156, 0.06);
}

.drama-video-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.drama-status-tag {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  color: #3f5393;
  background: rgba(63, 83, 147, 0.1);
  font-size: 20rpx;
  font-weight: 700;
}

.drama-video-card--failed .drama-status-tag {
  color: #a13b3b;
  background: rgba(161, 59, 59, 0.1);
}

.drama-card-play {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 12rpx 18rpx;
  border-radius: 12rpx;
  color: #ffffff;
  background: #485f9c;
  font-size: 24rpx;
  font-weight: 700;
}

.drama-footer-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 32rpx 12rpx;
  padding: 10rpx 14rpx;
  border-radius: 12rpx;
  background: rgba(63, 83, 147, 0.07);
}

.drama-footer-copy {
  color: #53669e;
  font-size: 21rpx;
}

.drama-footer-playlist {
  flex-shrink: 0;
  color: #3f5393;
  font-size: 22rpx;
  font-weight: 800;
}

.drama-playlist-mask {
  position: fixed;
  z-index: 1400;
  inset: 0;
  background: rgba(15, 23, 42, 0.38);
}

.drama-playlist-panel {
  position: fixed;
  z-index: 1401;
  top: 18%;
  right: 24rpx;
  left: 24rpx;
  max-height: 64%;
  overflow: hidden;
  border-radius: 22rpx;
  background: #faf8f5;
  box-shadow: 0 20rpx 60rpx rgba(15, 23, 42, 0.25);
}

.drama-playlist-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.drama-playlist-title {
  color: var(--ink);
  font-size: 30rpx;
  font-weight: 800;
}

.drama-playlist-close {
  width: 48rpx;
  height: 48rpx;
  color: var(--stone);
  font-size: 42rpx;
  line-height: 42rpx;
  text-align: center;
}

.drama-playlist-scroll {
  max-height: 640rpx;
}

.drama-playlist-empty {
  padding: 48rpx 28rpx;
  color: var(--stone);
  font-size: 26rpx;
  text-align: center;
}

.drama-playlist-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.drama-playlist-item-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.drama-playlist-item-title {
  overflow: hidden;
  color: var(--ink);
  font-size: 26rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drama-playlist-item-status {
  overflow: hidden;
  color: var(--stone);
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.drama-playlist-action {
  flex-shrink: 0;
  padding: 10rpx 14rpx;
  border-radius: 10rpx;
  color: #ffffff;
  background: #485f9c;
  font-size: 22rpx;
  font-weight: 700;
}

.drama-playlist-reuse {
  color: #3f5393;
  background: rgba(63, 83, 147, 0.1);
}

.drama-video-player-shell {
  position: fixed;
  z-index: 1600;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #000000;
}

.drama-video-player {
  width: 100%;
