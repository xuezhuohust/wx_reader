/* 底部模式选择 */
.chat-footer-tools {
  padding: 0 32rpx 8rpx;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  background: transparent;
  position: relative;
  overflow: visible;
}

.mode-picker {
  position: relative;
  z-index: 3;
  overflow: visible;
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  width: auto;
}

.mode-menu {
  position: absolute;
  left: -16rpx;
  bottom: 82rpx;
  z-index: 5;
  width: 400rpx;
  max-width: calc(100vw - 96rpx);
  display: flex;
  flex-direction: column;
  background: var(--bg-canvas);
  border-radius: 20rpx;
  box-shadow: 0 16rpx 42rpx rgba(15, 23, 42, 0.12);
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  overflow: hidden;
}

.mode-menu-item {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 18rpx 24rpx;
  background: var(--bg-canvas);
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.06);
  transition: all 0.2s ease;
}

.mode-menu-item:last-child {
  border-bottom: none;
}

.mode-menu-item:active {
  background: rgba(15, 23, 42, 0.03);
}

.mode-menu-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  background-color: #0b0b0b;
}

.mode-menu-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.mode-menu-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.mode-menu-title {
  font-size: 32rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #0b0b0b;
}

.mode-menu-badge {
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  background: rgba(29, 126, 255, 0.1);
  color: #1d7eff;
  font-size: 21rpx;
  line-height: 1.2;
  font-weight: 800;
}

.mode-menu-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
  line-height: 1.35;
  color: #929292;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mode-menu-check {
  position: absolute;
  right: 28rpx;
  top: 50%;
  width: 25rpx;
  height: 40rpx;
  border-right: 7rpx solid #0b0b0b;
  border-bottom: 7rpx solid #0b0b0b;
  transform: translateY(-58%) rotate(45deg);
}

.mode-trigger {
  height: 68rpx;
  padding: 0 18rpx;
  display: flex;
  align-items: center;
  background: rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 113, 227, 0.06);
  border-radius: 14rpx;
  color: #0071e3;
  transition: all 0.2s ease;
}

.mode-trigger:active {
  background: rgba(0, 113, 227, 0.09);
}

.mode-trigger-icon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
  background-color: currentColor;
}

.mode-trigger text {
  font-size: 27rpx;
  line-height: 1;
  color: currentColor;
  font-weight: 700;
  white-space: nowrap;
}

.mode-trigger-arrow {
  width: 8rpx;
  height: 8rpx;
  margin-left: 8rpx;
  border-right: 3rpx solid currentColor;
  border-bottom: 3rpx solid currentColor;
  opacity: 0.45;
  transform: rotate(45deg) translateY(-2rpx);
  transition: transform 0.2s ease;
}

.mode-trigger--open {
  background: rgba(0, 113, 227, 0.1);
  border-color: rgba(0, 113, 227, 0.12);
}

.mode-trigger--open .mode-trigger-arrow {
  transform: rotate(225deg) translate(-2rpx, -2rpx);
}

.mode-trigger--story {
  color: #485f84;
  background: rgba(72, 95, 132, 0.08);
}

.mode-trigger--creative {
  color: #8a5a1f;
  background: rgba(138, 90, 31, 0.08);
}

.mode-trigger--drama {
  color: #3f5393;
  background: rgba(63, 83, 147, 0.1);
}

.creative-type-selector {
  display: flex;
  gap: 8rpx;
  overflow-x: auto;
  width: 100%;
}

.creative-type-chip {
  padding: 6rpx 16rpx;
  background: rgba(0, 0, 0, 0.03);
  border-radius: 8rpx;
  font-size: 20rpx;
  color: var(--stone);
  font-weight: 600;
  transition: all 0.2s ease;
  white-space: nowrap;
}

.creative-type-chip--active {
  background: rgba(0, 113, 227, 0.08);
  color: var(--primary);
}
.thinking-container {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 4rpx 0;
}

.thinking-dot {
  width: 12rpx;
  height: 12rpx;
  background: #0071e3;
  border-radius: 50%;
  animation: dotPulse 1.4s infinite ease-in-out both;
}

.thinking-dot:nth-child(1) { animation-delay: -0.32s; }
.thinking-dot:nth-child(2) { animation-delay: -0.16s; }

@keyframes dotPulse {
  0%, 80%, 100% { transform: scale(0); opacity: 0.3; }
  40% { transform: scale(1); opacity: 1; }
}

.thinking-text {
  font-size: 24rpx;
  color: #0071e3;
  font-weight: 500;
  margin-left: 8rpx;
}

.bubble-user {
  background: #f0f7ff; color: #0071e3; border: 1rpx solid #cce4ff;
  padding: 12rpx 22rpx;
  border-radius: 20rpx;
  border-top-right-radius: 4rpx;
  font-weight: 500;
}

.bubble-user .message-text {
  color: var(--primary);
  font-weight: 500;
}

.message-text-wrapper {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.message-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--charcoal);
  word-break: break-word;
}

.structured-reply {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.reply-heading {
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 800;
  color: var(--ink);
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--outline-variant);
}

.reply-section-label {
  width: fit-content;
  padding: 8rpx 18rpx;
  border-radius: var(--radius-full);
  background: rgba(0, 113, 227, 0.1);
  color: var(--primary);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.2;
}

.reply-paragraph {
  display: block;
  font-size: 29rpx;
  line-height: 1.72;
  color: var(--charcoal);
  word-break: break-word;
}

.reply-strong {
  font-weight: 800;
  color: var(--primary);
}

.reply-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.reply-list-item {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 18rpx 18rpx 16rpx;
  border-radius: var(--radius-md);
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid var(--outline-variant);
}

.reply-list-index {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-sm);
  background: var(--primary-container);
  color: var(--on-primary-container);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 1;
}

.reply-list-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.reply-list-title {
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--ink);
  font-weight: 800;
}

.reply-list-text {
  font-size: 27rpx;
  line-height: 1.62;
  color: var(--charcoal);
  word-break: break-word;
}

/* Typing Animation */
.typing-cursor {
  display: inline-block;
  width: 4rpx;
  height: 30rpx;
  background: #0071e3;
  margin-left: 4rpx;
  vertical-align: middle;
  animation: blink 1s infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* Message Actions */
.message-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 8rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #8c8c8c;
  font-weight: 600;
}

.action-btn:active {
  color: #0071e3;
}

/* Voice Control Optimized */
.voice-control, .copy-control {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
  background: transparent;
  color: var(--stone);
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  transition: all 0.2s ease;
  margin-right: 24rpx;
}

.voice-control:active, .copy-control:active {
  color: var(--primary);
  transform: scale(0.95);
}

.voice-status-text {
  font-size: 22rpx;
  font-weight: 700;
  color: inherit;
}

.is-playing .voice-status-text {
  color: var(--primary);
}

.voice-control.is-playing {
  color: var(--primary);
}

.copy-icon {
  width: 22rpx;
  height: 22rpx;
  background: currentColor;
