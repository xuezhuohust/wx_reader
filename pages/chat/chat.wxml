<view class="chat-host" style="{{windowHeight ? 'height: ' + windowHeight + 'px;' : ''}}">
  <book-chat
    wx:if="{{chatProps.bookId}}"
    class="chat-component"
    book-id="{{chatProps.bookId}}"
    entry="{{chatProps.entry}}"
    scene="{{chatProps.scene}}"
    source-chapter-id="{{chatProps.chapterId}}"
    source-chapter-title="{{chatProps.chapterTitle}}"
    initial-text="{{chatProps.initialText}}"
    large-screen="{{isLargeScreen}}"
    viewport-height="{{windowHeight}}"
    navigation-layout="{{navigationLayout}}"
  />
</view>
