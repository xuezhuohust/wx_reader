<view wx:if="{{book}}" class="page-shell chat-page">
  <!-- Top App Bar -->
  <view class="custom-nav" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="nav-back" bindtap="handleBack" style="width: {{menuHeight}}px; height: {{menuHeight}}px;">
        <view class="back-arrow"></view>
      </view>
      <text class="nav-title">智能伴读</text>
    </view>
  </view>

  <!-- 对话切换面板 -->
  <view wx:if="{{showConversationList}}" class="conv-mask" bindtap="handleToggleConversationList"></view>
  <view class="conv-panel {{showConversationList ? 'conv-panel--open' : ''}}" style="padding-top: {{navBarHeight}}px;">
    <view class="conv-panel-header">
      <text class="conv-panel-title">对话列表</text>
    </view>
    <view class="conv-panel-actions">
      <view class="conv-panel-new" bindtap="handleNewConversation">
        <text class="conv-panel-new-icon">+</text>
        <text>新建对话</text>
      </view>
    </view>
    <scroll-view class="conv-panel-list" scroll-y>
      <view
        wx:for="{{conversations}}"
        wx:key="id"
        class="conv-item {{item.id === currentConversationId ? 'conv-item--active' : ''}}"
        data-id="{{item.id}}"
        data-title="{{item.title}}"
        bindtap="handleSwitchConversation"
      >
        <text class="conv-item-icon">💬</text>
        <view class="conv-item-info">
          <text class="conv-item-title">{{item.title}}</text>
          <text class="conv-item-time">{{item.updatedAt ? item.updatedAt.slice(0, 10) : ''}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Fixed Book Tag Bar -->
  <view class="book-tag-bar" style="top: {{navBarHeight}}px;">
    <view class="book-tag-left">
      <view class="book-tag-icon"></view>
      <text class="book-tag-text">当前伴读：《{{book.title}}》</text>
      <view class="clear-btn {{loadingReply ? 'clear-btn--disabled' : ''}}" catchtap="handleClearConversations">
        <view class="clear-icon"></view>
      </view>
    </view>
  </view>

  <!-- Chat Canvas -->
  <scroll-view
    class="chat-body"
    scroll-y
    enhanced
    scroll-with-animation="{{scrollWithAnimation}}"
    scroll-top="{{scrollTop}}"
    enable-back-to-top
    bindscroll="handleScroll"
    bindtouchstart="handleChatTouchStart"
    bindtouchend="handleChatTouchEnd"
    bindtouchcancel="handleChatTouchEnd"
    style="padding-top: {{navBarHeight + 44}}px;"
  >
    <view class="message-list">

      <!-- 伴读欢迎消息 -->
      <view class="message-row row-ai" wx:if="{{messages.length === 0}}">
        <view class="ai-avatar">
          <text>读</text>
        </view>
        <view class="message-container container-ai">
          <text class="ai-name">伴读助手</text>
          <view class="message-bubble bubble-ai">
            <view class="message-text">
              <text>你好！我是你的学术伴读助手。我已经为您研读了《{{book.title}}》。您可以就其核心论点、逻辑推演或特定概念提出问题，我将协助您进行深入探讨。</text>
            </view>
          </view>
          <!-- Suggestion Chips -->
          <view class="suggestion-chips">
            <view
              wx:for="{{quickQuestions}}"
              wx:key="*this"
              class="chip-item"
              data-question="{{item}}"
              bindtap="handleQuickQuestion"
            >{{item}}</view>
          </view>
        </view>
      </view>

      <!-- Messages -->
      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="{{item.id}}"
        class="message-row {{item.role === 'user' ? 'row-user' : 'row-ai'}}"
      >
        <view wx:if="{{item.role === 'ai'}}" class="ai-avatar">
          <text>读</text>
        </view>
        <view class="message-container {{item.role === 'user' ? 'container-user' : 'container-ai'}}">
          <text wx:if="{{item.role === 'ai'}}" class="ai-name">伴读助手</text>
          <view class="message-bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
            <view class="message-text">
              <text user-select>{{item.content}}</text>
              <view wx:if="{{item.loading || (item.role === 'ai' && loadingReply && index === messages.length - 1)}}" class="typing-cursor"></view>
            </view>
          </view>
          <view
            wx:if="{{item.role === 'ai' && !item.loading}}"
            class="voice-control {{(playingMessageId === item.id || audioLoadingMessageId === item.id) ? 'is-playing' : ''}}"
            data-id="{{item.id}}"
            data-content="{{item.content}}"
            bindtap="handleSpeakMessage"
          >
            <view class="voice-wave" wx:if="{{playingMessageId === item.id || audioLoadingMessageId === item.id}}">
              <view class="wave-bar"></view>
              <view class="wave-bar"></view>
              <view class="wave-bar"></view>
            </view>
            <view class="voice-icon-new" wx:else></view>
            <text class="voice-status-text">{{(playingMessageId === item.id || audioLoadingMessageId === item.id) ? '停止' : '朗读'}}</text>
          </view>
        </view>
      </view>

      <view class="bottom-space" style="height: {{keyboardHeight + 200}}rpx;"></view>
    </view>
  </scroll-view>

  <!-- Scroll Down Button -->
  <view
    wx:if="{{showScrollDownBtn}}"
    class="scroll-down-btn"
    bindtap="handleScrollDownTap"
  >
    <view class="scroll-down-icon"></view>
    <text class="scroll-down-text">新内容</text>
  </view>

  <!-- Input Area -->
  <view class="chat-footer" style="bottom: {{keyboardHeight}}px;">
    <view class="input-area">
      <view class="mode-toggle-btn" bindtap="handleToggleInputMode">
        <view class="icon-svg {{inputMode === 'voice' ? 'icon-keyboard' : 'icon-voice'}}"></view>
      </view>

      <view class="chat-input-wrap">
        <textarea
          wx:if="{{inputMode === 'keyboard'}}"
          class="chat-input"
          placeholder="向伴读助手提问……"
          placeholder-style="color: var(--stone);"
          value="{{inputValue}}"
          bindinput="handleInput"
          bindblur="handleInputBlur"
          bindlinechange="handleInputLineChange"
          bindkeyboardheightchange="handleKeyboardHeightChange"
          bindconfirm="handleSend"
          confirm-type="send"
          auto-height
          adjust-position="{{false}}"
          cursor-spacing="32"
          maxlength="500"
        />
        <view
          wx:else
          class="voice-bar {{isRecording ? 'voice-bar--active' : ''}} {{voiceCancel ? 'voice-bar--cancel' : ''}}"
          bindtouchstart="handleVoiceStart"
          bindtouchmove="handleVoiceMove"
          bindtouchend="handleVoiceEnd"
          bindtouchcancel="handleVoiceCancel"
        >
          <text>{{isRecording ? (voiceCancel ? '松开取消' : '松开发送') : '按住说话'}}</text>
        </view>
      </view>

      <view class="send-btn {{inputValue ? 'send-btn--active' : ''}}" bindtap="handleSend">
        <text class="send-icon-text">↑</text>
      </view>
    </view>
  </view>

  <!-- Recording Overlay -->
  <view class="recording-overlay" wx:if="{{isRecording}}">
    <view class="recording-card {{voiceCancel ? 'recording-card--cancel' : ''}}">
      <block wx:if="{{!voiceCancel}}">
        <view class="recording-wave">
          <view class="wave-item"></view>
          <view class="wave-item"></view>
          <view class="wave-item"></view>
          <view class="wave-item"></view>
        </view>
        <text class="recording-text">正在录音</text>
        <text class="recording-tip">上滑取消，松开发送</text>
      </block>
      <block wx:else>
        <view class="cancel-icon-wrap">
          <view class="icon-undo-white"></view>
        </view>
        <text class="recording-text cancel-text">松开取消</text>
        <text class="recording-tip">下滑回到发送</text>
      </block>
    </view>
  </view>

  <!-- Privacy Modal -->
  <view wx:if="{{showPrivacyModal}}" class="profile-overlay" catchtap="handleDisagreePrivacy">
    <view class="profile-sheet" catchtap="handleStopPropagation">
      <view class="profile-header">
        <text class="profile-sheet-title">隐私授权说明</text>
      </view>
      <view class="permission-content">
        <text class="permission-text">语音对话需要使用录音权限。请先同意隐私授权，再点击录音。</text>
      </view>
      <view class="privacy-actions">
        <button id="chat-privacy-disagree" class="btn-secondary" bindtap="handleDisagreePrivacy">拒绝</button>
        <button
          id="chat-privacy-agree"
          class="btn-primary"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="handleAgreePrivacy"
        >同意</button>
      </view>
    </view>
  </view>
</view>
