<view wx:if="{{book}}" class="chat-container">
  <!-- Header with book info -->
  <view class="chat-header">
    <view class="book-info">
      <text class="book-title text-serif">{{book.title}}</text>
      <text class="book-author">{{book.author}}</text>
    </view>
    <view class="chat-intro">
      <text>与书籍深度对话。AI 助手将根据书本内容为您解答，带您领略文字背后的意蕴。</text>
    </view>
  </view>

  <!-- Messages list -->
  <scroll-view
    class="chat-messages"
    scroll-y
    enhanced
    scroll-with-animation
    scroll-into-view="{{scrollIntoView}}"
    enable-back-to-top
  >
    <view class="message-list">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="{{item.id}}"
        class="message-item {{item.role === 'user' ? 'user-message' : 'ai-message'}}"
      >
        <view class="message-content">
          <view wx:if="{{item.role === 'ai'}}" class="ai-avatar">
            <text class="text-serif">A</text>
          </view>
          <view class="message-bubble">
            <view class="message-text {{item.loading ? 'loading-text' : ''}}">
              <text>{{item.content}}</text>
            </view>
            <view
              wx:if="{{item.role === 'ai' && !item.loading}}"
              class="audio-action"
              data-id="{{item.id}}"
              data-content="{{item.content}}"
              data-loading="{{item.loading}}"
              bindtap="handleSpeakMessage"
            >
              <text wx:if="{{audioLoadingMessageId === item.id}}">生成语音中...</text>
              <text wx:elif="{{playingMessageId === item.id}}">停止朗读</text>
              <text wx:else>朗读回答</text>
            </view>
          </view>
        </view>
      </view>
      <!-- Bottom spacing for fixed input -->
      <view class="bottom-placeholder" style="height: calc({{composerPlaceholderRpx}}rpx + {{keyboardHeight}}px);"></view>
    </view>
  </scroll-view>

  <!-- Fixed Bottom Input Area -->
  <view class="chat-footer" style="bottom: {{keyboardHeight}}px;">
    <view class="quick-queries" wx:if="{{!inputValue && keyboardHeight === 0}}">
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
        <view class="query-list">
          <view
            wx:for="{{quickQuestions}}"
            wx:key="*this"
            class="query-chip"
            data-question="{{item}}"
            bindtap="handleQuickQuestion"
          >
            {{item}}
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="input-area {{isInputExpanded ? 'input-area--expanded' : ''}}">
      <view class="chat-input-wrap">
        <textarea
          class="chat-input"
          placeholder="向这本书提问..."
          placeholder-style="color:#999;"
          value="{{inputValue}}"
          bindinput="handleInput"
          bindblur="handleInputBlur"
          bindlinechange="handleInputLineChange"
          bindkeyboardheightchange="handleKeyboardHeightChange"
          bindconfirm="handleSend"
          confirm-type="send"
          auto-height
          adjust-position="{{false}}"
          cursor-spacing="32"
          maxlength="500"
        />
      </view>
      <view class="send-btn {{inputValue ? 'send-btn--active' : ''}} {{isInputExpanded ? 'send-btn--expanded' : ''}}" bindtap="handleSend">
        <view class="send-icon"></view>
      </view>
    </view>
  </view>
</view>
