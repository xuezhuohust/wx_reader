<view wx:if="{{book}}" class="page-shell chat-page">
  <!-- Custom Navigation Bar -->
  <view class="custom-nav {{scrolled ? 'nav--scrolled' : ''}}" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="nav-back" bindtap="handleBack" style="width: {{menuHeight}}px; height: {{menuHeight}}px;">
        <view class="back-arrow"></view>
      </view>
      <view class="nav-book-meta">
        <text class="nav-book-title">{{book.title}}</text>
        <text class="nav-book-author">{{book.author}}</text>
      </view>
    </view>
  </view>

  <!-- Messages -->
  <scroll-view
    class="chat-body"
    scroll-y
    enhanced
    scroll-with-animation
    scroll-into-view="{{scrollIntoView}}"
    enable-back-to-top
    bindscroll="handleScroll"
    style="padding-top: {{navBarHeight}}px;"
  >
    <view class="message-list">
      <view class="welcome-section">
        <view class="welcome-icon">AI</view>
        <text class="welcome-title">与《{{book.title}}》对话</text>
        <text class="welcome-desc">我是您的智能阅读助手，您可以针对书中的内容向我提问。</text>
      </view>

      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="{{item.id}}"
        class="message-row {{item.role === 'user' ? 'row-user' : 'row-ai'}}"
      >
        <view class="message-container {{item.role === 'user' ? 'container-user' : 'container-ai'}}">
          <view class="message-bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
            <view class="message-text">
              <text user-select>{{item.content}}</text>
              <view wx:if="{{item.loading || (item.role === 'ai' && loadingReply && index === messages.length - 1)}}" class="typing-cursor"></view>
            </view>
          </view>
          
          <view
            wx:if="{{item.role === 'ai' && !item.loading}}"
            class="voice-control {{playingMessageId === item.id ? 'is-playing' : ''}}"
            data-id="{{item.id}}"
            data-content="{{item.content}}"
            bindtap="handleSpeakMessage"
          >
            <view class="voice-wave" wx:if="{{playingMessageId === item.id}}">
              <view class="wave-bar"></view>
              <view class="wave-bar"></view>
              <view class="wave-bar"></view>
            </view>
            <view class="voice-icon-new" wx:else></view>
            <text class="voice-status-text">{{playingMessageId === item.id ? '停止播放' : '朗读'}}</text>
          </view>
        </view>
      </view>
      
      <view class="bottom-space" style="height: {{keyboardHeight + 200}}rpx;"></view>
    </view>
  </scroll-view>

  <!-- Input Area -->
  <view class="chat-footer" style="bottom: {{keyboardHeight}}px;">
    <view class="quick-tips" wx:if="{{!inputValue && keyboardHeight === 0}}">
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
        <view class="tips-row">
          <view
            wx:for="{{quickQuestions}}"
            wx:key="*this"
            class="tip-pill"
            data-question="{{item}}"
            bindtap="handleQuickQuestion"
          >
            {{item}}
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="input-area {{isInputExpanded ? 'input-area--expanded' : ''}}">
      <view class="chat-input-wrap">
        <textarea
          class="chat-input"
          placeholder="向这本书提问..."
          placeholder-style="color:#999;"
          value="{{inputValue}}"
          bindinput="handleInput"
          bindblur="handleInputBlur"
          bindlinechange="handleInputLineChange"
          bindkeyboardheightchange="handleKeyboardHeightChange"
          bindconfirm="handleSend"
          confirm-type="send"
          auto-height
          adjust-position="{{false}}"
          cursor-spacing="32"
          maxlength="500"
        />
      </view>
      <view class="send-btn {{inputValue ? 'send-btn--active' : ''}} {{isInputExpanded ? 'send-btn--expanded' : ''}}" bindtap="handleSend">
        <view class="send-icon"></view>
      </view>
    </view>
  </view>
</view>
