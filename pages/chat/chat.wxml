<view wx:if="{{book}}" class="page-shell chat-page">
  <!-- Custom Navigation Bar -->
  <view class="custom-nav {{scrolled ? 'nav--scrolled' : ''}}" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="nav-back" bindtap="handleBack" style="width: {{menuHeight}}px; height: {{menuHeight}}px;">
        <view class="back-arrow"></view>
      </view>
      <view class="nav-book-meta">
        <text class="nav-book-title">{{book.title}}</text>
        <text class="nav-book-author">{{book.author}}</text>
      </view>
    </view>
  </view>

  <!-- Messages -->
  <scroll-view
    class="chat-body"
    scroll-y
    enhanced
    scroll-with-animation
    scroll-into-view="{{scrollIntoView}}"
    enable-back-to-top
    bindscroll="handleScroll"
    style="padding-top: {{navBarHeight}}px;"
  >
    <view class="message-list">
      <view class="welcome-section">
        <view class="welcome-icon">AI</view>
        <text class="welcome-title">与《{{book.title}}》对话</text>
        <text class="welcome-desc">我是您的智能阅读助手，您可以针对书中的内容向我提问。</text>
      </view>

      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="{{item.id}}"
        class="message-row {{item.role === 'user' ? 'row-user' : 'row-ai'}}"
      >
        <view class="message-container {{item.role === 'user' ? 'container-user' : 'container-ai'}}">
          <view class="message-bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
            <view class="message-text">
              <text user-select>{{item.content}}</text>
              <view wx:if="{{item.loading || (item.role === 'ai' && loadingReply && index === messages.length - 1)}}" class="typing-cursor"></view>
            </view>
          </view>
          
          <view
            wx:if="{{item.role === 'ai' && !item.loading}}"
            class="voice-control {{playingMessageId === item.id ? 'is-playing' : ''}}"
            data-id="{{item.id}}"
            data-content="{{item.content}}"
            bindtap="handleSpeakMessage"
          >
            <view class="voice-wave" wx:if="{{playingMessageId === item.id}}">
              <view class="wave-bar"></view>
              <view class="wave-bar"></view>
              <view class="wave-bar"></view>
            </view>
            <view class="voice-icon-new" wx:else></view>
            <text class="voice-status-text">{{playingMessageId === item.id ? '停止播放' : '朗读'}}</text>
          </view>
        </view>
      </view>
      
      <view class="bottom-space" style="height: {{keyboardHeight + 200}}rpx;"></view>
    </view>
  </scroll-view>

  <!-- Input Area -->
  <view class="chat-footer" style="bottom: {{keyboardHeight}}px;">
    <view class="quick-tips" wx:if="{{!inputValue && keyboardHeight === 0}}">
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
        <view class="tips-row">
          <view
            wx:for="{{quickQuestions}}"
            wx:key="*this"
            class="tip-pill"
            data-question="{{item}}"
            bindtap="handleQuickQuestion"
          >
            {{item}}
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="input-area {{isInputExpanded ? 'input-area--expanded' : ''}}">
      <!-- Mode Toggle: Keyboard/Voice -->
      <view class="mode-toggle-btn" bindtap="handleToggleInputMode">
        <view class="icon-svg {{inputMode === 'voice' ? 'icon-keyboard' : 'icon-voice'}}"></view>
      </view>

      <view class="chat-input-wrap">
        <!-- Text Input Mode -->
        <textarea
          wx:if="{{inputMode === 'keyboard'}}"
          class="chat-input"
          placeholder="向这本书提问..."
          placeholder-style="color:#999;"
          value="{{inputValue}}"
          bindinput="handleInput"
          bindblur="handleInputBlur"
          bindlinechange="handleInputLineChange"
          bindkeyboardheightchange="handleKeyboardHeightChange"
          bindconfirm="handleSend"
          confirm-type="send"
          auto-height
          adjust-position="{{false}}"
          cursor-spacing="32"
          maxlength="500"
        />

        <!-- Voice Input Mode: Tap to Toggle -->
        <view
          wx:else
          class="voice-bar {{isRecording ? 'voice-bar--active' : ''}}"
          bindtap="handleVoiceTap"
        >
          <text>{{isRecording ? '点击停止' : '点击录音'}}</text>
        </view>
      </view>

      <view wx:if="{{inputMode === 'keyboard'}}" class="send-btn {{inputValue ? 'send-btn--active' : ''}} {{isInputExpanded ? 'send-btn--expanded' : ''}}" bindtap="handleSend">
        <view class="send-icon"></view>
      </view>
    </view>
  </view>

  <!-- Recording Overlay -->
  <view class="recording-overlay" wx:if="{{isRecording}}" bindtap="handleVoiceTap">
    <view class="recording-card">
      <view class="recording-wave">
        <view class="wave-item"></view>
        <view class="wave-item"></view>
        <view class="wave-item"></view>
        <view class="wave-item"></view>
      </view>
      <text class="recording-text">正在录音...</text>
      <text class="recording-tip">点击停止</text>
    </view>
  </view>

  <view wx:if="{{showPrivacyModal}}" class="profile-overlay" catchtap="handleDisagreePrivacy">
    <view class="profile-sheet" catchtap="handleStopPropagation">
      <view class="profile-header">
        <text class="profile-sheet-title">隐私授权说明</text>
      </view>
      <view class="permission-content">
        <text class="permission-text">语音对话需要使用录音权限。请先同意隐私授权，再点击录音。</text>
      </view>
      <view class="privacy-actions">
        <button id="chat-privacy-disagree" class="btn-secondary" bindtap="handleDisagreePrivacy">拒绝</button>
        <button
          id="chat-privacy-agree"
          class="btn-primary"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="handleAgreePrivacy"
        >同意</button>
      </view>
    </view>
  </view>

</view>
