.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-canvas);
}

/* Header */
.chat-header {
  display: flex;
  align-items: center;
  padding: 80rpx 40rpx 24rpx;
  background: var(--bg-canvas);
  border-bottom: 1rpx solid var(--hairline);
  z-index: 100;
}

.nav-back {
  padding: 20rpx;
  margin-left: -20rpx;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid var(--ink);
  border-bottom: 4rpx solid var(--ink);
  transform: rotate(45deg);
}

.header-book-info {
  margin-left: 12rpx;
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.header-author {
  font-size: 22rpx;
  color: var(--stone);
}

/* Body */
.chat-body {
  flex: 1;
  min-height: 0;
}

.message-list {
  padding: 40rpx;
}

.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 60rpx 40rpx 100rpx;
}

.welcome-icon {
  width: 100rpx;
  height: 100rpx;
  background: var(--notion-primary);
  color: #fff;
  border-radius: var(--radius-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 32rpx;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.welcome-desc {
  font-size: 26rpx;
  color: var(--slate);
  line-height: 1.6;
}

.message-row {
  display: flex;
  margin-bottom: 48rpx;
}

.row-user {
  justify-content: flex-end;
}

.row-ai {
  justify-content: flex-start;
}

.message-bubble {
  max-width: 85%;
  padding: 24rpx 32rpx;
  border-radius: var(--radius-lg);
  position: relative;
}

.bubble-user {
  background: var(--tint-lavender);
  color: var(--ink);
  border-radius: 32rpx 32rpx 4rpx 32rpx;
}

.bubble-ai {
  background: var(--bg-surface-soft);
  border: 1rpx solid var(--hairline-soft);
  border-radius: 32rpx 32rpx 32rpx 4rpx;
}

.message-text {
  font-size: 30rpx;
  line-height: 1.6;
}

/* Typing Indicator */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  padding: 12rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--stone);
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* Voice Button */
.voice-btn {
  margin-top: 20rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  background: #fff;
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-full);
  font-size: 22rpx;
  color: var(--steel);
}

.voice-icon {
  width: 24rpx;
  height: 24rpx;
  background: var(--steel);
  mask: radial-gradient(circle at center, #000 30%, transparent 70%);
}

.voice-icon.playing {
  background: var(--notion-primary);
  animation: pulse 1s infinite;
}

@keyframes pulse {
  0% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.2); opacity: 0.7; }
  100% { transform: scale(1); opacity: 1; }
}

/* Footer */
.chat-footer {
  position: fixed;
  left: 0;
  right: 0;
  background: var(--bg-canvas);
  border-top: 1rpx solid var(--hairline);
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.quick-tips {
  margin-bottom: 24rpx;
}

.tips-row {
  display: flex;
  gap: 16rpx;
}

.tip-pill {
  white-space: nowrap;
  padding: 12rpx 32rpx;
  background: var(--bg-surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--slate);
}

.input-panel {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  background: var(--bg-surface-soft);
  border: 1rpx solid var(--hairline-strong);
  border-radius: var(--radius-lg);
  padding: 16rpx 24rpx;
}

.message-input {
  flex: 1;
  min-height: 44rpx;
  max-height: 200rpx;
  font-size: 30rpx;
  line-height: 44rpx;
  color: var(--ink);
}

.send-action {
  width: 64rpx;
  height: 64rpx;
  border-radius: var(--radius-md);
  background: var(--hairline-strong);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.send-action.active {
  background: var(--notion-primary);
}

.send-icon {
  width: 24rpx;
  height: 24rpx;
  border-top: 4rpx solid #fff;
  border-right: 4rpx solid #fff;
  transform: rotate(-45deg);
  margin-top: 6rpx;
  margin-right: 4rpx;
}
