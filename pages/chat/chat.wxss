.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-canvas);
}

/* Custom Navigation Bar */
.custom-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: var(--bg-canvas);
  transition: all 0.3s ease;
  border-bottom: 1rpx solid transparent;
}

.nav--scrolled {
  border-bottom: 1rpx solid var(--hairline);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
}

.nav-inner {
  position: absolute;
  left: 0; right: 0;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -20rpx;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid var(--ink);
  border-bottom: 4rpx solid var(--ink);
  transform: rotate(45deg);
  margin-left: 12rpx;
}

.nav-book-meta {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 60%;
}

.nav-book-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.nav-book-author {
  font-size: 20rpx;
  color: var(--stone);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Body */
.chat-body {
  flex: 1;
  min-height: 0;
  background: var(--bg-canvas);
}

.message-list {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 80rpx 40rpx 120rpx;
  opacity: 0.9;
}

.welcome-icon {
  width: 112rpx;
  height: 112rpx;
  background: var(--notion-primary);
  color: #fff;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(19, 30, 56, 0.2);
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 20rpx;
  letter-spacing: -0.01em;
}

.welcome-desc {
  font-size: 26rpx;
  color: var(--slate);
  line-height: 1.7;
  max-width: 480rpx;
}

/* Message Rows */
.message-row {
  display: flex;
  margin-bottom: 48rpx;
  width: 100%;
}

.row-user {
  justify-content: flex-end;
}

.row-ai {
  justify-content: flex-start;
}

.message-container {
  display: flex;
  flex-direction: column;
  max-width: 85%;
}

.container-user {
  align-items: flex-end;
}

.container-ai {
  align-items: flex-start;
}

.message-bubble {
  width: fit-content;
  position: relative;
  transition: all 0.2s ease;
}

.bubble-ai {
  background: var(--bg-surface-soft);
  border: 1rpx solid var(--hairline-soft);
  border-radius: 4rpx 32rpx 32rpx 32rpx;
  padding: 28rpx 32rpx;
}

.bubble-user {
  background: var(--notion-primary);
  color: #fff;
  border-radius: 32rpx 32rpx 4rpx 32rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(19, 30, 56, 0.1);
}

.message-text {
  font-size: 29rpx;
  line-height: 1.6;
  word-wrap: break-word;
  word-break: break-all;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.bubble-ai .message-text {
  color: var(--ink);
}

.bubble-user .message-text {
  color: #fff;
  font-weight: 500;
}

/* Typewriter Cursor */
.typing-cursor {
  display: inline-block;
  width: 4rpx;
  height: 32rpx;
  background: var(--notion-primary);
  margin-left: 4rpx;
  animation: blink 0.8s infinite;
  vertical-align: middle;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* Voice Control Optimized */
.voice-control {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  background: var(--bg-surface-soft);
  border: 1rpx solid var(--hairline-soft);
  border-radius: var(--radius-full);
  width: fit-content;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.voice-control.is-playing {
  border-color: var(--notion-primary);
  background: var(--bg-surface-soft);
}

.voice-control:active {
  transform: scale(0.96);
}

.voice-status-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--slate);
}

.is-playing .voice-status-text {
  color: var(--notion-primary);
}

.voice-icon-new {
  width: 24rpx;
  height: 24rpx;
  background: var(--stone);
  mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"></path><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>') no-repeat center;
  mask-size: contain;
}

/* Sound Wave Animation */
.voice-wave {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 20rpx;
}

.wave-bar {
  width: 4rpx;
  height: 100%;
  background: var(--notion-primary);
  border-radius: 2rpx;
  animation: wave 0.6s infinite ease-in-out;
}

.wave-bar:nth-child(2) { animation-delay: 0.2s; }
.wave-bar:nth-child(3) { animation-delay: 0.4s; }

@keyframes wave {
  0%, 100% { height: 40%; }
  50% { height: 100%; }
}

/* Typing Indicator (Old, kept for safety or removed if unused) */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  padding: 12rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--stone);
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* Footer & Input */
.chat-footer {
  position: fixed;
  left: 0; right: 0;
  background: var(--bg-canvas);
  border-top: 1rpx solid var(--hairline);
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.quick-tips {
  margin-bottom: 24rpx;
}

.tips-row {
  display: flex;
  gap: 16rpx;
  padding: 0 4rpx;
}

.tip-pill {
  white-space: nowrap;
  padding: 14rpx 32rpx;
  background: var(--bg-surface-soft);
  border: 1rpx solid var(--hairline-soft);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--slate);
  font-weight: 600;
  transition: all 0.2s;
}

.tip-pill:active {
  background: var(--bg-surface);
  transform: scale(0.96);
}

.input-area {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
  background: var(--bg-surface);
  border-radius: 40rpx;
  padding: 12rpx 12rpx 12rpx 32rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1rpx solid transparent;
}

.input-area--expanded {
  background: #ffffff;
  border-color: var(--hairline);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.chat-input-wrap {
  flex: 1;
  padding: 12rpx 0;
}

.chat-input {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--ink);
  min-height: 44rpx;
  max-height: 200rpx;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--stone);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
}

.send-btn--active {
  background: var(--notion-primary);
  box-shadow: 0 4rpx 12rpx rgba(19, 30, 56, 0.2);
}

.send-btn:active {
  transform: scale(0.9);
}

.send-icon {
  width: 24rpx;
  height: 24rpx;
  border-top: 4rpx solid #fff;
  border-right: 4rpx solid #fff;
  transform: rotate(45deg);
  margin-top: 4rpx;
  margin-left: -4rpx;
}

.bottom-space {
  width: 100%;
}