.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-canvas);
}

/* Custom Navigation Bar */
.custom-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: var(--bg-canvas);
  transition: all 0.3s ease;
  border-bottom: 1rpx solid transparent;
}

.nav--scrolled {
  border-bottom: 1rpx solid var(--hairline);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
}

.nav-inner {
  position: absolute;
  left: 0; right: 0;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: -20rpx;
}

.back-arrow {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid var(--ink);
  border-bottom: 4rpx solid var(--ink);
  transform: rotate(45deg);
  margin-left: 12rpx;
}

/* 2026-05-19 新增：对话切换按钮 */
.nav-conv-btn {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  margin-left: 8rpx;
  background: var(--bg-card);
  border-radius: 24rpx;
  border: 1rpx solid var(--hairline);
  flex-shrink: 0;
}

.nav-conv-label {
  font-size: 24rpx;
  color: var(--slate);
}

.nav-conv-arrow {
  width: 0;
  height: 0;
  border-left: 8rpx solid transparent;
  border-right: 8rpx solid transparent;
  transition: transform 0.2s ease;
}

.arrow-down {
  border-top: 8rpx solid var(--slate);
}

.arrow-up {
  border-bottom: 8rpx solid var(--slate);
}

.nav-book-meta {
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 60%;
}

.nav-book-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.nav-book-author {
  font-size: 20rpx;
  color: var(--stone);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* Body */
.chat-body {
  flex: 1;
  min-height: 0;
  background: var(--bg-canvas);
}

.message-list {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

.welcome-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 80rpx 40rpx 120rpx;
  opacity: 0.9;
}

.welcome-icon {
  width: 112rpx;
  height: 112rpx;
  background: var(--notion-primary);
  color: #fff;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 800;
  margin-bottom: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(19, 30, 56, 0.2);
}

.welcome-title {
  font-size: 38rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 20rpx;
  letter-spacing: -0.01em;
}

.welcome-desc {
  font-size: 26rpx;
  color: var(--slate);
  line-height: 1.7;
  max-width: 480rpx;
}

.welcome-actions {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.welcome-clear-btn {
  height: 48rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 14rpx;
  border-radius: 6rpx;
  color: var(--stone);
  font-size: 23rpx;
  font-weight: 600;
}

.welcome-clear-btn:active {
  color: #b43b3b;
  background: rgba(214, 69, 69, 0.06);
}

.welcome-clear-btn--disabled {
  opacity: 0.42;
}

.welcome-clear-icon {
  position: relative;
  width: 18rpx;
  height: 20rpx;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 4rpx 4rpx;
}

.welcome-clear-icon::before {
  content: '';
  position: absolute;
  top: -7rpx;
  left: -5rpx;
  width: 22rpx;
  height: 3rpx;
  border-radius: 3rpx;
  background: currentColor;
}

.welcome-clear-icon::after {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 4rpx;
  width: 7rpx;
  height: 5rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 4rpx 4rpx 0 0;
}

/* Message Rows */
.message-row {
  display: flex;
  margin-bottom: 48rpx;
  width: 100%;
}

.row-user {
  justify-content: flex-end;
}

.row-ai {
  justify-content: flex-start;
}

.message-container {
  display: flex;
  flex-direction: column;
  max-width: 85%;
}

.container-user {
  align-items: flex-end;
}

.container-ai {
  align-items: flex-start;
}

.message-bubble {
  width: fit-content;
  position: relative;
  transition: all 0.2s ease;
}

.bubble-ai {
  background: var(--bg-surface-soft);
  border: 1rpx solid var(--hairline-soft);
  border-radius: 4rpx 32rpx 32rpx 32rpx;
  padding: 28rpx 32rpx;
}

.bubble-user {
  background: var(--notion-primary);
  color: #fff;
  border-radius: 32rpx 32rpx 4rpx 32rpx;
  padding: 24rpx 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(19, 30, 56, 0.1);
}

.message-text {
  font-size: 29rpx;
  line-height: 1.6;
  word-wrap: break-word;
  word-break: break-all;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.bubble-ai .message-text {
  color: var(--ink);
}

.bubble-user .message-text {
  color: #fff;
  font-weight: 500;
}

/* Typewriter Cursor */
.typing-cursor {
  display: inline-block;
  width: 4rpx;
  height: 32rpx;
  background: var(--notion-primary);
  margin-left: 4rpx;
  animation: blink 0.8s infinite;
  vertical-align: middle;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0; }
}

/* Voice Control Optimized */
.voice-control {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 8rpx 20rpx;
  background: var(--bg-surface-soft);
  border: 1rpx solid var(--hairline-soft);
  border-radius: var(--radius-full);
  width: fit-content;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.voice-control.is-playing {
  border-color: var(--notion-primary);
  background: var(--bg-surface-soft);
}

.voice-control:active {
  transform: scale(0.96);
}

.voice-status-text {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--slate);
}

.is-playing .voice-status-text {
  color: var(--notion-primary);
}

.voice-icon-new {
  width: 24rpx;
  height: 24rpx;
  background: var(--stone);
  mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5L6 9H2v6h4l5 4V5z"></path><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>') no-repeat center;
  mask-size: contain;
}

/* Sound Wave Animation */
.voice-wave {
  display: flex;
  align-items: flex-end;
  gap: 4rpx;
  height: 20rpx;
}

.wave-bar {
  width: 4rpx;
  height: 100%;
  background: var(--notion-primary);
  border-radius: 2rpx;
  animation: wave 0.6s infinite ease-in-out;
}

.wave-bar:nth-child(2) { animation-delay: 0.2s; }
.wave-bar:nth-child(3) { animation-delay: 0.4s; }

@keyframes wave {
  0%, 100% { height: 40%; }
  50% { height: 100%; }
}

/* Typing Indicator (Old, kept for safety or removed if unused) */
.typing-indicator {
  display: flex;
  gap: 8rpx;
  padding: 12rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background: var(--stone);
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out;
}

.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0); }
  40% { transform: scale(1); }
}

/* Footer & Input */
.chat-footer {
  position: fixed;
  left: 0; right: 0;
  background: var(--bg-canvas);
  border-top: 1rpx solid var(--hairline);
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.quick-tips {
  margin-bottom: 24rpx;
}

.tips-row {
  display: flex;
  gap: 16rpx;
  padding: 0 4rpx;
}

.tip-pill {
  white-space: nowrap;
  padding: 14rpx 32rpx;
  background: var(--bg-surface-soft);
  border: 1rpx solid var(--hairline-soft);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  color: var(--slate);
  font-weight: 600;
  transition: all 0.2s;
}

.tip-pill:active {
  background: var(--bg-surface);
  transform: scale(0.96);
}

.input-area {
  display: flex;
  align-items: flex-end;
  gap: 20rpx;
}

.mode-toggle-btn {
  width: 72rpx;
  height: 80rpx; /* Match voice bar height */
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-keyboard {
  width: 44rpx;
  height: 44rpx;
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%235d5b54" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="M6 8h.01"></path><path d="M10 8h.01"></path><path d="M14 8h.01"></path><path d="M18 8h.01"></path><path d="M8 12h.01"></path><path d="M12 12h.01"></path><path d="M16 12h.01"></path><path d="M7 16h10"></path></svg>');
  background-size: contain;
  background-repeat: no-repeat;
}

.icon-voice {
  width: 44rpx;
  height: 44rpx;
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%235d5b54" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>');
  background-size: contain;
  background-repeat: no-repeat;
}

.chat-input-wrap {
  flex: 1;
  min-height: 80rpx;
  display: flex;
  align-items: center;
  background: var(--bg-surface-soft);
  border-radius: 40rpx;
  border: 1rpx solid var(--hairline-soft);
  box-sizing: border-box;
}

.chat-input {
  width: 100%;
  padding: 18rpx 32rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--ink);
}

.voice-bar {
  width: 100%;
  height: 78rpx; /* Slightly less than wrap to account for border */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  border-radius: 40rpx;
}

.send-btn {
  width: 72rpx;
  height: 80rpx; /* Match voice bar height */
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.voice-bar--active {
  background: var(--hairline-soft);
  transform: scale(0.98);
}

/* Recording Overlay */
.recording-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2000;
}

.recording-card {
  width: 320rpx;
  height: 320rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(20px);
  border-radius: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 24rpx 64rpx rgba(0, 0, 0, 0.2);
  transition: all 0.2s;
}

.recording-card--cancel {
  background: rgba(212, 48, 48, 0.8);
}

.recording-wave {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 60rpx;
  margin-bottom: 32rpx;
}

.wave-item {
  width: 6rpx;
  height: 20rpx;
  background: #ffffff;
  border-radius: 4rpx;
  animation: wave-grow 1s ease-in-out infinite;
}

.wave-item:nth-child(2) { animation-delay: 0.2s; height: 40rpx; }
.wave-item:nth-child(3) { animation-delay: 0.4s; height: 30rpx; }
.wave-item:nth-child(4) { animation-delay: 0.6s; }

@keyframes wave-grow {
  0%, 100% { transform: scaleY(1); }
  50% { transform: scaleY(2); }
}

.recording-text {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 8rpx;
}

.recording-tip {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.6);
}

.cancel-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-undo-white {
  width: 56rpx;
  height: 56rpx;
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M3 7v6h6"></path><path d="M21 17a9 9 0 0 0-9-15 9 9 0 0 0-6 3"></path></svg>');
  background-size: contain;
  background-repeat: no-repeat;
}

.cancel-text {
  color: #ffffff;
}

.chat-input {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--ink);
  min-height: 44rpx;
  max-height: 200rpx;
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-full);
  background: var(--stone);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  flex-shrink: 0;
}

.send-btn--active {
  background: var(--notion-primary);
  box-shadow: 0 4rpx 12rpx rgba(19, 30, 56, 0.2);
}

.send-btn:active {
  transform: scale(0.9);
}

.send-icon {
  width: 24rpx;
  height: 24rpx;
  border-top: 4rpx solid #fff;
  border-right: 4rpx solid #fff;
  transform: rotate(45deg);
  margin-top: 4rpx;
  margin-left: -4rpx;
}

.bottom-space {
  width: 100%;
}

/* Scroll-down button */
.scroll-down-btn {
  position: fixed;
  bottom: 280rpx;
  right: 40rpx;
  z-index: 99;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 28rpx;
  background: var(--notion-primary);
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(19, 30, 56, 0.25);
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.scroll-down-icon {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-bottom: 12rpx solid #fff;
}

.scroll-down-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}

.profile-overlay {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.profile-sheet {
  width: 100%;
  max-width: 640rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 36rpx;
}

.profile-header {
  margin-bottom: 20rpx;
}

.profile-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.permission-content {
  margin-bottom: 28rpx;
}

.permission-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--slate);
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
}

.privacy-actions button {
  flex: 1;
}

/* ====================================================================
   2026-05-19 新增：对话切换面板
   ==================================================================== */

/* 遮罩层 */
.conv-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 998;
  background: rgba(0, 0, 0, 0.3);
}

/* 面板容器 */
.conv-panel {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 999;
  background: var(--bg-canvas);
  border-bottom: 1rpx solid var(--hairline);
  transform: translateY(-100%);
  transition: transform 0.25s ease;
  max-height: 60vh;
  display: flex;
  flex-direction: column;
}

.conv-panel--open {
  transform: translateY(0);
}

/* 面板头部 */
.conv-panel-header {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 24rpx 32rpx;
  flex-shrink: 0;
}

.conv-panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.conv-panel-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
  border-bottom: 1rpx solid var(--hairline);
  flex-shrink: 0;
}

.conv-panel-new {
  display: flex;
  align-items: center;
  gap: 6rpx;
  width: 100%;
  min-width: 0;
  height: 72rpx;
  justify-content: center;
  background: var(--primary);
  border-radius: 16rpx;
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.conv-panel-new:active {
  transform: scale(0.96);
}

.conv-panel-new-icon {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
}

/* 面板列表 */
.conv-panel-list {
  flex: 1;
  overflow-y: auto;
  padding: 12rpx 0;
}

/* 单个对话项 */
.conv-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  transition: background 0.15s ease;
}

.conv-item:active {
  background: var(--bg-card);
}

.conv-item--active {
  background: var(--bg-card);
}

.conv-item-icon {
  font-size: 32rpx;
  flex-shrink: 0;
}

.conv-item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.conv-item-title {
  font-size: 28rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.conv-item-time {
  font-size: 22rpx;
  color: var(--slate);
}

/* 激活态圆点标记 */
.conv-item--active .conv-item-title::after {
  content: '';
  display: inline-block;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-left: 12rpx;
  vertical-align: middle;
}
