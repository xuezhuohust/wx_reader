.chat-container {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-paper);
  overflow: hidden;
}

/* Header Styles */
.chat-header {
  flex-shrink: 0;
  padding: 32rpx 40rpx;
  background: linear-gradient(to bottom, var(--bg-paper), rgba(249, 247, 242, 0.8));
  border-bottom: 1rpx solid var(--border-subtle);
  z-index: 10;
}

.book-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-ink);
  display: block;
}

.book-author {
  font-size: 24rpx;
  color: var(--text-muted);
  margin-top: 8rpx;
  display: block;
}

.chat-intro {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: var(--text-body);
  line-height: 1.5;
  opacity: 0.8;
}

/* Messages List */
.chat-messages {
  flex: 1;
  min-height: 0;
}

.message-list {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
}

.message-item {
  margin-bottom: 64rpx;
  max-width: 90%;
  animation: slideUp 0.4s ease-out;
}

.user-message {
  align-self: flex-end;
}

.ai-message {
  align-self: flex-start;
}

.message-content {
  display: flex;
  gap: 24rpx;
}

.message-bubble {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.user-message .message-content {
  flex-direction: row-reverse;
}

.user-message .message-bubble {
  align-items: flex-end;
}

.ai-avatar {
  width: 56rpx;
  height: 56rpx;
  background: #eee;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
  flex-shrink: 0;
}

.message-text {
  font-size: 32rpx;
  line-height: 1.7;
  color: var(--text-body);
  padding: 8rpx 0;
}

.user-message .message-text {
  background: var(--bg-pure);
  padding: 24rpx 32rpx;
  border-radius: 24rpx 24rpx 4rpx 24rpx;
  border: 1rpx solid var(--border-subtle);
  box-shadow: var(--shadow-soft);
  color: var(--text-ink);
}

.loading-text {
  opacity: 0.6;
  font-style: italic;
}

.audio-action {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1;
  color: var(--accent-literary);
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  background: rgba(255, 255, 255, 0.72);
}

.bottom-placeholder {
  height: 240rpx;
}

/* Footer Area */
.chat-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to top, var(--bg-paper) 80%, transparent);
  padding: 24rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.quick-queries {
  margin-bottom: 24rpx;
}

.query-list {
  display: flex;
  gap: 16rpx;
  padding: 4rpx;
}

.query-chip {
  white-space: nowrap;
  padding: 12rpx 28rpx;
  background: var(--bg-pure);
  border: 1rpx solid var(--border-subtle);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: var(--text-body);
  box-shadow: var(--shadow-soft);
}

.input-area {
  background: var(--bg-pure);
  border: 1rpx solid var(--border-ink);
  border-radius: 48rpx;
  padding: 12rpx 12rpx 12rpx 28rpx;
  display: flex;
  align-items: center;
  box-shadow: var(--shadow-focus);
  transition: padding 0.2s ease, border-radius 0.2s ease;
}

.input-area--expanded {
  align-items: flex-end;
  padding-top: 18rpx;
  padding-bottom: 18rpx;
  border-radius: 32rpx;
}

.voice-btn {
  min-width: 96rpx;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 36rpx;
  background: #f3ede3;
  color: var(--text-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.voice-btn--recording {
  background: #c95d3a;
  color: #fff;
}

.voice-btn--loading {
  background: #d7d0c3;
  color: var(--text-muted);
}

.chat-input-wrap {
  flex: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
}

.input-area--expanded .chat-input-wrap {
  align-items: flex-start;
}

.chat-input {
  width: 100%;
  min-height: 40rpx;
  max-height: 200rpx;
  font-size: 30rpx;
  line-height: 40rpx;
  padding: 16rpx 0;
  color: var(--text-ink);
}

.send-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eee;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 16rpx;
  flex-shrink: 0;
  transition: all 0.3s;
}

.send-btn--expanded {
  margin-bottom: 4rpx;
}

.send-btn--active {
  background: var(--accent-literary);
}

.send-icon {
  width: 32rpx;
  height: 32rpx;
  border-top: 4rpx solid #fff;
  border-right: 4rpx solid #fff;
  transform: rotate(-45deg);
  margin-top: 8rpx;
  margin-right: 4rpx;
}
