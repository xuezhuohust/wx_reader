.guide-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #faf8f5;
  color: #1b1b1b;
}

.guide-swiper {
  flex: 1;
}

.guide-slide {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  text-align: center;
  height: 100%;
}

.illustration {
  margin-bottom: 56rpx;
}

.icon-wrap {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background-color: rgba(60, 105, 43, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon {
  width: 96rpx;
  height: 96rpx;
}

/* Fallback icons using CSS if images are missing */
.icon-placeholder {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-book {
  width: 60rpx;
  height: 80rpx;
  border: 4rpx solid #3c692b;
  border-radius: 4rpx;
  position: relative;
}

.icon-book::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 20rpx;
  width: 30rpx;
  height: 4rpx;
  background-color: #3c692b;
  box-shadow: 0 10rpx 0 #3c692b, 0 20rpx 0 #3c692b;
}

.icon-user {
  width: 50rpx;
  height: 50rpx;
  border: 4rpx solid #3c692b;
  border-radius: 50%;
  position: relative;
}

.icon-user::after {
  content: '';
  position: absolute;
  bottom: -30rpx;
  left: -10rpx;
  width: 70rpx;
  height: 30rpx;
  border: 4rpx solid #3c692b;
  border-bottom: none;
  border-radius: 30rpx 30rpx 0 0;
}

.title {
  font-size: 48rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
  color: #1b1b1b;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #8c8c8c;
  line-height: 1.5;
  max-width: 520rpx;
}

.guide-footer {
  padding: 0 60rpx 80rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dots {
  display: flex;
  gap: 12rpx;
  margin-bottom: 40rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.1);
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

.dot.active {
  background-color: #3c692b;
  width: 36rpx;
  border-radius: 99rpx;
}

.actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.next-btn {
  width: 100% !important;
  max-width: 560rpx;
  padding: 28rpx 0;
  border-radius: 28rpx;
  background-color: #1b1b1b;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
}

.login-btn {
  width: 100% !important;
  max-width: 560rpx;
  padding: 28rpx 0;
  border-radius: 28rpx;
  background-color: #07C160;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

