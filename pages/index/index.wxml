<view class="page-container home-page {{isLargeScreen ? 'home-page--large' : ''}} {{isPadPortrait ? 'home-page--pad-portrait' : ''}}" style="{{windowHeight ? 'height: ' + windowHeight + 'px;' : ''}}">
  <scroll-view
    class="scroll-area"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    bindscroll="onPageScroll"
  >
    <view class="scroll-content no-padding-top">
      <!-- Hero Header Section -->
      <view class="home-hero-header fade-up" wx:if="{{!isLargeScreen}}">
        <view class="hero-academic-pattern"></view>
        <view class="hero-glass-overlay"></view>
        
        <view class="hero-body" style="padding-top: {{menuTop}}px;">
          <view class="hero-top-nav">
            <view class="greeting-group">
              <text class="greeting-time">{{timeGreeting}} · Academic Research</text>
              <view class="greeting-main">
                <text class="app-title">LitCompanion AI</text>
              </view>
            </view>
          </view>

          <!-- Stripped-out Continue Reading (Not a card) -->
          <view class="hero-reading-entry" wx:if="{{recommendBooks.length > 0}}" bindtap="handleRecommendTap" data-id="{{recommendBooks[0].id}}" data-from="hero">
            <view class="entry-cover-box">
              <image wx:if="{{recommendBooks[0].coverUrl}}" src="{{recommendBooks[0].coverUrl}}" mode="aspectFill" />
              <view class="cover-placeholder-mini" wx:else>{{recommendBooks[0].title[0]}}</view>
            </view>
            <view class="entry-main-info">
              <view class="entry-meta">
                <text class="entry-tag">RESUME SESSION</text>
                <text class="entry-pct">{{recommendBooks[0].progress || '0'}}%</text>
              </view>
              <view class="entry-title-row">
                <text class="entry-book-title">{{recommendBooks[0].title}}</text>
                <view class="entry-arrow-icon"></view>
              </view>
              <view class="entry-progress-bar">
                <view class="entry-progress-fill" style="width: {{recommendBooks[0].progress || 0}}%;"></view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 横屏 Pad 的全宽搜索入口：手机端维持原有书库搜索体验。 -->
      <view class="home-search-section fade-up d2" wx:if="{{isLargeScreen}}">
        <view class="home-search-bar">
          <view class="icon-search-small"></view>
          <input
            class="home-search-input"
            placeholder="Search corpus by title, author or keyword..."
            placeholder-class="search-placeholder"
            bindinput="handleKeywordInput"
            value="{{searchValue}}"
          />
          <view
            wx:if="{{searchValue}}"
            class="home-search-clear"
            bindtap="handleSearchClear"
            aria-label="清空搜索"
          >×</view>
        </view>
      </view>

      <view class="pad-dashboard-container fade-up" wx:if="{{isLargeScreen}}">
        <view class="pad-dashboard-canvas">
          <view class="pad-dash-header">
            <view class="pad-dash-brand">
              <view class="pad-brand-logo">
                <view class="pad-brand-book-icon"></view>
              </view>
              <view class="pad-dash-tabs">
                <view 
                  wx:for="{{padTabs}}" 
                  wx:key="*this" 
                  class="pad-tab-item {{padActiveTab === item ? 'pad-tab-item--active' : ''}}"
                  bindtap="handlePadTabTap"
                  data-tab="{{item}}"
                >
                  <text>{{item}}</text>
                </view>
              </view>
            </view>

            <view class="pad-dash-user-profile">
              <view class="user-avatar-wrap">
                <text class="user-avatar-txt font-mono">E</text>
              </view>
              <view class="user-info-meta">
                <text class="user-name">Emma</text>
                <text class="user-role-badge font-mono">Young Explorer</text>
              </view>
            </view>
          </view>

          <view class="pad-dash-grid">
            <!-- Left Column -->
            <view class="pad-dash-col pad-dash-col--left">
              <!-- F13: Now Reading Panel -->
              <view class="pad-now-reading card-editorial" wx:if="{{recommendBooks.length > 0}}" bindtap="handleRecommendTap" data-id="{{recommendBooks[0].id}}">
                <view class="now-reading-left">
                  <view class="now-reading-tag font-mono">Now reading: <text class="now-reading-bold">{{recommendBooks[0].title}}</text></view>
                </view>
                <view class="now-reading-cover">
                  <image wx:if="{{recommendBooks[0].coverUrl}}" src="{{recommendBooks[0].coverUrl}}" mode="aspectFill" />
                  <view class="now-reading-placeholder font-mono" wx:else>{{recommendBooks[0].title[0]}}</view>
                </view>
              </view>

              <!-- F14: Reading History & Extracted Scientific Concepts -->
              <view class="pad-history-panel card-editorial">
                <view class="panel-section-title">Reading History</view>
                <view class="history-list">
                  <view class="history-item" wx:for="{{padHistoryBooks}}" wx:key="id" bindtap="handleBookTap" data-id="{{item.id}}">
                    <view class="history-item-top">
                      <view class="history-cover-wrap">
                        <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
                        <view class="history-cover-placeholder font-mono" wx:else>{{item.title[0]}}</view>
                      </view>
                      <view class="history-info">
                        <view class="history-title">{{item.title}}</view>
                        <view class="history-meta font-mono">{{index === 0 ? "2 keywords in total" : "11 keywords in total"}}</view>
                      </view>
                      <view class="history-progress-pill font-mono">
                        <text class="progress-num">{{item.progress || (index === 0 ? 50 : 9)}}%</text>
                        <view class="progress-triangle"></view>
                      </view>
                    </view>

                    <view class="history-concept-box" wx:if="{{index === 0}}">
                      <view class="concept-badge-row">
                        <view class="concept-keyword font-mono">wind</view>
                        <text class="concept-text">wind and water can change the shape of the land.</text>
                      </view>
                      <view class="concept-tag font-mono">#Earth Materials and Systems</view>
                    </view>
                  </view>
                </view>
              </view>
            </view>

            <!-- Right Column -->
            <view class="pad-dash-col pad-dash-col--right">
              <!-- F15: Quantitative Metrics Bento -->
              <view class="pad-metrics-grid">
                <view class="metric-card card-editorial">
                  <view class="metric-icon metric-icon--book"><view class="icon-inner-book"></view></view>
                  <view class="metric-body">
                    <view class="metric-label">Today read</view>
                    <view class="metric-value font-mono">3 <text class="metric-unit">books</text></view>
                  </view>
                </view>
                <view class="metric-card card-editorial">
                  <view class="metric-icon metric-icon--layers"><view class="icon-inner-layers"></view></view>
                  <view class="metric-body">
                    <view class="metric-label">Total read</view>
                    <view class="metric-value font-mono">7 <text class="metric-unit">books</text></view>
                  </view>
                </view>
                <view class="metric-card card-editorial">
                  <view class="metric-icon metric-icon--hourglass"><view class="icon-inner-hourglass"></view></view>
                  <view class="metric-body">
                    <view class="metric-label">Today spent</view>
                    <view class="metric-value font-mono">13 <text class="metric-unit">minutes</text></view>
                  </view>
                </view>
                <view class="metric-card card-editorial">
                  <view class="metric-icon metric-icon--clock"><view class="icon-inner-clock"></view></view>
                  <view class="metric-body">
                    <view class="metric-label">Total spent</view>
                    <view class="metric-value font-mono">26 <text class="metric-unit">minutes</text></view>
                  </view>
                </view>
              </view>

              <!-- F16: Real-world Knowledge Learning Statistics -->
              <view class="pad-analytics-card card-editorial">
                <view class="panel-section-title">Real-world knowledge Learning Statistics</view>
                <view class="analytics-subtitle">Disciplines learning record</view>
                
                <view class="analytics-viz-row">
                  <view class="pie-chart-mock">
                    <view class="pie-circle-outer"></view>
                    <view class="pie-tooltip-box font-mono">
                      <text class="tooltip-title">Earth and Space Science</text>
                      <text class="tooltip-val">1 (25%)</text>
                    </view>
                  </view>
                  <view class="donut-legend">
                    <view class="legend-item"><view class="legend-dot dot-slate"></view><text>Earth and Space Science</text></view>
                    <view class="legend-item"><view class="legend-dot dot-amber"></view><text>Life Science</text></view>
                    <view class="legend-item"><view class="legend-dot dot-blue"></view><text>Physical Science</text></view>
                  </view>
                </view>

                <view class="sub-disciplines-box">
                  <view class="sub-title">Most learned sub-disciplines</view>
                  <view class="sub-bar-group">
                    <view class="sub-bar-item">
                      <text class="sub-label">Biological Evolution</text>
                      <view class="sub-bar-track"><view class="sub-bar-fill bar-amber" style="width: 70%;"></view></view>
                    </view>
                    <view class="sub-bar-item">
                      <text class="sub-label">Earth Systems</text>
                      <view class="sub-bar-track"><view class="sub-bar-fill bar-green" style="width: 55%;"></view></view>
                    </view>
                    <view class="sub-bar-item">
                      <text class="sub-label">Ecosystems Dynamics</text>
                      <view class="sub-bar-track"><view class="sub-bar-fill bar-yellow" style="width: 40%;"></view></view>
                    </view>
                    <view class="sub-bar-item">
                      <text class="sub-label">Energy Interactions</text>
                      <view class="sub-bar-track"><view class="sub-bar-fill bar-cyan" style="width: 45%;"></view></view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="main-sections" wx:if="{{!isLargeScreen}}">
        <!-- Today's Recommendations -->
        <view class="section-header fade-up d2" wx:if="{{recommendBooks.length > 0 && (!isLargeScreen || !searchValue || filteredBooks.length > 0)}}">
          <view class="section-title">{{isLargeScreen && searchValue ? 'Search Results' : 'Featured Corpus'}}</view>
          <view class="section-link" wx:if="{{!(isLargeScreen && searchValue)}}" bindtap="handleSeeMore">Browse All</view>
        </view>
      
      <scroll-view class="book-scroll fade-up d3" wx:if="{{!isLargeScreen || !searchValue || filteredBooks.length > 0}}" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="book-row">
          <block wx:if="{{loading}}">
            <view wx:for="{{[1,2,3]}}" wx:key="*this" class="book-card-skeleton skeleton-pulse">
              <view class="skeleton-bg cover-placeholder"></view>
              <view class="skeleton-bg title-placeholder"></view>
            </view>
          </block>
          <block wx:else>
            <view 
              class="book-card" 
              wx:for="{{isLargeScreen && searchValue ? filteredBooks : recommendBooks}}"
              wx:key="id" 
              bindtap="handleRecommendTap"
              data-id="{{item.id}}"
            >
              <view class="book-card-cover" style="background: {{item.coverColor}};">
                <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill"></image>
                <view class="book-placeholder-inner-flat" wx:else>
                  <view class="placeholder-title-flat" style="font-size: 60rpx;">{{item.title[0]}}</view>
                </view>
              </view>
              <view class="book-card-info">
                <view class="book-card-title">{{item.title}}</view>
                <view class="book-card-meta">
                  <text>{{item.author || 'Scholar'}}</text>
                  <text class="meta-dot" wx:if="{{item.category && !isLargeScreen}}">·</text>
                  <text wx:if="{{item.category && !isLargeScreen}}">{{item.category}}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>

      <!-- For You (Masonry Style Library) -->
      <view class="section-header fade-up d4 section-mt" wx:if="{{!isLargeScreen || !searchValue}}">
        <view class="section-title">Curated Works</view>
        <view class="section-link" bindtap="handleRefreshRecommend">Refresh</view>
      </view>

      <view class="masonry-grid fade-up d5" wx:if="{{!isLargeScreen || !searchValue}}">
        <block wx:if="{{loading}}">
          <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="masonry-item-skeleton skeleton-pulse">
            <view class="skeleton-bg" style="height: {{index % 2 === 0 ? '300rpx' : '400rpx'}};"></view>
            <view class="skeleton-bg" style="width: 80%; height: 24rpx; margin-top: 12rpx;"></view>
          </view>
        </block>
        <block wx:else>
          <view 
            class="masonry-item" 
            wx:for="{{filteredBooks}}" 
            wx:key="id"
            bindtap="handleBookTap"
            data-id="{{item.id}}"
          >
            <view class="masonry-cover" style="background: {{item.coverColor || '#f3efe8'}};">
              <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFit"></image>
              <view class="book-placeholder-inner-flat" wx:else>
                <view class="placeholder-title-flat">{{item.title[0]}}</view>
              </view>
              <view class="masonry-badge" wx:if="{{item.isAIReady}}">AI Annotated</view>
            </view>
            <view class="masonry-info">
              <view class="masonry-title">{{item.title}}</view>
              <view class="masonry-meta">
                <text>{{item.author || 'Scholar'}}</text>
                <text class="meta-dot" wx:if="{{!isLargeScreen}}">·</text>
                <text wx:if="{{!isLargeScreen}}">{{item.rating}} pts</text>
              </view>
            </view>
          </view>
        </block>
      </view>

      <view class="home-search-empty" wx:if="{{!loading && searchValue && filteredBooks.length === 0}}">
        No documents found matching "{{searchValue}}"
      </view>

      <view class="safe-area-bottom"></view>
    </view> <!-- Close main-sections -->
  </view> <!-- Close scroll-content -->
</scroll-view> <!-- Close scroll-area -->

  <!-- Privacy Modal -->
  <view wx:if="{{showPrivacyModal}}" class="privacy-overlay" catchtap="handleDisagreePrivacy">
    <view class="privacy-sheet" catchtap="handleStopPropagation">
      <view class="privacy-header">
        <text class="privacy-title">{{privacyModalTitle}}</text>
      </view>
      <view class="privacy-content">
        <text class="privacy-text">{{privacyModalText}}</text>
      </view>
      <view class="privacy-actions">
        <button class="btn-secondary" bindtap="handleDisagreePrivacy">Decline</button>
        <button
          id="home-privacy-agree"
          class="btn-primary"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="handleAgreePrivacy"
        >Agree & Continue</button>
      </view>
    </view>
  </view>
</view>
