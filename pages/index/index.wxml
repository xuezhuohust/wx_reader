<view class="page-shell home-page">
  <!-- Custom Navigation Bar -->
  <view class="custom-nav" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px; padding-left: 40rpx; padding-right: {{menuRight}}px;">
      <text class="nav-title">AI 伴读</text>
    </view>
  </view>

  <scroll-view
    class="content-body"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    style="padding-top: {{navBarHeight + 16}}px;"
    bindscroll="onPageScroll"
  >
    <!-- Greeting -->
    <view class="greeting-section">
      <text class="greeting-title">你好，读者</text>
      <text class="greeting-desc">今天是一个适合深度思考的好日子。</text>
    </view>

    <!-- Stats Cards -->
    <view class="stats-row">
      <view class="stat-card levitating-paper">
        <view class="stat-icon stat-icon--book"></view>
        <text class="stat-value">{{books.length || 0}}</text>
        <text class="stat-label">在读文献</text>
      </view>
      <view class="stat-card levitating-paper">
        <view class="stat-icon stat-icon--streak"></view>
        <text class="stat-value">34</text>
        <text class="stat-label">连续阅读</text>
      </view>
      <view class="stat-card levitating-paper">
        <view class="stat-icon stat-icon--time"></view>
        <text class="stat-value">128</text>
        <text class="stat-label">专注时长(h)</text>
      </view>
    </view>

    <!-- Continue Reading -->
    <view class="section-header">
      <text class="section-title">继续阅读</text>
      <text class="section-link" bindtap="handleProfileTap">查看全部</text>
    </view>

    <view class="continue-card levitating-paper" wx:if="{{recommendBooks.length > 0}}" bindtap="handleRecommendTap" data-id="{{recommendBooks[0].id}}">
      <view class="continue-row">
        <view class="continue-cover">
          <image wx:if="{{recommendBooks[0].coverUrl}}" src="{{recommendBooks[0].coverUrl}}" mode="aspectFill" />
          <view wx:else class="cover-empty-sm"><text>暂无</text></view>
        </view>
        <view class="continue-info">
          <text class="continue-title">{{recommendBooks[0].title}}</text>
          <text class="continue-author">{{recommendBooks[0].author || '未知作者'}}</text>
          <view class="continue-meta">
            <text class="continue-category">{{recommendBooks[0].category || '综合'}}</text>
          </view>
          <text class="continue-desc">{{recommendBooks[0].description || '暂无简介'}}</text>
        </view>
      </view>
      <view class="ai-summary-box">
        <text class="ai-summary-label">AI 核心摘要</text>
        <text class="ai-summary-text">{{recommendBooks[0].recommendReason || 'AI 已为您预处理深度关联分析...'}}</text>
      </view>
      <view class="continue-btn">
        <text>开启 AI 伴读</text>
      </view>
    </view>

    <!-- Skeleton for continue card -->
    <view class="continue-card levitating-paper skeleton-pulse" wx:elif="{{loading}}">
      <view class="continue-row">
        <view class="continue-cover skeleton-bg"></view>
        <view class="continue-info">
          <view class="skeleton-bg" style="width: 60%; height: 32rpx;"></view>
          <view class="skeleton-bg" style="width: 40%; height: 24rpx; margin-top: 12rpx;"></view>
        </view>
      </view>
    </view>

    <!-- Recommendations -->
    <view class="section-header">
      <text class="section-title">为你推荐</text>
      <text class="section-link">换一批</text>
    </view>

    <scroll-view class="recommend-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="recommend-row">
        <block wx:if="{{loading}}">
          <view wx:for="{{[1,2,3]}}" wx:key="*this" class="recommend-card levitating-paper skeleton-pulse">
            <view class="recommend-cover skeleton-bg"></view>
            <view class="recommend-info">
              <view class="skeleton-bg" style="width: 80%; height: 24rpx;"></view>
              <view class="skeleton-bg" style="width: 50%; height: 20rpx; margin-top: 8rpx;"></view>
            </view>
          </view>
        </block>
        <block wx:else>
          <view
            wx:for="{{recommendBooks}}"
            wx:key="id"
            wx:if="{{index > 0}}"
            class="recommend-card levitating-paper"
            data-id="{{item.id}}"
            bindtap="handleRecommendTap"
          >
            <view class="recommend-cover">
              <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
              <view wx:else class="cover-empty-sm"><text>暂无</text></view>
            </view>
            <view class="recommend-info">
              <text class="recommend-title">{{item.title}}</text>
              <text class="recommend-author">{{item.author || '未知作者'}}</text>
            </view>
          </view>
        </block>
      </view>
    </scroll-view>

    <!-- Library -->
    <view class="section-header">
      <text class="section-title">书库</text>
      <text class="section-link">{{filteredBooks.length}} 本</text>
    </view>

    <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-row">
        <view
          wx:for="{{categories}}"
          wx:key="*this"
          class="category-chip {{activeCategory === item ? 'category-chip--active' : ''}}"
          data-value="{{item}}"
          bindtap="handleTabChange"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </scroll-view>

    <view class="library-list" wx:if="{{filteredBooks.length > 0}}">
      <book-card
        wx:for="{{filteredBooks}}"
        wx:key="id"
        book="{{item}}"
        mode="market"
        bind:cardtap="handleBookTap"
        bind:actiontap="handleActionTap"
      />
    </view>

    <empty-state
      wx:elif="{{!loading}}"
      title="暂无书籍"
      description="当前分类还没有可阅读的书籍"
    />
  </scroll-view>

  <view wx:if="{{showPrivacyModal}}" class="privacy-overlay" catchtap="handleDisagreePrivacy">
    <view class="privacy-sheet" catchtap="handleStopPropagation">
      <view class="privacy-header">
        <text class="privacy-title">{{privacyModalTitle}}</text>
      </view>
      <view class="privacy-content">
        <text class="privacy-text">{{privacyModalText}}</text>
      </view>
      <view class="privacy-actions">
        <button class="btn-secondary" bindtap="handleDisagreePrivacy">暂不同意</button>
        <button
          id="home-privacy-agree"
          class="btn-primary"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="handleAgreePrivacy"
        >同意并继续</button>
      </view>
    </view>
  </view>
</view>
