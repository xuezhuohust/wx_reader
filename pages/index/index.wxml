<view class="page-shell home-page">
  <!-- Custom Navigation Bar (Simplified) -->
  <view class="custom-nav {{scrolled ? 'nav--scrolled' : ''}}" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px; padding-left: {{menuRight}}px; padding-right: {{menuRight}}px;">
      <view class="nav-left">
        <view class="user-profile-trigger" bindtap="handleProfileTap">
          <view class="user-avatar-mini" wx:if="{{identity}}">
            <image src="{{identity.avatarUrl}}" mode="aspectFill" />
          </view>
          <view class="role-badge">{{currentRole === 'reader' ? '读者' : '出版商'}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="content-body">
    <!-- Hero Band Section -->
    <view class="hero-band" style="padding-top: {{navBarHeight + 20}}px;">
      <view class="hero-content">
        <text class="hero-title">与书对话，深度思考</text>
        <text class="hero-desc">AI 伴读，让阅读更有深度。</text>
      </view>
      <!-- Decorative Dots -->
      <view class="hero-dots"></view>
    </view>

    <!-- Search Bar in Content Area -->
    <view class="content-search-section">
      <view class="search-bar-box">
        <icon type="search" size="16" color="var(--steel)"></icon>
        <input
          class="search-input"
          placeholder="搜索书名、作者或关键词..."
          placeholder-style="color:var(--stone);"
          confirm-type="search"
          bindinput="handleKeywordInput"
          bindconfirm="handleSearch"
          value="{{searchValue}}"
        />
      </view>
    </view>

    <!-- Reader View -->
    <block wx:if="{{currentRole === 'reader'}}">
      <view class="main-content">
        <!-- Horizontal Recommendations -->
        <view class="section-container">
          <view class="section-header">
            <text class="section-title">今日推荐</text>
          </view>

          <scroll-view class="recommend-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="recommend-row">
              <view
                wx:for="{{recommendBooks}}"
                wx:key="id"
                class="recommend-card-minimal"
                data-id="{{item.id}}"
                bindtap="handleRecommendTap"
              >
                <view class="book-cover-wrapper">
                  <image class="cover-image" src="{{item.coverUrl || 'https://mp-8bdc7c18-cba4-4488-8c57-e587ac252b55.cdn.bspapp.com/fengmian.png'}}" mode="aspectFill" />
                  <view class="cover-shadow"></view>
                </view>
                <view class="book-info-minimal">
                  <text class="book-title-minimal">{{item.title}}</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>

        <!-- Library Section -->
        <view class="section-container library-section">
          <view class="section-header">
            <text class="section-title">探索库</text>
            <text class="section-more">{{filteredBooks.length}} 本藏书</text>
          </view>

          <!-- Integrated Library Tabs -->
          <scroll-view class="library-tabs-scroll" scroll-x enhanced show-scrollbar="{{false}}">
            <view class="library-tabs-row">
              <view
                wx:for="{{categories}}"
                wx:key="*this"
                class="tab-item-minimal {{activeCategory === item ? 'active' : ''}}"
                data-value="{{item}}"
                bindtap="handleTabChange"
              >
                {{item}}
              </view>
            </view>
          </scroll-view>

          <!-- Library List -->
          <view wx:if="{{filteredBooks.length}}" class="list-wrap">
            <book-card
              wx:for="{{filteredBooks}}"
              wx:key="id"
              book="{{item}}"
              mode="market"
              show-author="{{false}}"
              bind:cardtap="handleBookTap"
              bind:actiontap="handleActionTap"
            />
          </view>

          <empty-state
            wx:else
            title="暂无匹配书籍"
            description="换个关键词或分类试试看吧"
          />
        </view>
      </view>
    </block>

    <!-- Publisher View -->
    <block wx:else>
      <view class="main-content">
        <view class="section-container">
          <view class="section-header">
            <text class="section-title">工作台概览</text>
          </view>
          <view class="publisher-stats-row">
            <view class="stat-card tint-mint">
              <text class="stat-count">{{publisherStats.totalBooks || 0}}</text>
              <text class="stat-tag">管理书目</text>
            </view>
            <view class="stat-card tint-sky">
              <text class="stat-count">{{publisherStats.totalChatCount || 0}}</text>
              <text class="stat-tag">累计对话</text>
            </view>
          </view>
        </view>

        <view class="section-container">
          <view class="section-header">
            <text class="section-title">快捷操作</text>
          </view>
          <view class="publisher-actions">
            <view
              wx:for="{{publisherEntries}}"
              wx:key="title"
              class="action-card"
              data-path="{{item.path}}"
              data-type="{{item.type}}"
              bindtap="handlePublisherActionTap"
            >
              <view class="action-card-header">
                <view class="action-icon-box tint-{{index % 5}}">
                  <text class="icon-char">{{item.title[0]}}</text>
                </view>
                <view class="arrow-right"></view>
              </view>
              <view class="action-info">
                <text class="action-title">{{item.title}}</text>
                <text class="action-desc">{{item.desc}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- Permission Modal -->
  <view wx:if="{{showPermissionModal}}" class="profile-overlay" bindtap="handleClosePermission">
    <view class="profile-sheet" catchtap="handleStopPropagation">
      <view class="profile-header">
        <text class="profile-sheet-title">权限使用说明</text>
      </view>
      
      <view class="permission-content">
        <text class="permission-text">为了提供更好的 AI 阅读伴读体验，我们需要使用您的麦克风权限，以便您可以与书籍进行语音交谈。</text>
      </view>

      <button class="btn-primary" bindtap="handleClosePermission">我知道了</button>
    </view>
  </view>
</view>
