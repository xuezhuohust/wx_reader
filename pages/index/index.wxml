<view class="page-container home-page">
  <!-- Sticky Header -->
  <view class="home-nav" style="height: {{navBarHeight}}px; background-color: #faf8f5;">
    <view class="nav-header" style="position: absolute; top: {{menuTop}}px; height: {{menuHeight}}px; left: 0; right: 0; padding-right: {{menuRight}}px;">
      <view class="greeting-wrap">
        <view class="greeting-wave">{{timeGreeting}}好</view>
        <view class="greeting-name">{{identity.displayName || '读者'}}</view>
      </view>
    </view>
  </view>

  <scroll-view
    class="scroll-area"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    bindscroll="onPageScroll"
  >
    <view class="scroll-content">
      <!-- Continue Reading Section Header -->
      <view class="section-header fade-up d1" wx:if="{{recommendBooks.length > 0}}">
        <view class="section-title">继续阅读</view>
        <view class="section-link" bindtap="handleSwitchToShelf">我的书架</view>
      </view>

      <!-- AI Compact Reading Card -->
      <view class="ai-compact-card fade-up d1" wx:if="{{recommendBooks.length > 0}}" bindtap="handleRecommendTap" data-id="{{recommendBooks[0].id}}">
        <view class="ai-compact-cover">
          <image wx:if="{{recommendBooks[0].coverUrl}}" src="{{recommendBooks[0].coverUrl}}" mode="aspectFill" />
          <view class="cover-placeholder-small" wx:else>{{recommendBooks[0].title[0]}}</view>
        </view>
        <view class="ai-compact-info">
          <view class="ai-compact-header">
            <text class="ai-compact-tag">AI 导读</text>
            <text class="ai-compact-title">{{recommendBooks[0].title}}</text>
          </view>
          <view class="ai-compact-progress-row">
            <view class="ai-compact-bar-wrap">
              <view class="ai-compact-bar-fill" style="width: {{recommendBooks[0].progress || 0}}%;"></view>
            </view>
            <text class="ai-compact-pct">{{recommendBooks[0].progress || '0'}}%</text>
          </view>
        </view>
        <view class="icon-arrow-right-faint-small"></view>
      </view>

      <!-- Skeleton for AI Summary -->
      <view class="ai-summary-card skeleton-pulse" wx:elif="{{loading}}">
        <view class="skeleton-bg" style="width: 120rpx; height: 24rpx; margin-bottom: 12rpx;"></view>
        <view class="skeleton-bg" style="width: 300rpx; height: 32rpx; margin-bottom: 12rpx;"></view>
        <view class="skeleton-bg" style="width: 100%; height: 60rpx; margin-bottom: 24rpx;"></view>
        <view class="skeleton-bg" style="width: 100%; height: 64rpx; border-radius: 99rpx;"></view>
      </view>

      <!-- Today's Recommendations -->
      <view class="section-header fade-up d2" wx:if="{{recommendBooks.length > 0}}">
        <view class="section-title">今日推荐</view>
        <view class="section-link" bindtap="handleSeeMore">查看全部</view>
      </view>
      
      <scroll-view class="book-scroll fade-up d3" scroll-x enhanced show-scrollbar="{{false}}">
        <view class="book-row">
          <block wx:if="{{loading}}">
            <view wx:for="{{[1,2,3]}}" wx:key="*this" class="book-card-skeleton skeleton-pulse">
              <view class="skeleton-bg cover-placeholder"></view>
              <view class="skeleton-bg title-placeholder"></view>
            </view>
          </block>
          <block wx:else>
            <view 
              class="book-card" 
              wx:for="{{recommendBooks}}" 
              wx:key="id" 
              bindtap="handleRecommendTap"
              data-id="{{item.id}}"
            >
              <view class="book-card-cover" style="background: {{item.coverColor}};">
                <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill"></image>
                <view class="book-placeholder-inner-flat" wx:else>
                  <view class="placeholder-title-flat" style="font-size: 60rpx;">{{item.title[0]}}</view>
                </view>
              </view>
              <view class="book-card-info">
                <view class="book-card-title">{{item.title}}</view>
                <view class="book-card-meta">
                  <text>{{item.author || '读者'}}</text>
                  <text class="meta-dot" wx:if="{{item.category}}">·</text>
                  <text wx:if="{{item.category}}">{{item.category}}</text>
                </view>
              </view>
            </view>
          </block>
        </view>
      </scroll-view>

      <!-- For You (Masonry Style Library) -->
      <view class="section-header fade-up d4 section-mt">
        <view class="section-title">为你推荐</view>
        <view class="section-link" bindtap="handleRefreshRecommend">更多</view>
      </view>

      <view class="masonry-grid fade-up d5">
        <block wx:if="{{loading}}">
          <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="masonry-item-skeleton skeleton-pulse">
            <view class="skeleton-bg" style="height: {{index % 2 === 0 ? '300rpx' : '400rpx'}};"></view>
            <view class="skeleton-bg" style="width: 80%; height: 24rpx; margin-top: 12rpx;"></view>
          </view>
        </block>
        <block wx:else>
          <view 
            class="masonry-item" 
            wx:for="{{filteredBooks}}" 
            wx:key="id"
            bindtap="handleBookTap"
            data-id="{{item.id}}"
          >
            <view class="masonry-cover" style="background: {{item.coverColor || '#f3efe8'}}; height: {{item.coverHeight}}rpx;">
              <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill"></image>
              <view class="book-placeholder-inner-flat" wx:else>
                <view class="placeholder-title-flat">{{item.title[0]}}</view>
              </view>
              <view class="masonry-badge" wx:if="{{item.isAIReady}}">AI讲解</view>
            </view>
            <view class="masonry-info">
              <view class="masonry-title">{{item.title}}</view>
              <view class="masonry-meta">
                <text>{{item.author || '读者'}}</text>
                <text class="meta-dot">·</text>
                <text>{{item.rating}}分</text>
              </view>
            </view>
          </view>
        </block>
      </view>

      <view class="safe-area-bottom"></view>
    </view>
  </scroll-view>

  <!-- Privacy Modal -->
  <view wx:if="{{showPrivacyModal}}" class="privacy-overlay" catchtap="handleDisagreePrivacy">
    <view class="privacy-sheet" catchtap="handleStopPropagation">
      <view class="privacy-header">
        <text class="privacy-title">{{privacyModalTitle}}</text>
      </view>
      <view class="privacy-content">
        <text class="privacy-text">{{privacyModalText}}</text>
      </view>
      <view class="privacy-actions">
        <button class="btn-secondary" bindtap="handleDisagreePrivacy">暂不同意</button>
        <button
          id="home-privacy-agree"
          class="btn-primary"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="handleAgreePrivacy"
        >同意并继续</button>
      </view>
    </view>
  </view>
</view>
