.home-page {
  padding: 0;
  background: var(--bg-canvas);
  height: 100vh;
  overflow: hidden;
}

/* Navigation */
.custom-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: var(--bg-canvas);
}

.nav-inner {
  position: absolute;
  left: 0; right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
  font-family: "Noto Serif SC", "Source Han Serif SC", serif;
}

/* Content */
.content-body {
  padding: 0 40rpx;
  padding-bottom: calc(124rpx + env(safe-area-inset-bottom));
  height: 100vh;
  overflow-x: hidden;
}

/* Greeting */
.greeting-section {
  margin-bottom: 32rpx;
}

.greeting-title {
  display: block;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.greeting-desc {
  display: block;
  font-size: 28rpx;
  color: var(--on-surface-variant);
}

/* Stats */
.stats-row {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.stat-card {
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 8rpx;
  background-size: contain;
  background-repeat: no-repeat;
  background-position: center;
}

.stat-icon--book {
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%237fb069" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>');
}

.stat-icon--streak {
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%237fb069" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/></svg>');
}

.stat-icon--time {
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%237fb069" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>');
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
}

.stat-label {
  font-size: 22rpx;
  color: var(--on-surface-variant);
}

/* Section Header */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.section-link {
  font-size: 24rpx;
  color: var(--primary);
}

/* Continue Reading Card */
.continue-card {
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.continue-row {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.continue-cover {
  width: 160rpx;
  height: 224rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  flex-shrink: 0;
  background: var(--bg-surface);
}

.continue-cover image {
  width: 100%;
  height: 100%;
}

.cover-empty-sm {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  background: var(--bg-surface);
}

.continue-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 4rpx 0;
  overflow: hidden;
}

.continue-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.continue-author {
  font-size: 24rpx;
  color: var(--on-surface-variant);
  margin-top: 4rpx;
}

.continue-meta {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  align-items: center;
  margin-top: 8rpx;
}

.continue-category {
  display: inline-block;
  font-size: 20rpx;
  color: var(--primary);
  background: rgba(127, 176, 105, 0.12);
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  font-weight: 500;
}

.continue-desc {
  font-size: 22rpx;
  color: var(--on-surface-variant);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-top: 8rpx;
}

/* AI Summary */
.ai-summary-box {
  background: var(--surface-container-low);
  border: 1rpx solid rgba(127, 176, 105, 0.2);
  border-radius: var(--radius-md);
  padding: 20rpx;
  margin-bottom: 20rpx;
}

.ai-summary-label {
  display: block;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 8rpx;
  letter-spacing: 1rpx;
}

.ai-summary-text {
  font-size: 22rpx;
  color: var(--on-surface-variant);
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.continue-btn {
  background: var(--primary-container);
  color: var(--on-primary);
  font-size: 28rpx;
  font-weight: 700;
  padding: 24rpx;
  border-radius: var(--radius-md);
  text-align: center;
}

.continue-btn:active {
  background: var(--primary);
  transform: scale(0.98);
}

/* Recommendations */
.recommend-scroll {
  margin: 0 -40rpx;
  width: calc(100% + 80rpx);
  margin-bottom: 48rpx;
}

.recommend-row {
  display: flex;
  padding: 8rpx 40rpx 24rpx;
  gap: 24rpx;
}

.recommend-card {
  width: 280rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.recommend-cover {
  width: 100%;
  height: 360rpx;
  overflow: hidden;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: var(--bg-surface);
}

.recommend-cover image {
  width: 100%;
  height: 100%;
}

.recommend-info {
  padding: 16rpx 20rpx 20rpx;
}

.recommend-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 4rpx;
}

.recommend-author {
  font-size: 20rpx;
  color: var(--on-surface-variant);
}

/* Library */
.category-scroll {
  margin: 0 -40rpx 24rpx;
  width: calc(100% + 80rpx);
}

.category-row {
  display: flex;
  gap: 16rpx;
  padding: 0 40rpx 8rpx;
}

.category-chip {
  flex-shrink: 0;
  min-width: 96rpx;
  padding: 14rpx 24rpx;
  border: 1rpx solid rgba(40, 64, 48, 0.12);
  border-radius: var(--radius-full);
  background: var(--surface-container-low);
  color: var(--on-surface-variant);
  font-size: 24rpx;
  text-align: center;
}

.category-chip--active {
  background: var(--primary-container);
  border-color: var(--primary-container);
  color: var(--on-primary);
  font-weight: 700;
}

.library-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 24rpx;
}

.privacy-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 3000;
  background: rgba(25, 28, 29, 0.42);
  display: flex;
  align-items: flex-end;
}

.privacy-sheet {
  width: 100%;
  background: var(--surface-lowest);
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  padding: 36rpx 40rpx calc(44rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -16rpx 48rpx rgba(25, 28, 29, 0.16);
}

.privacy-header {
  margin-bottom: 18rpx;
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--ink);
}

.privacy-content {
  margin-bottom: 32rpx;
}

.privacy-text {
  font-size: 27rpx;
  line-height: 1.7;
  color: var(--on-surface-variant);
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
}

.privacy-actions button {
  flex: 1;
}
