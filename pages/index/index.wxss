.home-page {
  background-color: #faf8f5;
  color: #1b1b1b;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Hero Header Section */
.home-hero-header {
  position: relative;
  width: 100%;
  min-height: 560rpx; /* 增加总高度，为底部留出更多空间 */
  overflow: hidden;
  background-color: #faf8f5;
}

.hero-bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%; /* 背景图铺满，配合长渐变实现渐入效果 */
  z-index: 0;
  transform: scale(1);
  filter: none;
  opacity: 0.9;
}

.hero-glass-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, 
    rgba(250, 248, 245, 0.05) 0%, 
    rgba(250, 248, 245, 0.1) 40%, 
    rgba(250, 248, 245, 0.6) 70%, /* 延长渐变区间 */
    rgba(250, 248, 245, 0.9) 85%,
    #faf8f5 100%
  );
  z-index: 1;
}

.hero-body {
  position: relative;
  z-index: 2;
  padding: 0 40rpx 100rpx; /* 增加底部内边距，让模块下方露出更多背景图 */
}

.hero-top-nav {
  margin-bottom: 72rpx;
}

.greeting-group {
  display: flex;
  flex-direction: column;
}

.greeting-time {
  font-size: 24rpx;
  color: #8c8c8c;
  font-weight: 500;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.greeting-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.app-title {
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: -1.5rpx;
  color: #1b1b1b;
}

.shelf-pill {
  font-size: 24rpx;
  font-weight: 700;
  color: #3c692b;
  background-color: rgba(60, 105, 43, 0.08);
  padding: 10rpx 24rpx;
  border-radius: 99rpx;
  transition: all 0.2s;
}

.shelf-pill:active {
  transform: scale(0.95);
  background-color: rgba(60, 105, 43, 0.15);
}

/* Stripped-out Reading Entry */
.hero-reading-entry {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  background: transparent;
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  border-radius: 0;
  border: none;
  box-shadow: none;
  transition: all 0.2s ease;
  margin-top: 0; /* 移除负边距，配合上面的 margin-bottom 实现更宽的间距 */
}

.hero-reading-entry:active {
  opacity: 0.7;
  transform: translateX(4rpx); /* 点击时轻微向右滑动，而非缩放 */
}

.entry-cover-box {
  width: 90rpx;
  height: 126rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 32rpx;
  background-color: #f3efe8;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08); /* 封面保留投影，增加立体感 */
}

.entry-cover-box image {
  width: 100%;
  height: 100%;
}

.entry-main-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.entry-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.entry-tag {
  font-size: 18rpx;
  font-weight: 800;
  color: #3c692b;
  letter-spacing: 2rpx;
  opacity: 0.8;
}

.entry-pct {
  font-size: 22rpx;
  font-weight: 900;
  color: #3c692b;
  font-family: 'DIN Alternate', sans-serif;
  opacity: 0.9;
}

.entry-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.entry-book-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1b1b1b;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.entry-arrow-icon {
  width: 10rpx;
  height: 10rpx;
  border-top: 3rpx solid #3c692b;
  border-right: 3rpx solid #3c692b;
  transform: rotate(45deg);
  opacity: 0.4;
  margin-left: 12rpx;
}

.entry-progress-bar {
  height: 4rpx; /* 更细的线条 */
  background-color: rgba(60, 105, 43, 0.08);
  border-radius: 99rpx;
  overflow: hidden;
  width: 100%;
}

.entry-progress-fill {
  height: 100%;
  background-color: #3c692b;
  border-radius: 99rpx;
}

/* Main Sections Container */
.main-sections {
  padding: 0 40rpx;
  position: relative;
  z-index: 3;
}

.no-padding-top {
  padding-top: 0 !important;
}

.scroll-content {
  padding: 40rpx 0 48rpx; /* Horizontal padding moved to main-sections */
}

/* Header (Removed old styles) */
.home-nav {
  display: none;
}

.greeting-wrap, .greeting-wave, .greeting-name {
  display: none;
}

.cover-placeholder-small {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 900;
  color: #8c8c8c;
  opacity: 0.3;
}

.icon-arrow-right-faint-small {
  width: 12rpx;
  height: 12rpx;
  border-top: 3.5rpx solid #ccc;
  border-right: 3.5rpx solid #ccc;
  transform: rotate(45deg);
  opacity: 0.6;
}

/* Section Header */
.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.section-mt {
  margin-top: 48rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #1b1b1b;
  letter-spacing: -0.6rpx;
}

.section-link {
  font-size: 26rpx;
  font-weight: 700;
  color: #3c692b;
}

/* Book Scroll */
.book-scroll {
  margin: 0 -40rpx;
  width: calc(100% + 80rpx);
}

.book-row {
  display: flex;
  gap: 24rpx;
  padding: 0 40rpx 16rpx;
}

.book-card {
  width: 240rpx;
  flex-shrink: 0;
  transition: all 0.2s;
}

.book-card:active {
  opacity: 0.7;
  transform: translateY(2rpx);
}

.book-card-cover {
  width: 100%;
  height: 336rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.book-placeholder-inner {
  width: 100%;
  height: 100%;
  display: flex;
  position: relative;
}

.book-spine {
  width: 12rpx;
  height: 100%;
  background: rgba(0, 0, 0, 0.08);
  border-right: 1rpx solid rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.book-content-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  position: relative;
}

.placeholder-title {
  font-size: 68rpx;
  font-weight: 900;
  color: #1b1b1b;
  font-family: "Noto Serif SC", serif;
  opacity: 0.8;
  line-height: 1;
}

.placeholder-author {
  font-size: 20rpx;
  color: #1b1b1b;
  opacity: 0.4;
  margin-top: 16rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.placeholder-line {
  width: 32rpx;
  height: 2rpx;
  background-color: #1b1b1b;
  margin-top: 24rpx;
  border-radius: 2rpx;
  opacity: 0.2;
}

.book-card-cover image {
  width: 100%;
  height: 100%;
}

.book-card-info {
  padding: 20rpx 0 0; /* 增加与封面的间距 */
}

.book-card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1b1b1b;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.book-card-meta, .masonry-meta {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
}

.meta-dot {
  margin: 0 8rpx;
  opacity: 0.5;
}

/* Masonry Grid */
.masonry-grid {
  column-count: 2;
  column-gap: 24rpx;
  margin-top: 12rpx;
  width: 100%;
}

.masonry-item {
  break-inside: avoid;
  transition: all 0.2s;
  margin-bottom: 24rpx;
  width: 100%;
  display: inline-block;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.masonry-item:active {
  transform: scale(0.97);
}

.masonry-item-skeleton {
  break-inside: avoid;
  display: inline-block;
  width: 100%;
  margin-bottom: 24rpx;
  background-color: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  padding-bottom: 20rpx;
}

.skeleton-pulse {
  animation: skeleton-pulse 1.5s ease-in-out infinite;
}

.skeleton-bg {
  background-color: rgba(0, 0, 0, 0.05);
  border-radius: 4rpx;
}

@keyframes skeleton-pulse {
  0% { opacity: 0.6; }
  50% { opacity: 1; }
  100% { opacity: 0.6; }
}

.masonry-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.masonry-cover image {
  width: 100%;
  height: 100%;
}

.masonry-badge {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  font-size: 18rpx;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  padding: 6rpx 16rpx;
  border-radius: 99rpx;
  background-color: #3c692b;
  color: #fff;
}

.masonry-info {
  padding: 20rpx 24rpx;
}

.book-placeholder-inner-flat {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  opacity: 0.2;
}

.placeholder-title-flat {
  font-size: 80rpx;
  font-weight: 900;
  color: #1b1b1b;
}

.masonry-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1b1b1b;
  letter-spacing: -0.4rpx;
  line-height: 1.4;
}

/* Icons (CSS implementations) */
.icon-search, .icon-bell, .icon-arrow-right, .icon-book-small, .icon-book-placeholder, .icon-book-placeholder-light {
  position: relative;
}

.icon-search::before {
  content: '';
  width: 24rpx;
  height: 24rpx;
  border: 4rpx solid #1b1b1b;
  border-radius: 50%;
  position: absolute;
  top: -16rpx;
  left: -16rpx;
}
.icon-search::after {
  content: '';
  width: 12rpx;
  height: 4rpx;
  background-color: #1b1b1b;
  position: absolute;
  top: 8rpx;
  left: 4rpx;
  transform: rotate(45deg);
}

.icon-bell::before {
  content: '';
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid #1b1b1b;
  border-radius: 14rpx 14rpx 0 0;
  position: absolute;
  top: -18rpx;
  left: -16rpx;
}
.icon-bell::after {
  content: '';
  width: 8rpx;
  height: 4rpx;
  background-color: #1b1b1b;
  position: absolute;
  bottom: -20rpx;
  left: -4rpx;
  border-radius: 0 0 4rpx 4rpx;
}

.icon-book-small {
  width: 24rpx;
  height: 32rpx;
  border: 3rpx solid #3c692b;
  border-radius: 4rpx;
}

.icon-arrow-right::after {
  content: '';
  width: 14rpx;
  height: 14rpx;
  border-top: 4rpx solid #3c692b;
  border-right: 4rpx solid #3c692b;
  position: absolute;
  top: -7rpx;
  right: 0;
  transform: rotate(45deg);
}

.icon-book-placeholder {
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid rgba(0,0,0,0.15);
  border-radius: 8rpx;
  opacity: 0.3;
}

.icon-book-placeholder-light {
  width: 64rpx;
  height: 64rpx;
  border: 3rpx solid rgba(255,255,255,0.5);
  border-radius: 8rpx;
  opacity: 0.4;
}

/* Animations */
.fade-up {
  animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.d1 { animation-delay: 0ms; }
.d2 { animation-delay: 80ms; }
.d3 { animation-delay: 160ms; }
.d4 { animation-delay: 240ms; }
.d5 { animation-delay: 320ms; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Privacy */
.privacy-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 3000;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: flex-end;
}

.privacy-sheet {
  width: 100%;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 40rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}

.privacy-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #1b1b1b;
}

.privacy-content {
  margin: 24rpx 0 40rpx;
}

.privacy-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #4a4a4a;
}

.privacy-actions {
  display: flex;
  gap: 24rpx;
}

.btn-secondary {
  flex: 1;
  background: #f3efe8;
  color: #1b1b1b;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
}

.btn-primary {
  flex: 1;
  background: #1b1b1b;
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 24rpx;
  border: none;
}

.safe-area-bottom {
  height: calc(140rpx + env(safe-area-inset-bottom));
}
