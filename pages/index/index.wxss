.home-page {
  padding: 0;
  background: var(--bg-canvas);
}

/* Custom Navigation Bar - Simplified */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: transparent;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
}

.nav--scrolled {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid var(--hairline-soft);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
}

.nav-inner {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
}

.nav-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 0 40rpx;
}

.user-profile-trigger {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: rgba(255, 255, 255, 0.1);
  padding: 6rpx 16rpx 6rpx 6rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid rgba(255, 255, 255, 0.15);
}

.nav--scrolled .user-profile-trigger {
  background: var(--bg-surface-soft);
  border-color: var(--hairline);
}

.user-avatar-mini {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-full);
  overflow: hidden;
  background: rgba(255, 255, 255, 0.1);
}

.role-badge {
  font-size: 20rpx;
  color: #fff;
  font-weight: 600;
  opacity: 0.8;
}

.nav--scrolled .role-badge {
  color: var(--slate);
}

.role-switch-btn {
  background: var(--notion-primary);
  padding: 12rpx 28rpx;
  border-radius: var(--radius-md);
  font-size: 22rpx;
  color: #ffffff;
  font-weight: 700;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.role-switch-btn:active {
  transform: scale(0.92);
  filter: brightness(1.2);
}

.switch-icon {
  width: 24rpx;
  height: 24rpx;
  border: 3rpx solid #fff;
  border-radius: 50%;
  border-right-color: transparent;
  transform: rotate(-45deg);
}

.nav--scrolled .role-switch-btn {
  box-shadow: 0 4rpx 12rpx rgba(19, 30, 56, 0.2);
}

/* Hero Band - Refined */
.hero-band {
  background: linear-gradient(180deg, var(--notion-brand-navy) 0%, #15203b 100%);
  color: #ffffff;
  padding: 40rpx 48rpx 140rpx;
  position: relative;
  overflow: hidden;
  text-align: center;
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero-title {
  font-size: 68rpx;
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 24rpx;
  letter-spacing: -0.03em;
  background: linear-gradient(180deg, #ffffff 0%, rgba(255, 255, 255, 0.8) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  display: block;
}

.hero-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.5);
  line-height: 1.6;
  max-width: 85%;
  margin: 0 auto;
  display: block;
}

.hero-dots {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1.5rpx, transparent 1.5rpx);
  background-size: 48rpx 48rpx;
  opacity: 0.6;
}

/* Content Search Section */
.content-search-section {
  padding: 0 40rpx;
  margin-top: -44rpx;
  position: relative;
  z-index: 10;
}

.search-bar-box {
  background: #ffffff;
  height: 96rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  padding: 0 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid var(--hairline-soft);
  transition: all 0.3s;
}

.search-bar-box:active {
  transform: translateY(-2rpx);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.12);
}

.search-input {
  flex: 1;
  margin-left: 24rpx;
  font-size: 30rpx;
  color: var(--ink);
}

/* Main Content Layout */
.main-content {
  padding: 60rpx 0;
  animation: slideUp 0.6s ease-out;
}

.section-container {
  margin-bottom: 48rpx;
}

.section-header {
  padding: 0 40rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: -0.01em;
  position: relative;
}

.section-more {
  font-size: 26rpx;
  color: var(--stone);
  font-weight: 500;
}

/* Recommendation Cards - Minimalist */
.recommend-scroll {
  width: 100%;
}

.recommend-row {
  display: flex;
  padding: 0 40rpx 10rpx;
  gap: 32rpx;
}

.recommend-card-minimal {
  width: 220rpx;
  flex-shrink: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.recommend-card-minimal:active {
  transform: scale(0.96) translateY(4rpx);
}

.book-cover-wrapper {
  width: 220rpx;
  height: 308rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.1);
  background: var(--bg-surface);
}

.book-cover-wrapper .cover-image {
  width: 100%;
  height: 100%;
}

.cover-shadow {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  box-shadow: inset 0 0 40rpx rgba(0,0,0,0.06);
  pointer-events: none;
}

.book-info-minimal {
  margin-top: 16rpx;
}

.book-title-minimal {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  height: auto;
  min-height: 40rpx;
  max-height: 80rpx;
}

.book-author-minimal {
  font-size: 24rpx;
  color: var(--stone);
  margin-top: 10rpx;
  display: block;
}

/* Library Section & Tabs */
.library-section {
  background: var(--bg-canvas);
  padding: 12rpx 0 40rpx;
}

.library-tabs-scroll {
  margin-bottom: 32rpx;
}

.library-tabs-row {
  display: flex;
  padding: 0 40rpx;
  gap: 16rpx;
}

.tab-item-minimal {
  padding: 14rpx 36rpx;
  font-size: 28rpx;
  color: var(--slate);
  background: #ffffff;
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-full);
  white-space: nowrap;
  transition: all 0.2s ease;
}

.tab-item-minimal.active {
  background: var(--notion-primary);
  color: #ffffff;
  border-color: var(--notion-primary);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(19, 30, 56, 0.15);
}

.list-wrap {
  padding: 0 40rpx;
}

/* Publisher View - Quick Sync */
.publisher-stats-row {
  display: flex;
  padding: 0 40rpx;
  gap: 32rpx;
  margin-bottom: 48rpx;
}

.stat-card {
  flex: 1;
  padding: 48rpx 32rpx;
  background: #ffffff;
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-xl);
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.stat-count {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--ink);
  display: block;
  letter-spacing: -0.02em;
}

.stat-tag {
  font-size: 24rpx;
  color: var(--slate);
  margin-top: 12rpx;
  font-weight: 500;
}

.publisher-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding: 0 40rpx;
  gap: 32rpx;
}

.action-card {
  background: #ffffff;
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-xl);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  transition: all 0.3s ease;
}

.action-card:active {
  transform: translateY(4rpx);
  background: var(--bg-surface-soft);
}

.action-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.action-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-char {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}

.arrow-right {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid var(--stone);
  border-right: 3rpx solid var(--stone);
  transform: rotate(45deg);
  opacity: 0.5;
}

.action-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.action-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.action-desc {
  font-size: 24rpx;
  color: var(--stone);
  line-height: 1.5;
}

/* Modals */
.profile-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8px);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
}

.profile-sheet {
  width: 100%;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 60rpx 48rpx calc(80rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.profile-header {
  margin-bottom: 32rpx;
}

.profile-sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}

.permission-content {
  margin-bottom: 56rpx;
}

.permission-text {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--steel);
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

/* Search Results Drawer */
.drawer-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(4px);
  z-index: 9000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
  display: flex;
  align-items: flex-end;
}

.drawer--show {
  visibility: visible;
  opacity: 1;
}

.drawer-content {
  width: 100%;
  height: 80vh;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 20rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  display: flex;
  flex-direction: column;
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.1);
}

.drawer--show .drawer-content {
  transform: translateY(0);
}

.drawer-handle {
  width: 60rpx;
  height: 8rpx;
  background: var(--hairline);
  border-radius: var(--radius-full);
  margin: 0 auto 32rpx;
  flex-shrink: 0;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 40rpx;
  flex-shrink: 0;
}

.drawer-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
}

.drawer-count {
  font-size: 24rpx;
  color: var(--stone);
  font-weight: 600;
}

.drawer-scroll {
  flex: 1;
  min-height: 0;
}

.drawer-list {
  display: flex;
  flex-direction: column;
  padding-bottom: 40rpx;
}

.drawer-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 120rpx;
  gap: 24rpx;
  color: var(--stone);
  font-size: 28rpx;
}
