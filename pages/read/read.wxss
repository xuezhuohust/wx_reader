.toc-sheet-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 1100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  backdrop-filter: blur(4px);
}

.toc-sheet-overlay.show {
  opacity: 1;
  visibility: visible;
}

.toc-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #fff;
  z-index: 1200;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  transform: translateY(100%);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  max-height: 75vh;
  display: flex;
  flex-direction: column;
}

.toc-sheet.show {
  transform: translateY(0);
}

.toc-header {
  padding: 20rpx 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.toc-handle {
  width: 64rpx;
  height: 8rpx;
  background-color: #f0f0f0;
  border-radius: 4rpx;
  margin-bottom: 24rpx;
}

.toc-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1b1b1b;
  margin-bottom: 8rpx;
}

.toc-subtitle {
  font-size: 22rpx;
  color: #bfbfbf;
  font-weight: 600;
}

.toc-list {
  flex: 1;
  overflow: hidden;
}

.toc-item {
  display: flex;
  align-items: center;
  padding: 36rpx 48rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.02);
  transition: background-color 0.2s;
}

.toc-item:active {
  background-color: #f9f9f9;
}

.toc-item.active {
  background-color: rgba(60, 105, 43, 0.03);
}

.toc-index {
  font-size: 24rpx;
  font-weight: 900;
  color: #e0e0e0;
  width: 60rpx;
  flex-shrink: 0;
}

.toc-item.active .toc-index {
  color: #3c692b;
}

.toc-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #4a4a4a;
  flex: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.toc-item.active .toc-name {
  color: #1b1b1b;
  font-weight: 800;
}

.toc-active-icon {
  width: 12rpx;
  height: 12rpx;
  background-color: #3c692b;
  border-radius: 50%;
  margin-left: 16rpx;
  box-shadow: 0 0 12rpx rgba(60, 105, 43, 0.4);
}

/* Animations */
@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.float-anim {
  animation: float 4s ease-in-out infinite;
}

.fade-up {
  animation: fadeUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) both;
}

.chapter-end-hint {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0 40rpx;
  color: #bfbfbf;
  font-size: 24rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
