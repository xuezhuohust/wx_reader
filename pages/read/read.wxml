<view class="reader-page {{isLandscapeReader ? 'reader-page--landscape' : ''}} {{isPadPortraitReader ? 'reader-page--pad-portrait' : ''}}" wx:if="{{book}}">
  <!-- AI 入口不挂在顶部导航上：阅读时始终可见，也不会落到状态栏或被 swiper 截获。 -->
  <view
    wx:if="{{!isLandscapeReader && !showTocSheet && !showSelectionMenu}}"
    class="reader-ai-fab {{showFooterBar ? 'reader-ai-fab--above-footer' : ''}}"
    catchtap="handleStartAI"
  >
    <view class="icon-ai-sparkle reader-ai-fab-icon"></view>
    <text>AI QA</text>
  </view>

  <!-- Custom Navigation Bar -->
  <view wx:if="{{!isLandscapeReader}}" class="reader-header {{showControls ? 'fade-in' : 'hidden'}}" style="height: {{navBarHeight}}px; padding-top: {{menuTop}}px;">
    <view class="nav-inner" style="height: {{menuHeight}}px; position: relative;">
      <view class="nav-left" bindtap="handleBack">
        <view class="icon-back"></view>
      </view>
      <view class="nav-center" style="position: absolute; left: 50%; transform: translateX(-50%); width: 40%; height: 100%;">
        <view class="reader-chapter-title {{currentChapterName.length > 10 ? 'should-marquee' : ''}}">
          <text>{{currentChapterName || 'Loading...'}}</text>
          <text wx:if="{{currentChapterName.length > 10}}" class="marquee-copy">{{currentChapterName}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Pad 横屏工作区：原文和伴读对话并列，两个区域独立滚动。 -->
  <view wx:if="{{isLandscapeReader}}" class="reader-workspace">
    <view class="reader-source-pane">
      <view class="reader-pane-header reader-source-header">
        <view class="reader-pane-back" bindtap="handleBack">
          <view class="icon-back"></view>
        </view>
        <view class="reader-pane-heading">
          <text class="reader-pane-title">{{currentChapterName || 'Loading...'}}</text>
        </view>
      </view>

      <view wx:if="{{loading}}" class="reader-source-loading">Loading manuscript...</view>
      <swiper
        wx:else
        class="reader-source-swiper"
        current="{{currentPageIndex}}"
        bindchange="onPageChange"
        duration="{{swiperDuration}}"
        disable-touch="{{true}}"
      >
        <swiper-item wx:for="{{chapterPages}}" wx:key="index" wx:for-index="pageIdx">
          <view class="reader-source-page-content">
            <view class="reader-article" wx:if="{{item.type === 'content'}}">
              <view
                wx:for="{{item.content}}"
                wx:for-item="paraObj"
                wx:for-index="paraIdx"
                wx:key="paraIdx"
                class="paragraph {{paraObj.text && selectedParaText === paraObj.text ? 'para-selected' : ''}} {{paraObj.isSplitTop ? 'is-split-top' : ''}} {{paraObj.isSplitBottom ? 'is-split-bottom' : ''}} {{paraObj.isBlank ? 'is-blank-line' : ''}} {{paraObj.isDivider ? 'is-divider-line' : ''}}"
                bindlongpress="handleLongPressPara"
                data-text="{{paraObj.text}}"
              >{{paraObj.text}}</view>
              <view class="chapter-end-hint" wx:if="{{item.showChapterEnd}}">
                <text>— End of Section —</text>
              </view>
            </view>
            <view class="reader-bridge-page" wx:else>
              <view class="bridge-loader">
                <view class="loading-dots">
                  <view class="dot"></view>
                  <view class="dot"></view>
                  <view class="dot"></view>
                </view>
                <text class="bridge-text">{{item.text}}</text>
              </view>
            </view>
            <view class="reader-source-turn-zone reader-source-turn-zone--prev" catchtap="handleLandscapePrevPage"></view>
            <view class="reader-source-turn-zone reader-source-turn-zone--next" catchtap="handleLandscapeNextPage"></view>
          </view>
        </swiper-item>
      </swiper>

      <view class="reader-source-footer">
        <view class="reader-source-nav {{currentChapterIndex <= 0 ? 'is-disabled' : ''}}" bindtap="handlePrevChapter">Prev</view>
        <text>Section {{readingProgress}}%</text>
        <view class="reader-source-nav {{currentChapterIndex >= totalChapters - 1 ? 'is-disabled' : ''}}" bindtap="handleNextChapter">Next</view>
      </view>
    </view>

    <view class="reader-chat-pane">
      <book-chat
        wx:if="{{readerChatReady}}"
        class="reader-chat-component"
        book-id="{{bookId}}"
        book-title="{{book.title}}"
        entry="{{readerChatEntry}}"
        scene="{{readerChatScene}}"
        source-chapter-id="{{allChapters[currentChapterIndex] ? allChapters[currentChapterIndex].id : ''}}"
        source-chapter-title="{{currentChapterName}}"
        embedded="{{true}}"
        large-screen="{{isLandscapeReader}}"
        bind:modechange="handleReaderChatModeChange"
      />
      <view wx:else class="reader-chat-loading">Assistant initializing...</view>
    </view>
  </view>

  <!-- 手机和 Pad 竖屏：都使用左右点击翻页。 -->
  <swiper 
    wx:if="{{!isLandscapeReader}}"
    class="reader-swiper" 
    current="{{currentPageIndex}}"
    bindchange="onPageChange"
    bindtap="handleScreenTap"
    duration="{{swiperDuration}}"
  >
    <swiper-item wx:for="{{chapterPages}}" wx:key="index" wx:for-index="pageIdx">
      <view class="reader-page-content" style="padding-top: {{navBarHeight + 8}}px;">
        <!-- 正文页渲染 -->
        <view class="reader-article {{loading ? 'loading-fade' : ''}}" wx:if="{{item.type === 'content'}}">
          
          <block wx:if="{{item.content.length > 0}}">
            <view 
              wx:for="{{item.content}}" 
              wx:for-item="paraObj"
              wx:for-index="paraIdx"
              wx:key="paraIdx" 
              class="paragraph {{paraObj.text && selectedParaText === paraObj.text ? 'para-selected' : ''}} {{paraObj.isSplitTop ? 'is-split-top' : ''}} {{paraObj.isSplitBottom ? 'is-split-bottom' : ''}} {{paraObj.isBlank ? 'is-blank-line' : ''}} {{paraObj.isDivider ? 'is-divider-line' : ''}}"
              bindlongpress="handleLongPressPara"
              data-text="{{paraObj.text}}"
            >
              {{paraObj.text}}
            </view>
          </block>
          
          <!-- 仅在最后一页正文显示本章完 -->
          <view class="chapter-end-hint" wx:if="{{item.showChapterEnd && !loading}}">
            <text>— 本章完 —</text>
          </view>
        </view>

        <!-- 跨章桥接页渲染 -->
        <view class="reader-bridge-page" wx:else>
          <view class="bridge-loader">
            <view class="loading-dots">
              <view class="dot"></view>
              <view class="dot"></view>
              <view class="dot"></view>
            </view>
            <text class="bridge-text">{{item.text}}</text>
          </view>
        </view>
        
      </view>
    </swiper-item>
  </swiper>

  <!-- Reader Footer -->
  <view class="reader-footer fade-up" wx:if="{{showFooterBar && !isLandscapeReader}}">
    <view class="footer-actions">
      <view class="footer-btn-wrap {{currentChapterIndex <= 0 ? 'btn--disabled' : ''}}" bindtap="handlePrevChapter">
        <view class="footer-btn">
          <view class="icon-chapter-prev"></view>
        </view>
        <text class="btn-label">Previous</text>
      </view>
      
      <view class="footer-nav-center" bindtap="handleShowToc">
        <view class="nav-info-cluster">
          <view class="nav-chapter-name">
            <view class="nav-chapter-name-track {{currentChapterName.length > 10 ? 'should-marquee' : ''}}">
              <text>{{currentChapterName}}</text>
              <text wx:if="{{currentChapterName.length > 10}}" class="marquee-copy">{{currentChapterName}}</text>
            </view>
          </view>
          <view class="nav-progress-meta">
            <text class="progress-pct">Section {{readingProgress}}%</text>
            <text class="progress-sep">·</text>
            <text class="progress-chapter">Chapter {{currentChapterIndex + 1}} of {{totalChapters}}</text>
          </view>
        </view>
      </view>

      <view class="footer-btn-wrap {{currentChapterIndex >= totalChapters - 1 ? 'btn--disabled' : ''}}" bindtap="handleNextChapter">
        <text class="btn-label">Next</text>
        <view class="footer-btn">
          <view class="icon-chapter-next"></view>
        </view>
      </view>
    </view>
  </view>

  <!-- Custom TOC Bottom Sheet -->
  <view wx:if="{{showTocSheet}}" class="toc-sheet-overlay show" bindtap="handleHideToc"></view>
  <view wx:if="{{showTocSheet}}" class="toc-sheet show">
    <view class="toc-header">
      <view class="toc-handle"></view>
      <view class="toc-title">Contents</view>
      <view class="toc-subtitle">Total {{totalChapters}} Chapters</view>
    </view>
    <scroll-view class="toc-list" scroll-y scroll-into-view="chapter-{{currentChapterIndex}}">
      <view 
        wx:for="{{allChapterNames}}" 
        wx:key="index" 
        id="chapter-{{index}}"
        class="toc-item {{index === currentChapterIndex ? 'active' : ''}}"
        data-index="{{index}}"
        bindtap="handleSelectChapter"
      >
        <text class="toc-index">{{index + 1}}</text>
        <text class="toc-name">{{item}}</text>
        <view class="toc-active-icon" wx:if="{{index === currentChapterIndex}}"></view>
      </view>
    </scroll-view>
  </view>

  <!-- Floating Selection Menu -->
  <view class="selection-menu-overlay {{showSelectionMenu ? 'show' : ''}}" bindtap="handleCloseSelectionMenu">
    <view class="selection-menu" catchtap="nop">
      <view class="menu-item" bindtap="handleMenuAI">
        <view class="menu-icon icon-ai-sparkle-white"></view>
        <text>Explain</text>
      </view>
      <view class="menu-item" bindtap="handleMenuCopy">
        <view class="menu-icon icon-copy"></view>
        <text>Copy</text>
      </view>
      <view class="menu-item" bindtap="handleMenuHighlight">
        <view class="menu-icon icon-highlight"></view>
        <text>Highlight</text>
      </view>
      <view class="menu-item" bindtap="handleMenuShare">
        <view class="menu-icon icon-share"></view>
        <text>Share</text>
      </view>
    </view>
  </view>
</view>
