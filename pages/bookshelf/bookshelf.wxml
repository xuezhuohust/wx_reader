<view class="page-shell bookshelf-page">
  <!-- Navigation -->
  <view class="custom-nav" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px; padding-left: 40rpx; padding-right: 40rpx;">
      <text class="nav-title">书库</text>
    </view>
  </view>

  <view class="content-body" style="padding-top: {{navBarHeight + 16}}px;">
    <!-- Search -->
    <view class="search-bar">
      <input
        class="search-input"
        placeholder="搜索书名或作者"
        placeholder-style="color: var(--stone); font-size: 26rpx;"
        bindinput="handleSearchInput"
        value="{{searchValue}}"
      />
    </view>

    <!-- Book Grid -->
    <view class="book-grid" wx:if="{{books.length > 0}}">
      <view
        wx:for="{{books}}"
        wx:key="id"
        class="book-grid-item"
        data-book="{{item}}"
        bindtap="handleBookTap"
      >
        <view class="grid-cover">
          <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" />
          <view wx:else class="grid-cover-empty"><text>暂无封面</text></view>
          <view class="ai-ready-tag">
            <text>AI-Ready</text>
          </view>
        </view>
        <text class="grid-book-title">{{item.title}}</text>
        <text class="grid-book-author">{{item.author || '未知作者'}}</text>
      </view>
    </view>

    <!-- Loading -->
    <view class="book-grid" wx:elif="{{loading}}">
      <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="book-grid-item skeleton-pulse">
        <view class="grid-cover skeleton-bg"></view>
        <view class="skeleton-bg" style="width: 70%; height: 28rpx; margin-top: 12rpx;"></view>
        <view class="skeleton-bg" style="width: 50%; height: 22rpx; margin-top: 8rpx;"></view>
      </view>
    </view>

    <!-- Empty -->
    <view wx:elif="{{!loading}}" class="empty-state">
      <text class="empty-icon">书</text>
      <text class="empty-title">书架空空如也</text>
      <text class="empty-desc">快去探索库看看吧</text>
      <view class="btn-primary" bindtap="handleExplore">
        <text>前往探索</text>
      </view>
    </view>
  </view>

  <!-- FAB -->
  <view class="fab-btn" bindtap="handleExplore">
    <text class="fab-icon">+</text>
    <text class="fab-text">探索</text>
  </view>
</view>
