<view class="page-shell bookshelf-page">
  <view class="content-body">
    <!-- Hero Band Section -->
    <view class="hero-band" style="padding-top: {{statusBarHeight + 20}}px;">
      <view class="hero-content">
        <!-- Stats moved to top-left -->
        <view class="hero-stats-minimal">
          <view class="stat-item">
            <text class="stat-num">{{books.length}}</text>
            <text class="stat-lab">藏书</text>
          </view>
          <view class="stat-dot"></view>
          <view class="stat-item">
            <text class="stat-num">3</text>
            <text class="stat-lab">阅读天数</text>
          </view>
        </view>

        <text class="hero-title">我的书架</text>

        <!-- Refined: Recently Read Quick Access (Integrated look) -->
        <view wx:if="{{books.length > 0}}" class="recent-resume-card" bindtap="handleBookTap" data-book="{{books[0]}}">
          <view class="resume-content">
            <view class="resume-cover-box">
              <image class="resume-cover" src="{{books[0].coverUrl}}" mode="aspectFill" />
              <view class="resume-play-tag">
                <view class="play-icon-mini-white"></view>
              </view>
            </view>
            <view class="resume-info">
              <view class="resume-tag">继续阅读</view>
              <text class="resume-title">{{books[0].title}}</text>
              <text class="resume-progress">上次读到：第 12 页</text>
            </view>
            <view class="resume-arrow"></view>
          </view>
        </view>
      </view>
      <!-- Decorative Elements -->
      <view class="hero-dots"></view>
      <view class="hero-glow"></view>
    </view>

    <!-- Search Bar in Content Area -->
    <view class="content-search-section">
      <view class="search-bar-box">
        <icon type="search" size="16" color="var(--steel)"></icon>
        <input
          class="search-input"
          placeholder="在书架中搜索..."
          placeholder-style="color:var(--stone);"
          confirm-type="search"
          bindinput="handleSearchInput"
        />
        <view class="sort-trigger" bindtap="handleSortTap">
          <text>最近阅读</text>
          <view class="sort-arrow"></view>
        </view>
      </view>
    </view>

    <view class="main-content">
      <view wx:if="{{books.length > 0}}" class="bookshelf-canvas">
        <view class="bookshelf-grid">
          <view 
            wx:for="{{books}}" 
            wx:key="id" 
            class="shelf-item"
            data-book="{{item}}"
            bindtap="handleBookTap"
          >
            <view class="book-spine-box">
              <view class="book-cover-wrap">
                <image 
                  class="book-cover" 
                  src="{{item.coverUrl}}" 
                  mode="aspectFill" 
                  binderror="handleImageError"
                  data-index="{{index}}"
                />
                <view class="book-glare"></view>
                <view class="book-badge" wx:if="{{item.category}}">{{item.category}}</view>
              </view>
              <view class="book-shadow"></view>
              <view class="item-plank"></view>
            </view>
            
            <view class="book-info">
              <text class="book-name">{{item.title}}</text>
              <view class="read-action-pill" catchtap="handleActionTap" data-book="{{item}}">
                <view class="play-icon-mini"></view>
                <text>对话</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view wx:elif="{{!loading}}" class="empty-wrap">
        <view class="empty-state">
          <view class="empty-icon">📚</view>
          <text class="empty-title">书架空空如也</text>
          <text class="empty-desc">您还没有购买任何书籍，快去探索库看看吧。</text>
          <button class="explore-btn" bindtap="handleExplore">前往探索库</button>
        </view>
      </view>
    </view>
  </view>
</view>
