/* Shelf Plank Background */
.shelf-plank {
  display: none; /* Removed manual plank */
}

.bookshelf-canvas::after {
  display: none;
}

.empty-wrap {
  height: 60vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state {
  text-align: center;
  padding: 0 60rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 48rpx;
}

.empty-title {
  font-size: 36rpx;
