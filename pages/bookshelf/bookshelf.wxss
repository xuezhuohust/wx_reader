.bookshelf-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--bg-canvas);
  height: 100vh;
}

.empty-state {
  text-align: center;
  padding: 0 80rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 40rpx;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 24rpx;
  display: block;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--stone);
  line-height: 1.6;
}
