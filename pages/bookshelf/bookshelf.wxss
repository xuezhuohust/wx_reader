.bookshelf-page {
  display: flex;
  flex-direction: column;
  background: var(--bg-canvas);
  min-height: 100vh;
}

.hero-band {
  background: linear-gradient(180deg, var(--notion-brand-navy) 0%, #15203b 100%);
  color: #ffffff;
  padding: 40rpx 48rpx 96rpx;
  position: relative;
  overflow: hidden;
}

.hero-content {
  position: relative;
  z-index: 2;
  text-align: left;
}

.hero-stats-minimal {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
  opacity: 0.6;
}

.stat-item {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}

.stat-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.stat-lab {
  font-size: 20rpx;
  color: #ffffff;
}

.stat-dot {
  width: 4rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 50%;
  opacity: 0.3;
}

.hero-title {
  font-size: 68rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -0.02em;
  background: linear-gradient(180deg, #ffffff 0%, rgba(255, 255, 255, 0.8) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 28rpx;
}

/* Refined Recently Read Card */
.recent-resume-card {
  padding: 30rpx 0 0rpx 0;
  position: relative;
  transition: all 0.3s ease;
}

.recent-resume-card:active {
  opacity: 0.8;
  transform: translateY(2rpx);
}

.resume-content {
  display: flex;
  align-items: center;
  gap: 32rpx;
  position: relative;
  z-index: 2;
}

.resume-cover-box {
  position: relative;
  width: 96rpx;
  height: 134rpx;
  flex-shrink: 0;
}

.resume-cover {
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.4);
}

.resume-cover-empty {
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx;
  background: var(--bg-surface-soft);
  color: var(--stone);
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.3;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.4);
}

.resume-play-tag {
  position: absolute;
  bottom: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}

.play-icon-mini-white {
  width: 0;
  height: 0;
  border-left: 12rpx solid var(--notion-brand-navy);
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  margin-left: 6rpx;
}

.resume-info {
  flex: 1;
}

.resume-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.3);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.resume-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
  display: block;
  margin-bottom: 10rpx;
  line-height: 1.3;
}

.resume-progress {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.4);
}

.resume-arrow {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid rgba(255, 255, 255, 0.2);
  border-top: 3rpx solid rgba(255, 255, 255, 0.2);
  transform: rotate(45deg);
}

.hero-glow {
  position: absolute;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(19, 30, 56, 0.4) 0%, transparent 70%);
  filter: blur(60rpx);
  z-index: 1;
}

.hero-dots {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1.5rpx, transparent 1.5rpx);
  background-size: 48rpx 48rpx;
  opacity: 0.6;
}

/* Content Search Section */
.content-search-section {
  padding: 0 40rpx;
  margin-top: -48rpx;
  position: relative;
  z-index: 10;
}

.search-bar-box {
  background: #ffffff;
  height: 96rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  padding: 0 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid var(--hairline-soft);
}

.search-input {
  flex: 1;
  margin-left: 24rpx;
  font-size: 30rpx;
  color: var(--ink);
}

.sort-trigger {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-left: 1rpx solid var(--hairline);
  margin-left: 12rpx;
}

.sort-trigger text {
  font-size: 24rpx;
  color: var(--slate);
  font-weight: 600;
}

.sort-arrow {
  width: 8rpx;
  height: 8rpx;
  border-right: 2rpx solid var(--stone);
  border-bottom: 2rpx solid var(--stone);
  transform: rotate(45deg);
  margin-top: -4rpx;
}

/* Main Content Layout */
.main-content {
  flex: 1;
  padding-bottom: 60rpx;
}

.bookshelf-canvas {
  position: relative;
  padding: 60rpx 40rpx;
}

.bookshelf-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 80rpx 40rpx;
  position: relative;
  z-index: 2;
}

.item-plank {
  position: absolute;
  bottom: -4rpx;
  left: -20rpx;
  right: -20rpx;
  height: 12rpx;
  background: linear-gradient(to bottom, #e8e4e0 0%, #dcd8d4 100%);
  border-bottom: 2rpx solid #c8c4be;
  border-radius: 4rpx;
  z-index: 1;
}

.shelf-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.book-spine-box {
  width: 100%;
  position: relative;
  margin-bottom: 24rpx;
}

.book-cover-wrap {
  width: 100%;
  aspect-ratio: 0.72;
  position: relative;
  border-radius: 4rpx 12rpx 12rpx 4rpx;
  background: #fff;
  overflow: hidden;
  z-index: 2;
  box-shadow: 4rpx 0 16rpx rgba(0, 0, 0, 0.15),
              -2rpx 0 4rpx rgba(0, 0, 0, 0.05);
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  transform-origin: left center;
}

.book-cover-wrap::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 12rpx;
  height: 100%;
  background: rgba(0, 0, 0, 0.06);
  border-right: 1rpx solid rgba(255, 255, 255, 0.1);
  z-index: 3;
}

.book-glare {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(105deg, 
    rgba(255,255,255,0.1) 0%, 
    rgba(255,255,255,0.05) 20%, 
    transparent 50%);
  z-index: 4;
  pointer-events: none;
}

.book-shadow {
  position: absolute;
  bottom: -12rpx;
  left: 5%;
  width: 90%;
  height: 20rpx;
  background: rgba(0, 0, 0, 0.1);
  filter: blur(10rpx);
  border-radius: 50%;
  z-index: 1;
}

.book-cover {
  width: 100%;
  height: 100%;
  background: var(--bg-surface);
}

.book-cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx;
  background: var(--bg-surface-soft);
  color: var(--stone);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 1.4;
  text-align: center;
}

.book-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: var(--notion-primary);
  color: #fff;
  font-size: 14rpx;
  font-weight: 800;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  z-index: 5;
}

.book-info {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.book-name {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  text-align: center;
}

.read-action-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: var(--bg-surface-soft);
  padding: 8rpx 24rpx;
  border-radius: var(--radius-full);
  border: 1rpx solid var(--hairline);
  transition: all 0.2s;
}

.play-icon-mini {
  width: 0;
  height: 0;
  border-left: 10rpx solid var(--notion-primary);
  border-top: 6rpx solid transparent;
  border-bottom: 6rpx solid transparent;
}

.read-action-pill text {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--notion-primary);
}

.empty-wrap {
  height: 50vh;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state {
  text-align: center;
  padding: 0 60rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 32rpx;
  display: block;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
  margin-bottom: 16rpx;
  display: block;
}

.empty-desc {
  font-size: 26rpx;
  color: var(--stone);
  margin-bottom: 48rpx;
  display: block;
}

.explore-btn {
  background: var(--notion-primary);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
  padding: 24rpx 60rpx;
  border-radius: var(--radius-md);
  border: none;
}

@keyframes slideUp {
  from { transform: translateY(30rpx); opacity: 0; }
  to { transform: translateY(0); opacity: 1; }
}

