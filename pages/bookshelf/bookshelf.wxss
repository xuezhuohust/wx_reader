.bookshelf-page {
  background: var(--bg-canvas);
  height: 100vh;
  overflow: hidden;
}

.custom-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: var(--bg-canvas);
}

.nav-inner {
  position: absolute;
  left: 0; right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--primary);
  font-family: "Noto Serif SC", "Source Han Serif SC", serif;
}

.content-body {
  padding: 0 40rpx;
  padding-bottom: calc(124rpx + env(safe-area-inset-bottom));
  height: 100vh;
}

/* Search */
.search-bar {
  margin-bottom: 32rpx;
}

.search-input {
  width: 100%;
  height: 88rpx;
  background: var(--surface-lowest);
  border: 1rpx solid var(--outline-variant);
  border-radius: var(--radius-md);
  padding: 0 32rpx;
  font-size: 28rpx;
  color: var(--ink);
}

/* Book Grid */
.book-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
}

.book-grid-item {
  display: flex;
  flex-direction: column;
}

.grid-cover {
  width: 100%;
  height: 478rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
  background: var(--bg-surface);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 12rpx;
}

.grid-cover image {
  width: 100%;
  height: 100%;
  display: block;
}

.grid-cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  background: var(--surface-container);
}

.ai-ready-tag {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  background: rgba(60, 105, 43, 0.9);
  padding: 6rpx 14rpx;
  border-radius: var(--radius-sm);
}

.ai-ready-tag text {
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.grid-book-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.grid-book-author {
  font-size: 22rpx;
  color: var(--on-surface-variant);
  margin-top: 4rpx;
  font-style: italic;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 120rpx;
  gap: 16rpx;
}

.empty-icon { font-size: 80rpx; }
.empty-title { font-size: 32rpx; font-weight: 600; color: var(--ink); }
.empty-desc { font-size: 26rpx; color: var(--on-surface-variant); margin-bottom: 32rpx; }

/* FAB */
.fab-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(124rpx + env(safe-area-inset-bottom));
  background: var(--primary);
  color: var(--on-primary);
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 32rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 8rpx 24rpx rgba(60, 105, 43, 0.3);
  z-index: 100;
}

.fab-btn:active { transform: scale(0.95); }
.fab-icon { font-size: 32rpx; }
.fab-text { font-size: 26rpx; font-weight: 600; }
