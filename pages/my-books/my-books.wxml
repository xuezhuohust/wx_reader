<view class="page-shell my-page">
  <!-- Navigation -->
  <view class="custom-nav" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px; padding: 0 40rpx;">
      <text class="nav-title">我的</text>
    </view>
  </view>

  <scroll-view class="content-body" scroll-y enhanced show-scrollbar="{{false}}" style="padding-top: {{navBarHeight + 16}}px;">
    <!-- Profile Card -->
    <view class="profile-card levitating-paper" bindtap="handleOpenProfile">
      <view class="profile-row">
        <view class="avatar-wrap">
          <image wx:if="{{identity && identity.avatarUrl}}" src="{{identity.avatarUrl}}" mode="aspectFill" class="avatar-img" />
          <view wx:else class="avatar-placeholder">
            <view class="icon-user"></view>
          </view>
        </view>
        <view class="profile-info">
          <text class="profile-name">{{identity.displayName || '未登录'}}</text>
          <view class="profile-tags">
            <view class="tag-pro">会员用户</view>
            <text class="tag-joined">2024 加入</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 阅读动态 -->
    <view class="section-block">
      <view class="section-header-row">
        <text class="section-heading">阅读动态</text>
        <text class="section-filter">本周</text>
      </view>

      <view class="activity-card levitating-paper">
        <view class="activity-item">
          <view class="activity-icon icon-clock"></view>
          <text class="activity-label">阅读时长</text>
        </view>
        <text class="activity-value">12.5 <text class="activity-unit">小时</text></text>
        <view class="activity-bar">
          <view class="bar-fill" style="width: 75%;"></view>
        </view>
      </view>

      <view class="activity-card levitating-paper">
        <view class="activity-item">
          <view class="activity-icon icon-pages"></view>
          <text class="activity-label">阅读页数</text>
        </view>
        <text class="activity-value">486</text>
        <view class="activity-bar">
          <view class="bar-fill" style="width: 60%;"></view>
        </view>
      </view>

      <view class="activity-card levitating-paper">
        <view class="activity-item">
          <view class="activity-icon icon-ai-query"></view>
          <text class="activity-label">智能提问</text>
        </view>
        <text class="activity-value">87</text>
        <view class="activity-bar bar-accent">
          <view class="bar-fill" style="width: 45%;"></view>
        </view>
      </view>
    </view>

    <!-- AI Tutor Evaluation -->
    <view class="section-block">
      <view class="ai-eval-header">
        <view class="ai-eval-icon"></view>
        <text class="ai-eval-title">智能导师评价</text>
        <view class="eval-badge">实时分析</view>
      </view>
      <view class="eval-tags">
        <view class="eval-tag">深度思辨者</view>
        <view class="eval-tag">知识探索家</view>
      </view>
      <view class="eval-stat">
        <text class="eval-stat-num">24</text>
        <text class="eval-stat-desc">个辅助解决的阅读难题</text>
      </view>
      <text class="eval-quote">"你在处理哲学与科学交叉领域的理解力表现卓越。"</text>
    </view>

    <!-- Weekly Chart -->
    <view class="section-block">
      <view class="chart-wrap levitating-paper">
        <view class="chart-bars">
          <view class="chart-col">
            <view class="chart-bar" style="height: 60rpx;"></view>
            <text class="chart-day">一</text>
          </view>
          <view class="chart-col">
            <view class="chart-bar" style="height: 80rpx;"></view>
            <text class="chart-day">二</text>
          </view>
          <view class="chart-col">
            <view class="chart-bar" style="height: 70rpx;"></view>
            <text class="chart-day">三</text>
          </view>
          <view class="chart-col chart-col--active">
            <text class="chart-label">2小时</text>
            <view class="chart-bar chart-bar--active" style="height: 120rpx;"></view>
            <text class="chart-day">四</text>
          </view>
          <view class="chart-col">
            <view class="chart-bar" style="height: 90rpx;"></view>
            <text class="chart-day">五</text>
          </view>
          <view class="chart-col">
            <view class="chart-bar" style="height: 50rpx;"></view>
            <text class="chart-day">六</text>
          </view>
          <view class="chart-col">
            <view class="chart-bar" style="height: 40rpx;"></view>
            <text class="chart-day">日</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 成就徽章 -->
    <view class="section-block">
      <text class="section-heading">成就徽章</text>
      <view class="achievement-row">
        <view class="achievement-item">
          <view class="achievement-badge"></view>
          <text class="achievement-name">晨读达人</text>
        </view>
      </view>
    </view>

    <!-- Menu List -->
    <view class="menu-list">
      <view class="menu-item" bindtap="handleDeveloping">
        <view class="menu-icon icon-heart"></view>
        <text class="menu-text">我的收藏</text>
        <view class="menu-arrow"></view>
      </view>
      <view class="menu-item" bindtap="handleDeveloping">
        <view class="menu-icon icon-history"></view>
        <text class="menu-text">阅读历史</text>
        <view class="menu-arrow"></view>
      </view>
      <view class="menu-item" bindtap="handleOpenSettings">
        <view class="menu-icon icon-sliders"></view>
        <text class="menu-text">智能设置</text>
        <view class="menu-arrow"></view>
      </view>
    </view>
  </scroll-view>

  <!-- Profile Modal -->
  <view wx:if="{{showProfileModal}}" class="profile-overlay" bindtap="handleCloseProfile">
    <view class="profile-sheet" catchtap="handleStopPropagation">
      <view class="sheet-bar"></view>
      <text class="sheet-title">完善个人资料</text>
      <button class="avatar-uploader" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <view class="uploader-inner">
          <image wx:if="{{identity && identity.avatarUrl}}" src="{{identity.avatarUrl}}" mode="aspectFill" />
          <view wx:else class="uploader-placeholder">+</view>
        </view>
        <text class="uploader-hint">点击更换头像</text>
      </button>
      <view class="input-group">
        <text class="input-label">昵称</text>
        <input
          class="input-field"
          type="text"
          value="{{nicknameDraft}}"
          placeholder="请输入您的昵称"
          placeholder-style="color: var(--stone);"
          bindinput="handleNicknameDraftInput"
        />
      </view>
      <button class="btn-save" bindtap="handleProfileSubmit">保存</button>
    </view>
  </view>
</view>
