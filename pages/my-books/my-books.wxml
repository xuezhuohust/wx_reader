<view class="page-container my-books-page">
  <!-- Header matched with Bookshelf -->
  <view class="home-nav" style="height: {{navBarHeight}}px;">
    <view class="nav-header" style="position: absolute; top: {{menuTop}}px; height: {{menuHeight}}px; left: 0; right: 0; padding-right: {{menuRight}}px;">
      <view class="nav-title">我的</view>
    </view>
  </view>

  <scroll-view class="scroll-area" scroll-y enable-passive>
    <view class="scroll-content">
      <view class="profile-card-hero" bindtap="handleOpenProfile">
        <view class="avatar-wrap">
          <image class="profile-avatar" src="{{identity.avatarUrl || 'https://mmbiz.qpic.cn/mmbiz/icTdbqWNOwNRna42FI242Lcia07jQodd2FJGIYQfG0LAJGFxM4FbnQP6yfMxBgJ0F3YRqJCJ1aPAK2dQagdusBZg/0'}}" mode="aspectFill"></image>
        </view>
        <view class="profile-info">
          <view class="user-name">{{identity.displayName || '微信用户'}}</view>
          <view class="profile-meta-row">
            <view class="user-tag">{{currentRole === 'publisher' ? '内容创作者' : '深度阅读者'}}</view>
            <text class="join-date">2024 年加入</text>
          </view>
        </view>
        <view class="icon-arrow-right-faint"></view>
      </view>

      <view class="main-sections">
        <!-- Reading Stats Bento -->
      <view class="reading-stats fade-up d2">
        <view class="reading-stat">
          <view class="reading-stat-value">216h</view>
          <view class="reading-stat-label">累计阅读</view>
        </view>
        <view class="reading-stat">
          <view class="reading-stat-value">23</view>
          <view class="reading-stat-label">已读书籍</view>
        </view>
        <view class="reading-stat">
          <view class="reading-stat-value">156</view>
          <view class="reading-stat-label">我的笔记</view>
        </view>
      </view>

      <!-- Weekly Chart -->
      <view class="weekly-chart fade-up d4">
        <view class="chart-header">
          <view class="chart-title">本周阅读时长</view>
          <view class="chart-summary">12.5h</view>
        </view>
        <view class="chart-bars">
          <view class="chart-bar-wrap" wx:for="{{weeklyStats}}" wx:key="day">
            <view class="chart-bar-container">
              <view class="chart-bar {{item.active ? 'active' : ''}}" style="height: {{item.height}}%;"></view>
            </view>
            <text class="chart-bar-label">{{item.day}}</text>
          </view>
        </view>
      </view>

      <!-- Menu List -->
      <view class="menu-list fade-up d5">
        <view class="menu-item" bindtap="handleDeveloping">
          <view class="menu-item-icon green">
            <view class="icon-menu-notes"></view>
          </view>
          <view class="menu-item-text">
            <view class="menu-item-title">我的笔记</view>
            <view class="menu-item-sub">156 条 · 6 本书</view>
          </view>
          <view class="icon-arrow-right-small"></view>
        </view>

        <view class="menu-item" bindtap="handleDeveloping">
          <view class="menu-item-icon green">
            <view class="icon-menu-fav"></view>
          </view>
          <view class="menu-item-text">
            <view class="menu-item-title">我的收藏</view>
            <view class="menu-item-sub">12 本书 · 3 篇笔记</view>
          </view>
          <view class="icon-arrow-right-small"></view>
        </view>

        <view class="menu-item" bindtap="handleDeveloping">
          <view class="menu-item-icon warm">
            <view class="icon-menu-history"></view>
          </view>
          <view class="menu-item-text">
            <view class="menu-item-title">阅读历史</view>
            <view class="menu-item-sub">最近 7 天阅读记录</view>
          </view>
          <view class="icon-arrow-right-small"></view>
        </view>

        <view class="menu-item" bindtap="handleOpenSettings">
          <view class="menu-item-icon green">
            <view class="icon-menu-settings"></view>
          </view>
          <view class="menu-item-text">
            <view class="menu-item-title">智能设置</view>
            <view class="menu-item-sub">AI 伴读偏好设置</view>
          </view>
          <view class="icon-arrow-right-small"></view>
        </view>

        <view class="menu-item" bindtap="handleLogout">
          <view class="menu-item-icon red">
            <view class="icon-menu-logout"></view>
          </view>
          <view class="menu-item-text">
            <view class="menu-item-title logout-text">退出登录</view>
          </view>
        </view>
      </view>

      <view class="safe-area-bottom"></view>
    </view> <!-- Close main-sections -->
  </view> <!-- Close scroll-content -->
</scroll-view> <!-- Close scroll-area -->

  <!-- Profile Modal -->
  <view wx:if="{{showProfileModal}}" class="profile-overlay" bindtap="handleCloseProfile">
    <view class="profile-sheet" catchtap="handleStopPropagation">
      <view class="sheet-bar"></view>
      <view class="sheet-title">完善个人资料</view>
      <view wx:if="{{!profilePrivacyAgreed}}" class="profile-privacy-box">
        <view class="profile-privacy-title">设置头像前需要隐私授权</view>
        <view class="profile-privacy-text">
          头像会用于个人资料展示。请先阅读并同意{{privacyContractName}}，同意后可选择微信头像。
        </view>
        <view class="profile-privacy-actions">
          <button class="profile-privacy-link" bindtap="handleOpenPrivacyContract">查看指引</button>
          <button
            id="profile-privacy-agree"
            class="profile-privacy-agree"
            open-type="agreePrivacyAuthorization"
            bindagreeprivacyauthorization="handleAgreeProfilePrivacy"
          >同意并继续</button>
        </view>
      </view>
      <button wx:else class="avatar-uploader" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{avatarUploading}}">
        <view class="uploader-inner">
          <image wx:if="{{identity && identity.avatarUrl}}" src="{{identity.avatarUrl}}" mode="aspectFill" />
          <view class="uploader-placeholder" wx:else>+</view>
        </view>
        <view class="uploader-hint">{{avatarUploading ? '头像上传中...' : '点击更换头像'}}</view>
      </button>
      <view class="input-group">
        <view class="input-label">昵称</view>
        <input
          class="input-field"
          type="text"
          value="{{nicknameDraft}}"
          placeholder="请输入您的昵称"
          placeholder-class="search-placeholder"
          bindinput="handleNicknameDraftInput"
          bindblur="handleNicknameDraftInput"
          maxlength="20"
        />
      </view>
      <view class="btn-primary" bindtap="handleProfileSubmit">保存设置</view>
    </view>
  </view>
</view>
