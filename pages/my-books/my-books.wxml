<view class="page-shell my-books-page">
  <!-- Profile Section -->
  <view class="profile-card" bindtap="handleOpenProfile">
    <view class="profile-left">
      <view class="user-avatar">
        <image wx:if="{{identity && identity.avatarUrl}}" src="{{identity.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-icon">?</view>
      </view>
      <view class="user-info">
        <text class="nickname">{{identity.displayName || '未登录读者'}}</text>
        <view class="role-tag-row">
          <text class="user-id" wx:if="{{identity}}">ID: {{identity.userId}}</text>
          <view class="role-switch-pill-mini" catchtap="handleRoleChange" data-role="{{currentRole === 'reader' ? 'publisher' : 'reader'}}">
            <text>{{currentRole === 'reader' ? '切换出版商' : '切换读者'}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="edit-action" wx:if="{{identity}}">编辑</view>
  </view>

  <!-- My Books Section -->
  <view class="section-container">
    <view class="section-header">
      <text class="section-title">我的书架</text>
      <text class="section-count">{{books.length}} 册已收藏</text>
    </view>

    <view wx:if="{{books.length}}" class="book-list">
      <book-card
        wx:for="{{books}}"
        wx:key="id"
        book="{{item}}"
        mode="owned"
        bind:cardtap="handleBookTap"
        bind:actiontap="handleActionTap"
      />
    </view>

    <empty-state
      wx:else
      title="书架空空如也"
      description="挑选一本好书，开启您的 AI 伴读之旅"
      button-text="前往书库"
      bind:actiontap="handleExplore"
    />
  </view>

  <!-- Profile Modal -->
  <view wx:if="{{showProfileModal}}" class="profile-overlay" bindtap="handleCloseProfile">
    <view class="profile-sheet" catchtap="handleStopPropagation">
      <view class="sheet-header">
        <text class="sheet-title">个人信息</text>
      </view>
      
      <button class="avatar-box" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{identity && identity.avatarUrl}}" src="{{identity.avatarUrl}}" mode="aspectFill" />
        <view wx:else class="plus-icon">+</view>
      </button>

      <view class="form-item">
        <text class="form-label">昵称</text>
        <input
          class="form-input"
          type="text"
          value="{{nicknameDraft}}"
          placeholder="设置您的昵称"
          bindinput="handleNicknameDraftInput"
        />
      </view>

      <button class="btn-primary" bindtap="handleProfileSubmit">保存设置</button>
    </view>
  </view>
</view>
