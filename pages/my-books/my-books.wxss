.my-page {
  background-color: #faf8f5;
  color: #1b1b1b;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Hero Header Section (Synced with Home) */
.my-hero-header {
  position: relative;
  width: 100%;
  min-height: 560rpx;
  overflow: hidden;
  background-color: #faf8f5;
}

.hero-bg-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  transform: scale(1);
  opacity: 0.9;
}

.hero-glass-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 101%;
  background: linear-gradient(to bottom, 
    rgba(250, 248, 245, 0.05) 0%, 
    rgba(250, 248, 245, 0.1) 40%, 
    rgba(250, 248, 245, 0.6) 70%, 
    rgba(250, 248, 245, 0.95) 90%,
    #faf8f5 98%,
    #faf8f5 100%
  );
  z-index: 1;
}

.hero-body {
  position: relative;
  z-index: 2;
  padding: 0 40rpx 80rpx;
}

.hero-top-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 72rpx;
}

.nav-title-hero {
  font-size: 56rpx;
  font-weight: 900;
  color: #1b1b1b;
  letter-spacing: -1.5rpx;
}

.nav-btn-hero {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
}

/* Profile Card Hero (Integrated Style) */
.profile-card-hero {
  display: flex;
  align-items: center;
  padding: 40rpx;
  background: rgba(255, 255, 255, 0.5);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03);
  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

.profile-card-hero:active {
  transform: scale(0.985);
  background: rgba(255, 255, 255, 0.7);
}

.profile-avatar-box {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(60, 105, 43, 0.15);
  background: #3c692b;
}

.profile-avatar-box image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-text-info {
  flex: 1;
}

.profile-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.profile-display-name {
  font-size: 42rpx;
  font-weight: 900;
  color: #1b1b1b;
  letter-spacing: -1rpx;
}

.profile-status-dot {
  width: 12rpx;
  height: 12rpx;
  background-color: #3c692b;
  border-radius: 50%;
}

.profile-meta-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.profile-tag {
  font-size: 20rpx;
  font-weight: 800;
  color: #3c692b;
  background: rgba(60, 105, 43, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.profile-year {
  font-size: 22rpx;
  color: #8c8c8c;
  font-weight: 500;
}

/* Scroll Area */
.scroll-area {
  width: 100%;
  height: 100vh;
}

.scroll-content {
  padding: 0 0 48rpx;
}

.no-padding-top {
  padding-top: 0 !important;
}

.main-sections {
  padding: 0 40rpx;
  position: relative;
  z-index: 3;
}

.icon-arrow-right-dark {
  width: 12rpx;
  height: 12rpx;
  border-top: 3rpx solid #1b1b1b;
  border-right: 3rpx solid #1b1b1b;
  transform: rotate(45deg);
  opacity: 0.2;
}

.icon-settings-dark {
  width: 32rpx;
  height: 32rpx;
  border: 4rpx solid #1b1b1b;
  border-radius: 50%;
  position: relative;
}

.icon-settings-dark::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 10rpx;
  height: 10rpx;
  background-color: #1b1b1b;
  border-radius: 50%;
}

/* Reading Stats Bento */
.reading-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.reading-stat {
  background-color: #fff;
  border-radius: 28rpx;
  padding: 32rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.reading-stat-value {
  font-size: 44rpx;
  font-weight: 900;
  color: #1b1b1b;
  letter-spacing: -1rpx;
}

.reading-stat-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #8c8c8c;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-top: 8rpx;
}

/* Section Header Small */
.section-header-small {
  margin-bottom: 24rpx;
}

.section-title-small {
  font-size: 28rpx;
  font-weight: 900;
  color: #1b1b1b;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  opacity: 0.8;
}

/* Badges Row */
.badges-scroll {
  margin: 0 -40rpx 48rpx;
  width: calc(100% + 80rpx);
}

.badges-row {
  display: flex;
  padding: 0 40rpx 8rpx;
  gap: 20rpx;
}

.badge-item {
  min-width: 200rpx;
  background-color: #fff;
  border-radius: 32rpx;
  padding: 32rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.badge-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.badge-icon-wrap.morning { background-color: rgba(245, 158, 11, 0.1); }
.badge-icon-wrap.marathon { background-color: rgba(60, 105, 43, 0.1); }
.badge-icon-wrap.locked { background-color: #f3efe8; opacity: 0.5; }

.badge-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #1b1b1b;
  white-space: nowrap;
}

.badge-level {
  font-size: 20rpx;
  font-weight: 600;
  color: #8c8c8c;
  margin-top: 4rpx;
}

.badge-progress-bar {
  width: 100rpx;
  height: 4rpx;
  background-color: #f3efe8;
  border-radius: 99rpx;
  margin-top: 16rpx;
  overflow: hidden;
}

.badge-progress-fill {
  height: 100%;
  border-radius: 99rpx;
}

.morning .badge-progress-fill { background-color: #f59e0b; }
.marathon .badge-progress-fill { background-color: #3c692b; }

/* Weekly Chart */
.weekly-chart {
  background-color: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  margin-bottom: 48rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 32rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1b1b1b;
}

.chart-summary {
  font-size: 32rpx;
  font-weight: 900;
  color: #3c692b;
}

.chart-bars {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 200rpx;
  gap: 16rpx;
}

.chart-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.chart-bar {
  width: 100%;
  background-color: #f3efe8;
  border-radius: 8rpx 8rpx 0 0;
  min-height: 8rpx;
  transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.chart-bar.active {
  background-color: #3c692b;
}

.chart-bar-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #8c8c8c;
}

/* Menu List */
.menu-list {
  background-color: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #f3efe8;
}

.menu-item-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.menu-item-icon.green { background-color: rgba(60, 105, 43, 0.08); }
.menu-item-icon.warm { background-color: rgba(180, 130, 80, 0.1); }
.menu-item-icon.red { background-color: rgba(220, 80, 60, 0.08); }

.menu-item-text {
  flex: 1;
}

.menu-item-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1b1b1b;
}

.menu-item-sub {
  font-size: 22rpx;
  color: #8c8c8c;
  margin-top: 4rpx;
}

.logout-text {
  color: #c44;
}

/* Icons (SVG mapping) */
.icon-settings { width: 32rpx; height: 32rpx; border: 4rpx solid #1b1b1b; border-radius: 8rpx; }
.icon-user-white { width: 48rpx; height: 48rpx; border: 4rpx solid #fff; border-radius: 50%; opacity: 0.8; }
.icon-arrow-right-faint { width: 12rpx; height: 12rpx; border-top: 4rpx solid #8c8c8c; border-right: 4rpx solid #8c8c8c; transform: rotate(45deg); opacity: 0.4; }
.icon-arrow-right-small { width: 10rpx; height: 10rpx; border-top: 3.5rpx solid #8c8c8c; border-right: 3.5rpx solid #8c8c8c; transform: rotate(45deg); opacity: 0.4; }

.icon-morning { width: 32rpx; height: 32rpx; border: 4rpx solid #f59e0b; border-radius: 50%; position: relative; }
.icon-morning::after { content: ''; position: absolute; top: 10rpx; left: 10rpx; width: 12rpx; height: 12rpx; background: #f59e0b; border-radius: 50%; }
.icon-marathon { width: 32rpx; height: 40rpx; border: 4rpx solid #3c692b; border-radius: 6rpx; }
.icon-pen { width: 32rpx; height: 32rpx; border-bottom: 4rpx solid #8c8c8c; transform: rotate(-45deg); }

.icon-menu-notes { width: 28rpx; height: 36rpx; border: 3.5rpx solid #3c692b; border-radius: 4rpx; }
.icon-menu-fav { width: 32rpx; height: 32rpx; background-color: #3c692b; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
.icon-menu-history { width: 32rpx; height: 32rpx; border: 3.5rpx solid rgba(180, 130, 80, 0.8); border-radius: 50%; position: relative; }
.icon-menu-history::after { content: ''; position: absolute; top: 14rpx; left: 14rpx; width: 10rpx; height: 3.5rpx; background: rgba(180, 130, 80, 0.8); transform: rotate(-45deg); }
.icon-menu-settings { width: 32rpx; height: 32rpx; border: 3.5rpx solid #3c692b; border-radius: 6rpx; }
.icon-menu-logout { width: 32rpx; height: 32rpx; border-left: 3.5rpx solid #c44; border-top: 3.5rpx solid #c44; border-bottom: 3.5rpx solid #c44; position: relative; }
.icon-menu-logout::after { content: '→'; position: absolute; right: -10rpx; top: -10rpx; color: #c44; font-size: 24rpx; }

/* Animations */
.fade-up {
  animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.d1 { animation-delay: 0ms; }
.d2 { animation-delay: 80ms; }
.d3 { animation-delay: 160ms; }
.d4 { animation-delay: 240ms; }
.d5 { animation-delay: 320ms; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Privacy/Profile Sheet */
.profile-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 3000;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: flex-end;
}

.profile-sheet {
  width: 100%;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 40rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}

.sheet-bar {
  width: 80rpx;
  height: 8rpx;
  background-color: #f3efe8;
  border-radius: 99rpx;
  margin: 0 auto 32rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #1b1b1b;
  text-align: center;
  margin-bottom: 48rpx;
}

.avatar-uploader {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
  background: none;
  line-height: normal;
  padding: 0;
}

.avatar-uploader::after { border: none; }

.uploader-inner {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #f3efe8;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.uploader-inner image { width: 100%; height: 100%; }

.uploader-placeholder {
  font-size: 64rpx;
  color: #8c8c8c;
  font-weight: 300;
}

.uploader-hint {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-top: 16rpx;
  font-weight: 700;
}

.input-group {
  margin-bottom: 48rpx;
}

.input-label {
  font-size: 24rpx;
  font-weight: 900;
  color: #1b1b1b;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  opacity: 0.6;
}

.input-field {
  width: 100%;
  height: 100rpx;
  background-color: #f3efe8;
  border-radius: 24rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1b1b1b;
}

.btn-primary {
  background-color: #1b1b1b;
  color: #fff;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-primary:active {
  transform: scale(0.96);
}

.search-placeholder {
  color: #8c8c8c;
  font-weight: 500;
}

.safe-area-bottom {
  height: calc(140rpx + env(safe-area-inset-bottom));
}
