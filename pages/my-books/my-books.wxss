.my-books-page {
  background: var(--bg-canvas);
  min-height: 100vh;
}

/* Hero Band: High-Density Notion Style */
.hero-band {
  background: linear-gradient(135deg, #0a1530 0%, #15203b 100%);
  color: #ffffff;
  padding: 40rpx 24rpx 100rpx; /* Reduced horizontal padding from 40rpx */
  position: relative;
  overflow: hidden;
  transition: background 0.4s ease;
}

.role-publisher .hero-band {
  background: linear-gradient(135deg, #064e3b 0%, #0d9488 100%);
}

.hero-content {
  position: relative;
  z-index: 5;
}

.profile-main {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 48rpx;
}

.avatar-container {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.avatar-img,
.avatar-placeholder {
  width: 100%;
  height: 100%;
  border-radius: var(--radius-lg);
  border: 4rpx solid rgba(255, 255, 255, 0.15);
  background: rgba(255, 255, 255, 0.05);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.2);
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-role-switch {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 44rpx;
  height: 44rpx;
  background: #ffffff;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  border: 1rpx solid var(--hairline-soft);
  z-index: 10;
}

.avatar-role-switch:active {
  transform: scale(0.9);
  background: var(--bg-surface-soft);
}

.icon-switch-mini {
  width: 24rpx;
  height: 24rpx;
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%2337352f" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M16 3h5v5"></path><path d="M8 21H3v-5"></path><path d="M21 3l-7.5 7.5"></path><path d="M3 21l7.5-7.5"></path></svg>');
}

.profile-info {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.user-display-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.5rpx;
}

.chevron-right-white {
  width: 12rpx;
  height: 12rpx;
  border-right: 3rpx solid rgba(255, 255, 255, 0.5);
  border-top: 3rpx solid rgba(255, 255, 255, 0.5);
  transform: rotate(45deg);
}

.user-status-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255, 255, 255, 0.1);
  padding: 6rpx 16rpx;
  border-radius: var(--radius-sm);
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.8);
}

.status-dot-active {
  width: 8rpx;
  height: 8rpx;
  background: var(--semantic-success);
  border-radius: 50%;
}

.role-publisher .status-dot-active {
  background: #2dd4bf; /* Teal dot for publisher status */
}

.level-text {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* Stats: Floating Card */
.stats-premium-card {
  background: #ffffff;
  border-radius: var(--radius-xl);
  padding: 32rpx 0;
  display: flex;
  align-items: center;
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.1);
  width: 100%;
  border: 1rpx solid var(--hairline-soft);
}

.stat-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-v {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}

.stat-l {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--stone);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.stat-sep {
  width: 1rpx;
  height: 48rpx;
  background: var(--hairline-soft);
}

/* Decorative Dots & Mesh */
.hero-dots {
  position: absolute;
  top: 0;
  right: 0;
  width: 200rpx;
  height: 200rpx;
  background-image: radial-gradient(rgba(255, 255, 255, 0.1) 15%, transparent 15%);
  background-size: 20rpx 20rpx;
  opacity: 0.5;
}

/* Main Content Area */
.main-content-refined {
  padding: 0 24rpx 80rpx; /* Reduced horizontal padding from 40rpx to lengthen cards */
  position: relative;
  z-index: 10;
}

/* Role Switch Bar (Centered on the Split Line) */
.role-switch-premium-bar {
  background: #ffffff;
  border-radius: var(--radius-xl);
  padding: 32rpx;
  margin: -60rpx 24rpx 40rpx; /* Reduced horizontal margin from 40rpx to lengthen */
  box-shadow: 0 16rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid var(--hairline-soft);
  position: relative;
  z-index: 20;
}

.role-switch-premium-bar:active {
  background: var(--bg-surface-soft);
  transform: translateY(2rpx);
}

.switch-bar-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.switch-bar-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.switch-bar-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.switch-bar-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.switch-bar-desc {
  font-size: 22rpx;
  color: var(--stone);
}

.btn-switch-action {
  background: #f0fdfa;
  color: var(--theme-publisher);
  font-size: 22rpx;
  font-weight: 700;
  padding: 12rpx 24rpx;
  border-radius: var(--radius-full);
}

.role-publisher .btn-switch-action {
  background: #eff6ff;
  color: var(--theme-reader);
}

.menu-label-sub {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--slate);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin: 0 0 20rpx 12rpx;
}

/* Grid Style (from Reference) */
.menu-grid-refined {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  background: #ffffff;
  border-radius: var(--radius-xl);
  padding: 32rpx 20rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid var(--hairline-soft);
}

.menu-grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12rpx;
}

.grid-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.grid-title {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--charcoal);
}

.grid-desc {
  font-size: 18rpx;
  color: var(--stone);
  margin-top: -4rpx;
}

/* List Style */
.menu-group-refined {
  background: #ffffff;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--hairline-soft);
  overflow: hidden;
  margin-bottom: 32rpx; /* Reduced from 48rpx */
}

.menu-item-refined {
  display: flex;
  align-items: center;
  padding: 20rpx 10rpx; /* Reverted height, focus on width */
  border-bottom: 1rpx solid var(--hairline-soft);
}

.menu-item-refined:last-child {
  border-bottom: none;
}

.menu-item-refined:active {
  background: var(--bg-surface-soft);
}

.menu-icon-box {
  width: 56rpx; /* Reduced from 64rpx */
  height: 56rpx; /* Reduced from 64rpx */
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.menu-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.text-error {
  color: var(--semantic-error) !important;
}

.menu-suffix {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.suffix-text {
  font-size: 22rpx;
  color: var(--stone);
}

.chevron-right-mini {
  width: 10rpx; /* Slightly smaller */
  height: 10rpx; /* Slightly smaller */
  border-right: 2.5rpx solid var(--muted);
  border-top: 2.5rpx solid var(--muted);
  transform: rotate(45deg);
}

/* Logout */
.item-logout:active {
  background: #fff5f5 !important;
}

/* Icons & Tints (Notion Design Tokens) */
.tint-peach { background: var(--card-tint-peach, #ffe8d4); color: var(--brand-orange, #dd5b00); }
.tint-mint { background: var(--card-tint-mint, #d9f3e1); color: var(--brand-green, #1aae39); }
.tint-sky { background: var(--card-tint-sky, #dcecfa); color: var(--link-blue, #0075de); }
.tint-lavender { background: var(--card-tint-lavender, #e6e0f5); color: var(--brand-purple, #7b3ff2); }
.tint-rose { background: var(--card-tint-rose, #fde0ec); color: var(--semantic-error, #e03131); }
.tint-gray { background: var(--bg-surface, #f6f5f4); color: var(--slate, #5d5b54); }

