.my-page { background: var(--bg-canvas); }

/* Navigation */
.custom-nav { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; background: var(--bg-canvas); }
.nav-inner { position: absolute; left: 0; right: 0; display: flex; align-items: center; justify-content: center; }
.nav-title { font-size: 36rpx; font-weight: 700; color: var(--primary); }

.content-body { padding: 0 32rpx; padding-bottom: calc(200rpx + env(safe-area-inset-bottom)); }

/* Profile Card */
.profile-card { padding: 32rpx; margin-bottom: 32rpx; }
.profile-row { display: flex; align-items: center; gap: 24rpx; }
.avatar-wrap { width: 100rpx; height: 100rpx; border-radius: var(--radius-lg); overflow: hidden; flex-shrink: 0; }
.avatar-img { width: 100%; height: 100%; }
.avatar-placeholder { width: 100%; height: 100%; background: var(--bg-surface); display: flex; align-items: center; justify-content: center; }
.icon-user { width: 48rpx; height: 48rpx; background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%2372796c" stroke-width="2" xmlns="http://www.w3.org/2000/svg"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>'); background-size: contain; background-repeat: no-repeat; }

.profile-info { flex: 1; }
.profile-name { display: block; font-size: 36rpx; font-weight: 700; color: var(--ink); margin-bottom: 8rpx; }
.profile-tags { display: flex; align-items: center; gap: 12rpx; }
.tag-pro { font-size: 20rpx; font-weight: 600; color: var(--primary); background: rgba(127, 176, 105, 0.15); padding: 4rpx 14rpx; border-radius: var(--radius-sm); }
.tag-joined { font-size: 20rpx; color: var(--stone); }

/* Section */
.section-block { margin-bottom: 40rpx; }
.section-header-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 20rpx; }
.section-heading { font-size: 30rpx; font-weight: 700; color: var(--ink); }
.section-filter { font-size: 22rpx; color: var(--primary); font-weight: 500; }

/* Activity Cards */
.activity-card { padding: 24rpx 28rpx; margin-bottom: 16rpx; }
.activity-item { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.activity-icon { width: 32rpx; height: 32rpx; background-size: contain; background-repeat: no-repeat; }
.activity-label { font-size: 24rpx; color: var(--on-surface-variant); }
.activity-value { display: block; font-size: 40rpx; font-weight: 700; color: var(--ink); margin-bottom: 12rpx; }
.activity-unit { font-size: 24rpx; font-weight: 400; color: var(--stone); }
.activity-bar { height: 8rpx; background: var(--bg-surface); border-radius: var(--radius-full); overflow: hidden; }
.bar-fill { height: 100%; background: var(--primary-container); border-radius: var(--radius-full); }

.icon-clock { background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%237fb069" stroke-width="2" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>'); }
.icon-pages { background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%237fb069" stroke-width="2" xmlns="http://www.w3.org/2000/svg"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>'); }
.icon-ai-query { background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%237fb069" stroke-width="2" xmlns="http://www.w3.org/2000/svg"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>'); }

/* AI Evaluation */
.ai-eval-header { display: flex; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.ai-eval-icon { width: 32rpx; height: 32rpx; background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%233c692b" stroke-width="2" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>'); background-size: contain; background-repeat: no-repeat; }
.ai-eval-title { font-size: 28rpx; font-weight: 700; color: var(--primary); }
.eval-badge { font-size: 16rpx; font-weight: 600; color: var(--stone); background: var(--bg-surface); padding: 4rpx 12rpx; border-radius: var(--radius-sm); letter-spacing: 1rpx; margin-left: auto; }
.eval-tags { display: flex; gap: 12rpx; margin-bottom: 16rpx; }
.eval-tag { font-size: 22rpx; font-weight: 600; color: var(--primary); background: rgba(127, 176, 105, 0.12); padding: 8rpx 20rpx; border-radius: var(--radius-sm); border: 1rpx solid rgba(60, 105, 43, 0.15); }
.eval-stat { display: flex; align-items: baseline; gap: 8rpx; margin-bottom: 12rpx; }
.eval-stat-num { font-size: 40rpx; font-weight: 700; color: var(--ink); }
.eval-stat-desc { font-size: 24rpx; color: var(--on-surface-variant); }
.eval-quote { display: block; font-size: 24rpx; color: var(--steel); line-height: 1.5; font-style: italic; padding-left: 16rpx; border-left: 4rpx solid var(--primary-container); }

/* Weekly Chart */
.chart-wrap { padding: 32rpx; }
.chart-bars { display: flex; align-items: flex-end; justify-content: space-between; height: 160rpx; }
.chart-col { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.chart-bar { width: 32rpx; background: var(--bg-surface); border-radius: var(--radius-sm); }
.chart-bar--active { background: var(--primary-container); }
.chart-col--active .chart-day { color: var(--primary); font-weight: 700; }
.chart-label { font-size: 18rpx; color: var(--primary); font-weight: 600; }
.chart-day { font-size: 20rpx; color: var(--stone); }

/* 成就徽章 */
.achievement-row { display: flex; gap: 24rpx; margin-top: 16rpx; }
.achievement-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.achievement-badge { width: 80rpx; height: 80rpx; border-radius: 50%; background: rgba(127, 176, 105, 0.15); border: 2rpx solid var(--primary-container); }
.achievement-name { font-size: 20rpx; color: var(--on-surface-variant); }

/* Menu List */
.menu-list { margin-top: 16rpx; }
.menu-item { display: flex; align-items: center; gap: 20rpx; padding: 28rpx 0; border-bottom: 1rpx solid var(--hairline); }
.menu-item:last-child { border-bottom: none; }
.menu-icon { width: 36rpx; height: 36rpx; background-size: contain; background-repeat: no-repeat; }
.menu-text { flex: 1; font-size: 28rpx; color: var(--ink); font-weight: 500; }
.menu-arrow { width: 12rpx; height: 12rpx; border-right: 3rpx solid var(--stone); border-top: 3rpx solid var(--stone); transform: rotate(45deg); }

.icon-heart { background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%2372796c" stroke-width="2" xmlns="http://www.w3.org/2000/svg"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>'); }
.icon-history { background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%2372796c" stroke-width="2" xmlns="http://www.w3.org/2000/svg"><circle cx="12" cy="12" r="10"/><polyline points="12,6 12,12 16,14"/></svg>'); }
.icon-sliders { background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%2372796c" stroke-width="2" xmlns="http://www.w3.org/2000/svg"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>'); }

/* Profile Modal */
.profile-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 2000; display: flex; align-items: flex-end; }
.profile-sheet { width: 100%; background: var(--surface-lowest); border-radius: var(--radius-xl) var(--radius-xl) 0 0; padding: 20rpx 40rpx calc(60rpx + env(safe-area-inset-bottom)); }
.sheet-bar { width: 80rpx; height: 8rpx; background: var(--hairline); border-radius: var(--radius-full); margin: 0 auto 32rpx; }
.sheet-title { display: block; font-size: 34rpx; font-weight: 700; color: var(--ink); text-align: center; margin-bottom: 40rpx; }

.avatar-uploader { display: flex; flex-direction: column; align-items: center; gap: 16rpx; margin-bottom: 40rpx; background: transparent; padding: 0; }
.avatar-uploader::after { border: none; }
.uploader-inner { width: 160rpx; height: 160rpx; border-radius: var(--radius-xl); background: var(--bg-surface); overflow: hidden; border: 1rpx solid var(--outline-variant); }
.uploader-inner image { width: 100%; height: 100%; }
.uploader-placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; font-size: 56rpx; color: var(--stone); }
.uploader-hint { font-size: 24rpx; color: var(--stone); }

.input-group { margin-bottom: 40rpx; }
.input-label { display: block; font-size: 24rpx; font-weight: 600; color: var(--on-surface-variant); margin-bottom: 12rpx; }
.input-field { width: 100%; height: 88rpx; background: var(--surface-container-low); border: 1rpx solid var(--outline-variant); border-radius: var(--radius-md); padding: 0 24rpx; font-size: 30rpx; color: var(--ink); }

.btn-save { width: 100% !important; height: 96rpx; background: var(--primary-container); color: var(--on-primary); border-radius: var(--radius-md); font-size: 30rpx; font-weight: 700; display: flex; align-items: center; justify-content: center; }
.btn-save:active { background: var(--primary); transform: scale(0.98); }
