.my-books-page {
  padding: 48rpx;
  background: var(--bg-canvas);
}

/* Profile Card */
.profile-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  background: var(--bg-surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-lg);
  margin-bottom: 64rpx;
}

.profile-left {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-full);
  background: #fff;
  border: 1rpx solid var(--hairline);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.user-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-icon {
  font-size: 40rpx;
  color: var(--stone);
}

.user-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.role-tag-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.user-id {
  font-size: 22rpx;
  color: var(--stone);
}

.role-switch-pill-mini {
  background: var(--notion-primary);
  color: #fff;
  font-size: 18rpx;
  font-weight: 700;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  justify-content: center;
}

.role-switch-pill-mini:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.edit-action {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--slate);
  padding: 8rpx 20rpx;
  background: #fff;
  border: 1rpx solid var(--hairline-strong);
  border-radius: var(--radius-sm);
}

/* Section Header */
.section-container {
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--ink);
}

.section-count {
  font-size: 24rpx;
  color: var(--stone);
}

/* Profile Modal */
.profile-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(8px);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.profile-sheet {
  width: 100%;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  animation: slideInUp 0.3s ease-out;
}

@keyframes slideInUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.sheet-header {
  margin-bottom: 48rpx;
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
}

.avatar-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-full);
  background: var(--bg-surface);
  border: 1rpx solid var(--hairline);
  margin: 0 auto 48rpx;
  padding: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-box image {
  width: 100%;
  height: 100%;
}

.plus-icon {
  font-size: 48rpx;
  color: var(--stone);
}

.form-item {
  margin-bottom: 48rpx;
}

.form-label {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--stone);
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: var(--bg-surface);
  border: 1rpx solid var(--hairline);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--ink);
}
