/* Profile Modal: Consistent with Notion Theme */
.profile-sheet-premium {
  width: 100%;
  background: #ffffff;
  border-radius: var(--radius-xxl) var(--radius-xxl) 0 0;
  padding: 20rpx 40rpx calc(60rpx + env(safe-area-inset-bottom));
}

.sheet-bar {
  width: 80rpx;
  height: 8rpx;
  background: var(--hairline-soft);
  border-radius: var(--radius-full);
  margin: 0 auto 40rpx;
}

.sheet-t {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  text-align: center;
  margin-bottom: 48rpx;
}

.avatar-uploader {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 60rpx;
  background: transparent;
  padding: 0;
}

.avatar-uploader::after { border: none; }

.uploader-inner {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius-xl);
  background: var(--bg-surface);
  position: relative;
  overflow: hidden;
  border: 1rpx solid var(--hairline);
}

.uploader-inner image {
  width: 100%;
  height: 100%;
}

.uploader-mask {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transition: opacity 0.2s;
}

.avatar-uploader:active .uploader-mask {
  opacity: 1;
}

.uploader-hint {
  font-size: 24rpx;
  color: var(--slate);
}

.input-group-premium {
  margin-bottom: 60rpx;
}

.input-label {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--slate);
  margin-bottom: 20rpx;
  display: block;
}

.input-wrapper {
  background: var(--bg-surface-soft);
  border-radius: var(--radius-lg);
  height: 100rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--hairline-soft);
}

.input-field {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}

.btn-premium-action {
  width: 100% !important;
  height: 100rpx;
  background: #5645d4; /* Notion Primary Purple */
  color: #fff;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-premium-action:active {
  background: #4534b3;
  transform: scale(0.98);
}
