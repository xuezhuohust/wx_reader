page {
  background-color: #faf8f5;
}

.my-books-page {
  background-color: #faf8f5;
  color: #1b1b1b;
  height: 100vh; /* 必须使用固定高度以配合 scroll-view */
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Header matched with Bookshelf */
.home-nav {
  background-color: #faf8f5;
  position: sticky;
  top: 0;
  z-index: 100;
  flex-shrink: 0;
}

.nav-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 40rpx;
}

.nav-title {
  font-size: 56rpx;
  font-weight: 900;
  letter-spacing: -1.5rpx;
  color: #1b1b1b;
  line-height: 1.2;
}

.nav-actions {
  display: flex;
}

.nav-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
}

.nav-btn:active {
  background-color: #f3efe8;
  transform: scale(0.94);
}

.icon-settings {
  width: 32rpx;
  height: 32rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}

.icon-settings::before, .icon-settings::after {
  content: '';
  width: 30rpx;
  height: 4rpx;
  background-color: #1b1b1b;
  border-radius: 4rpx;
  position: relative;
}

/* 模拟书库筛选图标：带圆点的横线 */
.icon-settings::before {
  box-shadow: -8rpx 0 0 -1rpx #1b1b1b inset; /* 这里的逻辑有点复杂，直接用简单的横线模拟 */
  background: linear-gradient(to right, #1b1b1b 0%, #1b1b1b 25%, transparent 25%, transparent 40%, #1b1b1b 40%, #1b1b1b 100%);
}

.icon-settings::after {
  background: linear-gradient(to right, #1b1b1b 0%, #1b1b1b 60%, transparent 60%, transparent 75%, #1b1b1b 75%, #1b1b1b 100%);
}

/* Scroll Area */
.scroll-area {
  flex: 1;
  height: 0; /* 关键：强制 flex 子项高度受限，从而触发 scroll-view 内部滚动 */
}

.scroll-content {
  padding: 0 64rpx 64rpx;
}

/* Profile Hero - Artifact Inspired & Decardified */
.profile-card-hero {
  display: flex;
  align-items: center;
  padding: 56rpx 0;
  background: transparent;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 32rpx;
  background: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
}

.profile-avatar {
  width: 100%;
  height: 100%;
}

.profile-info {
  flex: 1;
}

.user-name {
  font-size: 44rpx;
  font-weight: 900;
  color: #1b1b1b;
  letter-spacing: -1.2rpx;
  margin-bottom: 6rpx;
  line-height: 1.1;
}

.profile-meta-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-tag {
  background: rgba(60, 105, 43, 0.06);
  color: #3c692b;
  padding: 4rpx 14rpx;
  border-radius: 99rpx;
  font-size: 18rpx;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.5rpx;
}

.join-date {
  font-size: 20rpx;
  color: #8c8c8c;
  font-weight: 500;
}

/* Reading Stats - Pure Decardified */
.reading-stats {
  display: flex;
  justify-content: space-between;
  margin-bottom: 64rpx;
  padding: 0;
}

.reading-stat {
  flex: 1;
  background: transparent;
  padding: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  border: none;
  box-shadow: none;
}

.reading-stat-value {
  font-size: 42rpx;
  font-weight: 900;
  color: #1b1b1b;
  letter-spacing: -1rpx;
  font-family: 'Satoshi', 'DIN Alternate', sans-serif;
  line-height: 1.2;
}

.reading-stat-label {
  font-size: 18rpx;
  font-weight: 700;
  color: #8c8c8c;
  text-transform: uppercase;
  letter-spacing: 1.5rpx;
  margin-top: 8rpx;
  opacity: 0.6;
}

/* Weekly Chart - Pure Decardified */
.weekly-chart {
  margin-bottom: 64rpx;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}

.chart-header {
  margin-bottom: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}

.chart-title {
  font-size: 20rpx;
  font-weight: 900;
  color: #1b1b1b;
  opacity: 0.3;
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.chart-summary {
  font-size: 44rpx;
  font-weight: 900;
  color: #3c692b;
  letter-spacing: -1rpx;
}

.chart-bars {
  height: 240rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.chart-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  height: 100%;
}

.chart-bar-container {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  position: relative;
}

.chart-bar {
  width: 100%;
  background: #e2e2e2;
  border-radius: 6rpx;
  transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  min-height: 8rpx;
}

.chart-bar.active {
  background: #3c692b;
}

.chart-bar-label {
  font-size: 18rpx;
  font-weight: 800;
  color: #b2b2b2;
  margin-top: 12rpx;
}

/* Menu List - Pure Decardified */
.menu-list {
  background: transparent;
  margin-top: 16rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  gap: 24rpx;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 0;
  background: rgba(60, 105, 43, 0.04);
  color: #3c692b;
}

/* 移除特定的颜色变体，统一使用学术绿体系 */
.menu-item-icon.green { color: #3c692b; background: rgba(60, 105, 43, 0.04); }
.menu-item-icon.warm { color: #3c692b; background: rgba(60, 105, 43, 0.04); }
.menu-item-icon.red { color: #ba1a1a; background: rgba(186, 26, 26, 0.04); } /* 退出登录保留警告色 */

.menu-item-text {
  flex: 1;
}

.menu-item-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1b1b1b;
  letter-spacing: -0.2rpx;
}

.menu-item-sub {
  font-size: 20rpx;
  color: #8c8c8c;
  margin-top: 4rpx;
  font-weight: 500;
}

.logout-text {
  color: #ba1a1a;
}

/* Icons (SVG mapping) */
.icon-settings { width: 32rpx; height: 32rpx; border: 4rpx solid #1b1b1b; border-radius: 8rpx; }
.icon-user-white { width: 48rpx; height: 48rpx; border: 4rpx solid #fff; border-radius: 50%; opacity: 0.8; }
.icon-arrow-right-faint {
  width: 14rpx;
  height: 14rpx;
  border-top: 3.5rpx solid #ccc;
  border-right: 3.5rpx solid #ccc;
  transform: rotate(45deg);
  opacity: 0.6;
  margin-left: 20rpx;
}
.icon-arrow-right-small { width: 10rpx; height: 10rpx; border-top: 3.5rpx solid #8c8c8c; border-right: 3.5rpx solid #8c8c8c; transform: rotate(45deg); opacity: 0.4; }

.icon-morning { width: 32rpx; height: 32rpx; border: 4rpx solid #f59e0b; border-radius: 50%; position: relative; }
.icon-morning::after { content: ''; position: absolute; top: 10rpx; left: 10rpx; width: 12rpx; height: 12rpx; background: #f59e0b; border-radius: 50%; }
.icon-marathon { width: 32rpx; height: 40rpx; border: 4rpx solid #3c692b; border-radius: 6rpx; }
.icon-pen { width: 32rpx; height: 32rpx; border-bottom: 4rpx solid #8c8c8c; transform: rotate(-45deg); }

.icon-menu-notes { width: 28rpx; height: 36rpx; border: 3.5rpx solid currentColor; border-radius: 4rpx; }
.icon-menu-fav { width: 32rpx; height: 32rpx; background-color: currentColor; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); }
.icon-menu-history { width: 32rpx; height: 32rpx; border: 3.5rpx solid currentColor; border-radius: 50%; position: relative; }
.icon-menu-history::after { content: ''; position: absolute; top: 14rpx; left: 14rpx; width: 10rpx; height: 3.5rpx; background: currentColor; transform: rotate(-45deg); }
.icon-menu-settings { width: 32rpx; height: 32rpx; border: 3.5rpx solid currentColor; border-radius: 6rpx; }
.icon-menu-logout { width: 32rpx; height: 32rpx; border-left: 3.5rpx solid currentColor; border-top: 3.5rpx solid currentColor; border-bottom: 3.5rpx solid currentColor; position: relative; }
.icon-menu-logout::after { content: '→'; position: absolute; right: -10rpx; top: -10rpx; color: currentColor; font-size: 24rpx; }

/* Animations */
.fade-up {
  animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.d1 { animation-delay: 0ms; }
.d2 { animation-delay: 80ms; }
.d3 { animation-delay: 160ms; }
.d4 { animation-delay: 240ms; }
.d5 { animation-delay: 320ms; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Privacy/Profile Sheet */
.profile-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 3000;
  background: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: flex-end;
}

.profile-sheet {
  width: 100%;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  padding: 40rpx 40rpx calc(48rpx + env(safe-area-inset-bottom));
}

.sheet-bar {
  width: 80rpx;
  height: 8rpx;
  background-color: #f3efe8;
  border-radius: 99rpx;
  margin: 0 auto 32rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 900;
  color: #1b1b1b;
  text-align: center;
  margin-bottom: 48rpx;
}

.avatar-uploader {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
  background: none;
  line-height: normal;
  padding: 0;
}

.avatar-uploader::after { border: none; }

.uploader-inner {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #f3efe8;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
}

.uploader-inner image { width: 100%; height: 100%; }

.uploader-placeholder {
  font-size: 64rpx;
  color: #8c8c8c;
  font-weight: 300;
}

.uploader-hint {
  font-size: 24rpx;
  color: #8c8c8c;
  margin-top: 16rpx;
  font-weight: 700;
}

.input-group {
  margin-bottom: 48rpx;
}

.input-label {
  font-size: 24rpx;
  font-weight: 900;
  color: #1b1b1b;
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 16rpx;
  opacity: 0.6;
}

.input-field {
  width: 100%;
  height: 100rpx;
  background-color: #f3efe8;
  border-radius: 24rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #1b1b1b;
}

.btn-primary {
  background-color: #1b1b1b;
  color: #fff;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-primary:active {
  transform: scale(0.96);
}

.search-placeholder {
  color: #8c8c8c;
  font-weight: 500;
}

.safe-area-bottom {
  height: calc(140rpx + env(safe-area-inset-bottom));
}
