.settings-page {
  background: var(--bg-canvas);
  height: 100vh;
  overflow: hidden;
}

/* Custom Navigation Bar — matches book-detail */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: transparent;
  transition: background 0.2s ease, border-bottom 0.2s ease;
}

.nav--scrolled {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1rpx solid var(--hairline-soft);
}

.nav-inner {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.back-arrow {
  width: 22rpx;
  height: 22rpx;
  border-left: 3.5rpx solid var(--ink);
  border-bottom: 3.5rpx solid var(--ink);
  transform: rotate(45deg);
  margin-left: 14rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-right: calc(8rpx + 44px);
}

/* Scrollable body */
.content-body {
  height: 100vh;
  box-sizing: border-box;
}

/* Page header */
.page-header {
  padding: 0 40rpx 36rpx;
}

.page-heading {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink-deep);
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--stone);
  margin-top: 8rpx;
}

/* Sections */
.section {
  padding: 0 24rpx;
  margin-bottom: 8rpx;
}

.section:first-of-type {
  margin-top: 0;
}

.section-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--slate);
  letter-spacing: 1.5rpx;
  margin: 0 0 14rpx 12rpx;
}

/* Avatar row */
.avatar-row {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 4rpx 0;
  background: transparent;
  border: none;
}

.avatar-row::after {
  border: none;
}

.avatar-preview {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--bg-surface);
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.avatar-preview image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tint-sky);
}

.avatar-placeholder-text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--link-blue);
}

.avatar-meta {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.avatar-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.avatar-hint {
  font-size: 22rpx;
  color: var(--stone);
}

/* Row separator */
.row-separator {
  height: 1rpx;
  background: var(--hairline-soft);
  margin: 18rpx 0;
}

/* Nickname row */
.nickname-row {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
}

.nickname-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  width: 100rpx;
  flex-shrink: 0;
}

.nickname-input-wrap {
  flex: 1;
  margin-left: 16rpx;
}

.nickname-input {
  width: 100%;
  font-size: 28rpx;
  color: var(--ink);
  text-align: right;
  padding: 8rpx 0;
}

/* Chevron */
.chevron-right {
  width: 12rpx;
  height: 12rpx;
  border-right: 2.5rpx solid var(--muted);
  border-top: 2.5rpx solid var(--muted);
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* Save */
.save-area {
  padding: 40rpx 24rpx 32rpx;
}

.btn-save {
  width: 100%;
  height: 100rpx;
  background: var(--notion-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: opacity 0.15s ease;
}

.btn-save:active {
  opacity: 0.9;
}

.btn-save[disabled] {
  background: var(--hairline-strong);
  color: var(--stone);
}

/* Bottom safe area */
.bottom-safe {
  height: calc(48rpx + env(safe-area-inset-bottom));
}
