.settings-page {
  background: var(--bg-canvas);
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* Custom Navigation Bar — matches book-detail */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: transparent;
  transition: background 0.2s ease, border-bottom 0.2s ease;
}

.nav--scrolled {
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(12px);
  border-bottom: 1rpx solid var(--hairline-soft);
}

.nav-inner {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 8rpx;
  flex-shrink: 0;
}

.back-arrow {
  width: 22rpx;
  height: 22rpx;
  border-left: 3.5rpx solid var(--ink);
  border-bottom: 3.5rpx solid var(--ink);
  transform: rotate(45deg);
  margin-left: 14rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-right: calc(8rpx + 44px);
}

/* Scrollable body */
.content-body {
  flex: 1;
  height: 0;
  min-height: 0;
  box-sizing: border-box;
}

/* Page header */
.page-header {
  padding: 0 40rpx 36rpx;
}

.page-heading {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink-deep);
  letter-spacing: -0.5rpx;
  line-height: 1.2;
}

.page-subtitle {
  display: block;
  font-size: 26rpx;
  color: var(--stone);
  margin-top: 8rpx;
}

/* Sections */
.section {
  padding: 0 24rpx;
  margin-bottom: 8rpx;
}

.section:first-of-type {
  margin-top: 0;
}

.section-label {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--slate);
  letter-spacing: 1.5rpx;
  margin: 0 0 14rpx 12rpx;
}

/* Avatar row */
.avatar-row {
  display: flex;
  align-items: center;
  width: 100%;
  padding: 4rpx 0;
  background: transparent;
  border: none;
}

.avatar-row::after {
  border: none;
}

.avatar-row--privacy {
  min-height: 96rpx;
}

.avatar-preview {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--bg-surface);
  flex-shrink: 0;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.avatar-preview image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--tint-sky);
}

.avatar-placeholder-text {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--link-blue);
}

.avatar-meta {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}

.avatar-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

.avatar-hint {
  font-size: 22rpx;
  color: var(--stone);
}

.privacy-inline-btn {
  width: 116rpx;
  height: 58rpx;
  margin: 0 0 0 16rpx;
  padding: 0;
  border-radius: 16rpx;
  background: var(--accent, #2f6b3f);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 58rpx;
}

.privacy-inline-btn::after {
  border: none;
}

.privacy-contract-link {
  margin: 16rpx 0 0 112rpx;
  font-size: 22rpx;
  color: var(--link-blue);
}

/* Row separator */
.row-separator {
  height: 1rpx;
  background: var(--hairline-soft);
  margin: 18rpx 0;
}

/* Nickname row */
.nickname-row {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
}

.nickname-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  width: 100rpx;
  flex-shrink: 0;
}

.nickname-input-wrap {
  flex: 1;
  margin-left: 16rpx;
}

.nickname-input {
  width: 100%;
  font-size: 28rpx;
  color: var(--ink);
  text-align: right;
  padding: 8rpx 0;
}

/* Chevron */
.chevron-right {
  width: 12rpx;
  height: 12rpx;
  border-right: 2.5rpx solid var(--muted);
  border-top: 2.5rpx solid var(--muted);
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* Save */
.save-area {
  padding: 40rpx 24rpx 32rpx;
}

.btn-save {
  width: 100%;
  height: 100rpx;
  background: var(--notion-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: opacity 0.15s ease;
}

.btn-save:active {
  opacity: 0.9;
}

.btn-save[disabled] {
  background: var(--hairline-strong);
  color: var(--stone);
}

/* Bottom safe area */
.bottom-safe {
  height: calc(48rpx + env(safe-area-inset-bottom));
}

/* Logout */
.logout-area {
  padding: 16rpx 24rpx 0;
}

.btn-logout {
  width: 100%;
  height: 96rpx;
  background: transparent;
  color: var(--danger, #e74c3c);
  font-size: 28rpx;
  font-weight: 500;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1.5rpx solid var(--hairline-strong, #e0e0e0);
}

.btn-logout:active {
  background: rgba(231, 76, 60, 0.06);
}

/* 横屏 Pad：账号设置不再让手机稿 rpx 随窗口宽度放大。 */
.settings-page--large .nav-inner {
  padding: 0 24px;
}

.settings-page--large .nav-back {
  margin-left: 0;
}

.settings-page--large .back-arrow {
  width: 10px;
  height: 10px;
  margin-left: 0;
  border-left-width: 2px;
  border-bottom-width: 2px;
}

.settings-page--large .nav-title {
  font-size: 16px;
  margin-right: 40px;
}

.settings-page--large .settings-content {
  width: 100%;
  max-width: 720px;
  margin: 0 auto;
  padding: 0 24px;
  box-sizing: border-box;
}

.settings-page--large .page-header {
  padding: 0 8px 20px;
}

.settings-page--large .page-heading {
  font-size: 26px;
  letter-spacing: -0.4px;
}

.settings-page--large .page-subtitle {
  margin-top: 5px;
  font-size: 14px;
}

.settings-page--large .section {
  padding: 0;
  margin-bottom: 0;
}

.settings-page--large .section-label {
  margin: 0 0 8px 6px;
  font-size: 12px;
  letter-spacing: 0.8px;
}

.settings-page--large .card-base {
  padding: 18px;
  border-radius: 12px;
}

.settings-page--large .avatar-row--privacy {
  min-height: 56px;
}

.settings-page--large .avatar-preview {
  width: 52px;
  height: 52px;
}

.settings-page--large .avatar-placeholder-text {
  font-size: 22px;
}

.settings-page--large .avatar-meta {
  margin-left: 14px;
  gap: 1px;
}

.settings-page--large .avatar-label,
.settings-page--large .nickname-label,
.settings-page--large .nickname-input {
  font-size: 16px;
}

.settings-page--large .avatar-hint,
.settings-page--large .privacy-contract-link {
  font-size: 12px;
}

.settings-page--large .privacy-inline-btn {
  width: 62px;
  height: 34px;
  margin-left: 10px;
  border-radius: 8px;
  font-size: 13px;
  line-height: 34px;
}

.settings-page--large .privacy-contract-link {
  margin: 10px 0 0 66px;
}

.settings-page--large .row-separator {
  margin: 12px 0;
}

.settings-page--large .nickname-row {
  padding: 2px 0;
}

.settings-page--large .nickname-label {
  width: 60px;
}

.settings-page--large .nickname-input-wrap {
  margin-left: 12px;
}

.settings-page--large .nickname-input {
  padding: 5px 0;
}

.settings-page--large .chevron-right {
  width: 7px;
  height: 7px;
  border-right-width: 1.5px;
  border-top-width: 1.5px;
}

.settings-page--large .save-area {
  padding: 20px 0 14px;
}

.settings-page--large .btn-save,
.settings-page--large .btn-logout {
  height: 46px;
  border-radius: 10px;
  font-size: 16px;
}

.settings-page--large .logout-area {
  padding: 0;
}

.settings-page--large .bottom-safe {
  height: calc(64px + env(safe-area-inset-bottom));
}
