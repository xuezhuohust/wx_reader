<view class="page-shell settings-page {{isLargeScreen ? 'settings-page--large' : ''}}" style="{{windowHeight ? 'height: ' + windowHeight + 'px;' : ''}}">
  <view class="custom-nav {{scrolled ? 'nav--scrolled' : ''}}" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="nav-back" bindtap="handleBack" style="width: {{menuHeight}}px; height: {{menuHeight}}px;">
        <view class="back-arrow"></view>
      </view>
      <view class="nav-title" wx:if="{{scrolled}}">Account Settings</view>
    </view>
  </view>

  <scroll-view
    class="content-body"
    scroll-y
    enhanced
    show-scrollbar="{{false}}"
    style="padding-top: {{navBarHeight + 24}}px;"
    bindscroll="handleScroll"
  >
    <view class="settings-content">
      <view class="page-header">
        <text class="page-heading">Account Settings</text>
        <text class="page-subtitle">Manage researcher profile & session</text>
      </view>

      <view class="section">
        <view class="section-label">Researcher Profile</view>
        <view class="card-base">
        <view wx:if="{{!profilePrivacyAgreed}}" class="avatar-row avatar-row--privacy">
          <view class="avatar-preview">
            <image wx:if="{{identity && identity.avatarUrl}}" src="{{identity.avatarUrl}}" mode="aspectFill" />
            <view wx:else class="avatar-placeholder">
              <text class="avatar-placeholder-text">{{placeholderInitial}}</text>
            </view>
          </view>
          <view class="avatar-meta">
            <text class="avatar-label">Avatar</text>
            <text class="avatar-hint">同意{{privacyContractName}}后可选择微信头像</text>
          </view>
          <button class="privacy-inline-btn" open-type="agreePrivacyAuthorization" bindagreeprivacyauthorization="handleAgreeProfilePrivacy">同意</button>
        </view>

        <button wx:else class="avatar-row" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" disabled="{{avatarUploading}}">
          <view class="avatar-preview">
            <image wx:if="{{identity && identity.avatarUrl}}" src="{{identity.avatarUrl}}" mode="aspectFill" />
            <view wx:else class="avatar-placeholder">
              <text class="avatar-placeholder-text">{{placeholderInitial}}</text>
            </view>
          </view>
          <view class="avatar-meta">
            <text class="avatar-label">Avatar</text>
            <text class="avatar-hint">{{avatarUploading ? '头像上传中...' : '支持 JPG、PNG、WebP 格式'}}</text>
          </view>
          <view class="chevron-right"></view>
        </button>
        <view wx:if="{{!profilePrivacyAgreed}}" class="privacy-contract-link" bindtap="handleOpenPrivacyContract">查看隐私保护指引</view>

        <view class="row-separator"></view>

        <view class="nickname-row">
          <text class="nickname-label">Display Name</text>
          <view class="nickname-input-wrap">
            <input
              class="nickname-input"
              type="text"
              value="{{nicknameDraft}}"
              placeholder="Enter your name"
              placeholder-style="color:var(--muted);"
              bindinput="handleNicknameDraftInput"
              maxlength="20"
            />
          </view>
        </view>
        </view>
      </view>

      <view class="save-area">
        <button class="btn-save" bindtap="handleSave" disabled="{{saving}}">
          {{saving ? 'Saving...' : 'Save Changes'}}
        </button>
      </view>

      <view class="logout-area">
        <button class="btn-logout" bindtap="handleLogout">Sign Out</button>
      </view>

      <view class="bottom-safe"></view>
    </view>
  </scroll-view>
</view>
