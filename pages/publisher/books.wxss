.page-shell {
  background: var(--bg-canvas);
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

/* Custom Navigation Bar */
.custom-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid var(--hairline-soft);
}

.nav-inner {
  position: absolute;
  left: 0; right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.content-wrap {
  padding: 0 32rpx 40rpx;
}

.page-header {
  padding: 40rpx 0 40rpx;
}

.intro-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #f5f3ff;
  color: #7b3ff2;
  font-size: 18rpx;
  font-weight: 700;
  border-radius: var(--radius-sm);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
}

.header-desc {
  font-size: 26rpx;
  color: var(--stone);
  margin-top: 12rpx;
  display: block;
}

/* Ops Grid */
.ops-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 60rpx;
}

.ops-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx;
  gap: 16rpx;
  background: #ffffff;
}

.ops-icon-box {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.ops-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}

.section-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--slate);
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

.count-badge {
  font-size: 18rpx;
  font-weight: 700;
  color: var(--stone);
  background: var(--bg-surface-soft);
  padding: 4rpx 12rpx;
  border-radius: var(--radius-full);
}

/* Search */
.search-container {
  margin-bottom: 40rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #ffffff;
  border: 1rpx solid var(--hairline-soft);
  border-radius: var(--radius-lg);
  padding: 0 24rpx;
  height: 88rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.02);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  margin-left: 16rpx;
}

/* Book List */
.publisher-book-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.publisher-book-card {
  background: #ffffff;
  border-radius: var(--radius-xl);
  padding: 32rpx;
  border: 1rpx solid var(--hairline-soft);
}

.card-main {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.book-cover-mini {
  width: 100rpx;
  height: 140rpx;
  background: var(--bg-surface-soft);
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.cover-img {
  width: 100%;
  height: 100%;
}

.book-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.book-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.status-indicator {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.status-online { background: var(--semantic-success); }
.status-offline { background: var(--muted); }

.book-author {
  font-size: 24rpx;
  color: var(--slate);
  margin-bottom: 16rpx;
}

.tag-row {
  display: flex;
  gap: 12rpx;
}

.mini-tag {
  font-size: 18rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: var(--radius-xs);
}

.tag-peach { background: #ffe8d4; color: #dd5b00; }
.tag-mint { background: #d9f3e1; color: #1aae39; }
.tag-gray { background: #f0f0f0; color: #888; }

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--hairline-soft);
}

.footer-meta {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.meta-price {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.meta-date {
  font-size: 20rpx;
  color: var(--stone);
}

.btn-action {
  font-size: 24rpx;
  font-weight: 600;
  padding: 12rpx 32rpx;
  border-radius: var(--radius-full);
  margin: 0;
  line-height: 1.5;
}

.btn-outline-primary {
  background: #f5f3ff;
  color: #7b3ff2;
  border: 1rpx solid #e6e0f5;
}

.btn-outline-danger {
  background: #fff5f5;
  color: var(--semantic-error);
  border: 1rpx solid #ffe3e3;
}

.icon-svg {
  width: 40rpx;
  height: 40rpx;
}

.icon-search-gray {
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%23a4a097" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>');
}

.icon-book-muted {
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%23bbb8b1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>');
}