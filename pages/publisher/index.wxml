<view class="page-shell">
  <!-- Custom Navigation Bar (Transparent for Hero) -->
  <view class="custom-nav nav-dark" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <!-- Title removed per user request -->
    </view>
  </view>

  <scroll-view class="content-wrap" scroll-y enhanced show-scrollbar="{{false}}" style="padding-top: {{navBarHeight + 10}}px;">
    <!-- Hero Band Section -->
    <view class="hero-band-dark">
      <view class="hero-content">
        <view class="hero-title-wrap">
          <text class="hero-title">{{publisher.name || 'Analytics & Metrics'}}</text>
        </view>
        <text class="hero-desc">Real-time surveillance of corpus ingestion and interactive telemetry.</text>
      </view>

      <!-- Floating Metrics: Positioned on the edge -->
      <view class="floating-metrics">
        <view class="metric-item">
          <text class="m-label">Corpus Volume</text>
          <view class="m-value-row">
            <text class="m-value">{{stats.totalBooks || 0}}</text>
            <text class="m-unit">docs</text>
          </view>
          <text class="m-sub">Published {{stats.totalBooks || 0}}</text>
        </view>
        <view class="m-divider"></view>
        <view class="metric-item">
          <text class="m-label">QA Queries</text>
          <view class="m-value-row">
            <text class="m-value">{{stats.totalChatCount || 0}}</text>
            <text class="m-unit">reqs</text>
          </view>
          <text class="m-sub">Activity 100%</text>
        </view>
      </view>
    </view>

    <!-- Charts and other content -->
    <view class="main-content">

    <!-- Chart Section: Activity Trend -->
    <view class="chart-section card-base">
      <view class="chart-header">
        <view class="chart-title-wrap">
          <text class="chart-title">Interaction Telemetry</text>
          <text class="chart-subtitle">7-day QA query volume</text>
        </view>
        <view class="chart-legend">
          <view class="legend-item">
            <view class="legend-dot bg-publisher"></view>
            <text>Queries</text>
          </view>
        </view>
      </view>
      <view class="chart-body">
        <view class="bar-chart">
          <view wx:for="{{activityData}}" wx:key="day" class="bar-item">
            <view class="bar-fill-wrap">
              <view class="bar-fill bg-publisher" style="height: {{item.value / maxActivity * 100}}%"></view>
            </view>
            <text class="bar-label">{{item.day}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Status Visualization -->
    <view class="viz-section card-base tint-gray">
      <view class="viz-header">
        <text class="viz-title">Indexing Pipeline Status</text>
      </view>
      <view class="viz-content">
        <view class="viz-row">
          <text class="viz-label">Indexed Documents</text>
          <view class="viz-bar-wrap">
            <view class="viz-bar-fill bg-publisher" style="width: {{stats.totalBooks ? (stats.builtCount/stats.totalBooks*100) : 0}}%"></view>
          </view>
          <text class="viz-value">{{stats.builtCount || 0}}</text>
        </view>
        <view class="viz-row">
          <text class="viz-label">Queued Tasks</text>
          <view class="viz-bar-wrap">
            <view class="viz-bar-fill chart-3" style="width: {{stats.totalBooks ? (stats.pendingCount/stats.totalBooks*100) : 0}}%"></view>
          </view>
          <text class="viz-value">{{stats.pendingCount || 0}}</text>
        </view>
      </view>
    </view>

    <!-- Quick Actions (Designed as the user requested) -->
    <view class="quick-actions">
      <view class="section-header">
        <text class="section-title">Operations</text>
      </view>
      <view class="actions-grid">
        <view wx:for="{{entries}}" wx:key="title" class="action-card card-base {{item.tintClass}}" bindtap="handleEntryTap" data-path="{{item.path}}" data-type="{{item.type}}">
          <view class="action-icon-wrap">
            <view class="icon-svg {{item.iconClass}}"></view>
          </view>
          <view class="action-info">
            <text class="action-title">{{item.title}}</text>
            <text class="action-desc">{{item.desc}}</text>
          </view>
          <view class="chevron-right-mini"></view>
        </view>
      </view>
    </view>

    <!-- Operational Activity (Simplified for Dashboard) -->
    <view class="activity-section">
      <view class="section-header">
        <text class="section-title">Corpus Workspace</text>
      </view>
      <view class="activity-card card-base" bindtap="handleGoBooks">
        <view class="activity-info">
          <text class="activity-t">Inventory Roster</text>
          <text class="activity-d">Manage document status & vector indices</text>
        </view>
        <view class="chevron-right-mini"></view>
      </view>
    </view>

    <!-- Switch Back Button (Moved to Bottom of Dashboard) -->
    <view class="switch-back-section">
      <button class="btn-switch-back" bindtap="handleSwitchToReader">
        Exit Management Mode
      </button>
    </view>
    </view>
  </scroll-view>
</view>
