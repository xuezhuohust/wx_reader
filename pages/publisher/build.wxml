<view class="page-shell">
  <view class="page-intro">
    <view class="intro-eyebrow">
      <text>任务中心 · AI 结构化</text>
    </view>
    <text class="page-intro-title text-serif">知识库构建任务</text>
    <text class="page-intro-desc">这里展示了后端正在执行的文档解析、章节结构化和知识库转换任务的真实进度。</text>
  </view>

  <view class="build-list">
    <view wx:for="{{books}}" wx:key="id" class="build-card card-panel">
      <view class="build-top">
        <view>
          <text class="build-title">{{item.title}}</text>
          <text class="build-author">{{item.author}}</text>
        </view>
        <status-tag type="build" status="{{item.buildStatus || ''}}" />
      </view>

      <view class="build-progress-wrap">
        <progress
          percent="{{item.buildProgress}}"
          stroke-width="8"
          active="{{item.buildStatus === 'building'}}"
          activeColor="#c2410c"
          backgroundColor="#f0ede4"
        />
        <text class="build-progress-text">当前进度 {{item.buildProgress}}%</text>
        <text wx:if="{{item.buildStage}}" class="build-stage">{{item.buildStage}}</text>
        <text wx:if="{{item.taskId}}" class="build-task-id">任务编号 {{item.taskId}}</text>
        <text wx:if="{{item.buildError}}" class="build-error">{{item.buildError}}</text>
      </view>

      <view class="build-bottom">
        <text class="build-meta">{{item.category}} · {{item.publisher}}{{item.taskId ? ' · 任务 ' + item.taskId : ''}}</text>
        <button
          wx:if="{{item.buildStatus === 'none' || item.buildStatus === 'failed'}}"
          class="build-btn"
          data-id="{{item.id}}"
          bindtap="handleStartBuild"
        >
          {{item.buildStatus === 'failed' ? '重新建库' : '开始建库'}}
        </button>
        <text wx:elif="{{item.buildStatus === 'building'}}" class="build-running">任务进行中...</text>
        <text wx:else class="build-done">建库可用于 AI 对话</text>
      </view>
    </view>
  </view>
</view>
