<view class="page-shell">
  <!-- Custom Navigation Bar -->
  <view class="custom-nav" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="nav-left" bindtap="handleBack">
        <view class="chevron-left-black"></view>
      </view>
      <text class="nav-title">Indexing Pipeline</text>
    </view>
  </view>

  <scroll-view class="content-wrap" scroll-y enhanced show-scrollbar="{{false}}" style="padding-top: {{navBarHeight}}px;">
    <view class="page-header">
      <view class="header-intro">
        <view class="intro-badge">
          <text>TASK TRACKING</text>
        </view>
        <text class="header-title">Vector Index Pipeline</text>
        <text class="header-desc">Track manuscript parsing, embedding, and vector index builds</text>
      </view>
    </view>

  <view class="build-list">
    <view wx:for="{{books}}" wx:key="id" class="build-card card-base">
      <view class="build-card-header">
        <view class="header-main">
          <text class="book-title">{{item.title}}</text>
          <text class="book-author">{{item.author}}</text>
        </view>
        <view class="status-badge {{item.buildStatus === 'building' ? 'badge-processing' : (item.buildStatus === 'completed' ? 'badge-done' : 'badge-pending')}}">
          {{item.buildStatus === 'building' ? 'Parsing' : (item.buildStatus === 'completed' ? 'Indexed' : 'Queued')}}
        </view>
      </view>

      <view class="build-content">
        <view class="progress-section">
          <view class="progress-header">
            <text class="progress-label">{{item.buildStage || 'Ready'}}</text>
            <text class="progress-value">{{item.buildProgress || 0}}%</text>
          </view>
          <view class="progress-bar-bg">
            <view class="progress-bar-fill" style="width: {{item.buildProgress || 0}}%"></view>
          </view>
        </view>

        <view class="error-box" wx:if="{{item.buildError}}">
          <view class="icon-svg icon-error-red"></view>
          <text class="error-msg">{{item.buildError}}</text>
        </view>
      </view>

      <view class="build-card-footer">
        <view class="footer-info">
          <text class="info-item">{{item.category}}</text>
          <text class="info-item" wx:if="{{item.taskId}}">ID: {{item.taskId}}</text>
        </view>
        
        <button
          wx:if="{{item.buildStatus === 'none' || item.buildStatus === 'failed'}}"
          class="btn-build-action"
          data-id="{{item.id}}"
          bindtap="handleStartBuild"
        >
          {{item.buildStatus === 'failed' ? 'Retry' : 'Start Pipeline'}}
        </button>
        <view wx:elif="{{item.buildStatus === 'building'}}" class="running-indicator">
          <view class="dot-loading"></view>
          <text>Constructing semantic vector embeddings...</text>
        </view>
        <view wx:else class="success-indicator">
          <view class="icon-svg icon-check-green"></view>
          <text>Knowledge index completed</text>
        </view>
      </view>
    </view>
  </view>

  <empty-state
    wx:if="{{!books.length}}"
    title="Pipeline Queue Empty"
    description="Tasks will appear here once manuscripts are ingested."
  />
  </scroll-view>
</view>
