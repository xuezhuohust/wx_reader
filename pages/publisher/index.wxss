.page-shell {
  background: var(--bg-canvas);
}

.content-wrap {
  height: 100vh;
}

/* Custom Navigation Bar */
.custom-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid var(--hairline-soft);
  transition: all 0.3s ease;
}

.custom-nav.nav-dark {
  background: transparent;
  border-bottom: none;
}

.custom-nav.nav-dark .nav-title {
  color: #ffffff;
}

.nav-inner {
  position: absolute;
  left: 0; right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
}

/* Hero Band Dark */
.hero-band-dark {
  background-color: var(--theme-publisher);
  padding: 0 40rpx 0;
  position: relative;
  overflow: visible; /* Changed to visible for floating effect */
  color: #ffffff;
  height: 440rpx; /* Fixed height to control overlap */
}

.hero-content {
  position: relative;
  z-index: 2;
  padding-bottom: 40rpx;
}

/* Floating Metrics Design */
.floating-metrics {
  position: absolute;
  bottom: 0;
  left: 32rpx;
  right: 32rpx;
  transform: translateY(50%); /* Move to middle of the divider */
  background: #ffffff;
  border-radius: var(--radius-lg);
  padding: 40rpx 0;
  display: flex;
  align-items: center;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid var(--hairline);
  z-index: 20;
}

.metric-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.m-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--hairline);
}

.m-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--stone);
  margin-bottom: 12rpx;
}

.m-value-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.m-value {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink);
}

.m-unit {
  font-size: 20rpx;
  color: var(--stone);
}

.m-sub {
  font-size: 20rpx;
  color: var(--muted);
}

.main-content {
  margin-top: 100rpx; /* Adjusted for floating metrics overlap */
  position: relative;
  z-index: 10;
}

.page-intro {
  padding: 40rpx 0 64rpx;
  background: transparent;
}

.intro-eyebrow {
  margin-bottom: 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--theme-publisher);
  text-transform: uppercase;
  letter-spacing: 0.15em;
}

.page-intro-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
  line-height: 1.2;
}

.page-intro-desc {
  font-size: 26rpx;
  color: var(--slate);
  margin-top: 20rpx;
  display: block;
  line-height: 1.6;
}

/* Metrics Grid */
.metrics-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.metric-card {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  border: none;
}

.tint-mint { background-color: var(--tint-mint); }
.tint-sky { background-color: var(--tint-sky); }
.tint-gray { background-color: var(--tint-gray); }
.tint-peach { background-color: var(--tint-peach); }
.tint-lavender { background-color: var(--tint-lavender); }

/* Chart Section */
.chart-section {
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
}

.chart-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 48rpx;
}

.chart-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
}

.chart-subtitle {
  font-size: 22rpx;
  color: var(--stone);
  margin-top: 4rpx;
  display: block;
}

.chart-legend {
  display: flex;
  gap: 20rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--slate);
}

.legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
}

.chart-body {
  height: 240rpx;
}

.bar-chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  height: 100%;
  padding: 0 10rpx;
}

.bar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  flex: 1;
}

.bar-fill-wrap {
  width: 32rpx;
  height: 180rpx;
  background: var(--bg-surface-soft);
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.bar-fill {
  width: 100%;
  border-radius: 6rpx;
  transition: height 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.bar-label {
  font-size: 20rpx;
  color: var(--stone);
}

/* Quick Actions Grid */
.quick-actions {
  margin-bottom: 60rpx;
}

.actions-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20rpx;
}

.action-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border: none;
}

.action-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.action-info {
  flex: 1;
}

.action-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
}

.action-desc {
  font-size: 22rpx;
  color: var(--slate);
  margin-top: 4rpx;
  display: block;
}

/* Chart Colors */
.chart-1 { background-color: var(--chart-1); }
.chart-2 { background-color: var(--chart-2); }
.chart-3 { background-color: var(--chart-3); }
.bg-publisher { background-color: var(--theme-publisher); }

.icon-library-publisher {
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%230a7869" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>');
}

.icon-chat-publisher {
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%230a7869" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>');
}

/* Viz Section */
.viz-section {
  padding: 40rpx 32rpx;
  margin-bottom: 40rpx;
  border: none;
}

.viz-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--slate);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  display: block;
  margin-bottom: 40rpx;
}

.viz-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.viz-label {
  font-size: 24rpx;
  color: var(--slate);
  width: 140rpx;
}

.viz-bar-wrap {
  flex: 1;
  height: 12rpx;
  background: rgba(255, 255, 255, 0.5);
  border-radius: 6rpx;
  overflow: hidden;
}

.viz-bar-fill {
  height: 100%;
  border-radius: 6rpx;
}

.viz-value {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
  width: 40rpx;
  text-align: right;
}

/* Section Header */
.section-header {
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.section-title {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--stone);
  text-transform: uppercase;
  letter-spacing: 2rpx;
}

/* Activity Card */
.activity-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
}

.activity-t {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
}

.activity-d {
  font-size: 22rpx;
  color: var(--stone);
  margin-top: 4rpx;
  display: block;
}

.icon-library-teal {
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%233c692b" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>');
}

.icon-chat-blue {
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%233b82f6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>');
}
