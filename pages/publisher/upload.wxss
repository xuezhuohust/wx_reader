.page-shell {
  background: var(--bg-canvas);
}

/* Custom Navigation Bar */
.custom-nav {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 1000;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid var(--hairline-soft);
}

.nav-inner {
  position: absolute;
  left: 0; right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-left {
  position: absolute;
  left: 32rpx;
  height: 100%;
  display: flex;
  align-items: center;
  padding-right: 40rpx;
}

.chevron-left-black {
  width: 20rpx;
  height: 20rpx;
  border-left: 4rpx solid #1a1a1a;
  border-bottom: 4rpx solid #1a1a1a;
  transform: rotate(45deg);
}

.nav-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
  letter-spacing: 1rpx;
}

.content-wrap {
  padding: 0 32rpx 40rpx;
  height: 100vh;
}

.page-header {
  padding: 40rpx 0 40rpx;
}

.intro-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #e0f2fe;
  color: #0075de;
  font-size: 18rpx;
  font-weight: 700;
  border-radius: var(--radius-sm);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--ink);
  display: block;
}

.header-desc {
  font-size: 26rpx;
  color: var(--stone);
  margin-top: 12rpx;
  display: block;
}

.upload-form {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.form-group {
  padding: 0 32rpx;
  background: #ffffff;
  border-radius: var(--radius-xl);
  border: 1rpx solid var(--hairline-soft);
}

.form-item {
  padding: 32rpx 0;
  border-bottom: 1rpx solid var(--hairline-soft);
}

.form-item:last-child {
  border-bottom: none;
}

.no-border {
  border-bottom: none !important;
}

.form-label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--slate);
  text-transform: uppercase;
  letter-spacing: 1rpx;
  margin-bottom: 16rpx;
}

.form-input {
  font-size: 30rpx;
  color: var(--ink);
  width: 100%;
}

.form-textarea {
  font-size: 30rpx;
  color: var(--ink);
  width: 100%;
  height: 160rpx;
  line-height: 1.6;
}

.picker-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-value {
  font-size: 30rpx;
  color: var(--ink);
}

.chevron-down-mini {
  width: 10rpx;
  height: 10rpx;
  border-right: 3rpx solid var(--muted);
  border-bottom: 3rpx solid var(--muted);
  transform: rotate(45deg);
}

.file-upload-section {
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
  background: #f8fafc;
  border: 2rpx dashed var(--hairline-strong);
  border-radius: var(--radius-xl);
  transition: all 0.2s ease;
}

.file-ready {
  background: #f0fdf4;
  border-style: solid;
  border-color: #bbf7d0;
}

.upload-icon-box {
  width: 80rpx;
  height: 80rpx;
  background: #ffffff;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.upload-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.upload-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.upload-hint {
  font-size: 22rpx;
  color: var(--stone);
}

.cover-preview {
  width: 120rpx;
  height: 160rpx;
  border-radius: var(--radius-lg);
  margin-right: 24rpx;
  object-fit: cover;
}

.submit-section {
  margin-top: 40rpx;
  padding-bottom: 80rpx;
}

.btn-submit {
  background: var(--notion-primary);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 28rpx 0;
  border-radius: var(--radius-xl);
  width: 100%;
  box-shadow: 0 8rpx 24rpx rgba(60, 105, 43, 0.2);
}

.btn-submit:active {
  background: var(--notion-primary-pressed);
  transform: translateY(2rpx);
}

.icon-svg {
  width: 44rpx;
  height: 44rpx;
}

.icon-upload-cloud {
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%230075de" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>');
}

.icon-file-ready {
  background-image: url('data:image/svg+xml,<svg viewBox="0 0 24 24" fill="none" stroke="%231aae39" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>');
}

.privacy-overlay {
  position: fixed;
  inset: 0;
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(15, 23, 42, 0.45);
}

.privacy-sheet {
  width: 100%;
  max-width: 640rpx;
  padding: 36rpx;
  background: #ffffff;
  border-radius: 24rpx;
}

.privacy-header {
  margin-bottom: 20rpx;
}

.privacy-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--ink);
}

.privacy-content {
  margin-bottom: 28rpx;
}

.privacy-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--slate);
}

.privacy-actions {
  display: flex;
  gap: 20rpx;
}

.privacy-actions button {
  flex: 1;
}
