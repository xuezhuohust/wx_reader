<view class="page-shell">
  <view class="custom-nav" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="nav-left" bindtap="handleBack">
        <view class="chevron-left-black"></view>
      </view>
      <text class="nav-title">编辑书籍</text>
    </view>
  </view>

  <scroll-view class="content-wrap" scroll-y enhanced show-scrollbar="{{false}}" style="padding-top: {{navBarHeight}}px;">
  <view class="upload-form">
    <view class="form-group card-base">
      <view class="form-item">
        <text class="form-label">书籍名称</text>
        <input class="form-input" value="{{form.title}}" data-field="title" bindinput="handleInput" placeholder="请输入书名" />
      </view>
      <view class="form-item">
        <text class="form-label">作者/编著者</text>
        <input class="form-input" value="{{form.author}}" data-field="author" bindinput="handleInput" placeholder="请输入作者" />
      </view>
      <view class="form-item">
        <text class="form-label">出版单位</text>
        <input class="form-input" value="{{form.publisher}}" data-field="publisher" bindinput="handleInput" placeholder="请输入出版社" />
      </view>
      <view class="form-item">
        <text class="form-label">内容分类</text>
        <picker class="form-picker" range="{{categories}}" value="{{categoryIndex}}" bindchange="handleCategoryChange">
          <view class="picker-inner">
            <text class="picker-value">{{form.category || '请选择分类'}}</text>
            <view class="chevron-down-mini"></view>
          </view>
        </picker>
      </view>
    </view>

    <view class="form-group card-base">
      <view class="form-item">
        <text class="form-label">内容简介</text>
        <textarea class="form-textarea" value="{{form.description}}" data-field="description" bindinput="handleInput" placeholder="请输入书籍核心内容简介" />
      </view>
      <view class="form-item">
        <text class="form-label">定价 (元)</text>
        <input class="form-input" value="{{form.price}}" data-field="price" bindinput="handleInput" placeholder="0.00" type="digit" />
      </view>
      <view class="form-item no-border">
        <text class="form-label">版权及权利声明</text>
        <textarea class="form-textarea" value="{{form.copyright}}" data-field="copyright" bindinput="handleInput" placeholder="请输入版权归属及授权说明" />
      </view>
    </view>

    <view class="file-upload-section card-base {{coverPath || form.cover_url ? 'file-ready' : ''}}" bindtap="handleChooseCover">
      <block wx:if="{{coverPath || form.cover_url}}">
        <image class="cover-preview" src="{{coverPath || form.cover_url}}" mode="aspectFill" />
        <view class="upload-info">
          <text class="upload-title">点击更换封面</text>
          <text class="upload-hint">支持 jpg / png / webp</text>
        </view>
      </block>
      <block wx:else>
        <view class="upload-icon-box">
          <view class="icon-svg icon-upload-cloud"></view>
        </view>
        <view class="upload-info">
          <text class="upload-title">点击上传封面图片</text>
          <text class="upload-hint">支持 jpg / png / webp，≤5MB</text>
        </view>
      </block>
    </view>

    <view class="submit-section">
      <button class="btn-submit" bindtap="handleSubmit">保存修改</button>
    </view>
  </view>
  </scroll-view>
</view>