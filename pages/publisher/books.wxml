<view class="page-shell">
  <!-- Custom Navigation Bar -->
  <view class="custom-nav" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <text class="nav-title">Corpus Operations</text>
    </view>
  </view>

  <scroll-view class="content-wrap" scroll-y enhanced show-scrollbar="{{false}}" style="padding-top: {{navBarHeight}}px;">
    <view class="page-header">
      <view class="header-intro">
        <view class="intro-badge">
          <text>OPERATIONS</text>
        </view>
        <text class="header-title">Corpus Asset Overview</text>
        <text class="header-desc">Manage ingestion, vector indexing, and publication</text>
      </view>
    </view>

  <!-- Quick Operations -->
  <view class="ops-grid">
    <view class="ops-item card-base" bindtap="handleGoUpload">
      <view class="ops-icon-box tint-sky">
        <view class="icon-svg icon-upload-blue"></view>
      </view>
      <text class="ops-label">Ingest Document</text>
    </view>
    <view class="ops-item card-base" bindtap="handleGoBuild">
      <view class="ops-icon-box tint-lavender">
        <view class="icon-svg icon-build-purple"></view>
      </view>
      <text class="ops-label">Index Queue</text>
    </view>
  </view>

  <view class="section-title-row">
    <text class="section-title">Corpus Inventory</text> 
    <text class="count-badge">{{filteredBooks.length}}</text>
  </view>

  <view class="search-container">
    <view class="search-bar">
      <view class="icon-svg icon-search-gray"></view>
      <input
        class="search-input"
        placeholder="Search title, author, field..."
        placeholder-style="color:var(--stone);"
        value="{{searchValue}}"
        bindinput="handleSearchInput"
      />
    </view>
  </view>

  <view wx:if="{{filteredBooks.length}}" class="publisher-book-list">
    <view
      wx:for="{{filteredBooks}}"
      wx:key="id"
      class="publisher-book-card card-base"
      data-id="{{item.id}}"
      bindtap="handleBookTap"
    >
      <view class="card-main">
        <view class="book-cover-mini">
          <image wx:if="{{item.coverUrl}}" src="{{item.coverUrl}}" mode="aspectFill" class="cover-img" />
          <view wx:else class="icon-svg icon-book-muted"></view>
        </view>
        <view class="book-details">
          <view class="title-row">
            <text class="book-title">{{item.title}}</text>
            <view class="status-indicator {{item.onlineStatus === 'online' ? 'status-online' : 'status-offline'}}"></view>
          </view>
          <text class="book-author">{{item.author}}</text>
          
          <view class="tag-row">
            <view class="mini-tag tag-peach" wx:if="{{item.category}}">{{item.category}}</view>
            <view class="mini-tag {{item.buildStatus === 'completed' ? 'tag-mint' : 'tag-gray'}}">
              {{item.buildStatus === 'completed' ? 'Indexed' : 'Pending'}}
            </view>
          </view>
        </view>
      </view>

      <view class="card-footer">
        <view class="footer-meta">
          <text class="meta-price">¥{{item.price}}</text>
          <text class="meta-date">{{item.uploadTime}}</text>
        </view>
        <view class="action-buttons">
          <button
            class="btn-action btn-outline-default"
            catchtap="handleEditBook"
            data-id="{{item.id}}"
          >Edit</button>
          <button
            class="btn-action {{item.onlineStatus === 'online' ? 'btn-outline-danger' : 'btn-outline-primary'}}"
            catchtap="handleToggleStatus"
            data-id="{{item.id}}"
            data-status="{{item.onlineStatus}}"
          >
            {{item.onlineStatus === 'online' ? 'Draft' : 'Publish'}}
          </button>
        </view>
      </view>
    </view>
  </view>

    <empty-state
      wx:else
      title="No Corpus Ingested"
      description="Ingest a manuscript to start tracking knowledge pipeline."
    />
  </scroll-view>
</view>
