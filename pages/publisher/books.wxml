<view class="page-shell">
  <view class="page-intro">
    <view class="intro-eyebrow">
      <text>管理视角 · {{filteredBooks.length}} 册已录</text>
    </view>
    <text class="page-intro-title text-serif">书目生命周期管理</text>
    <text class="page-intro-desc">在这里，您可以快速检索图书、查看建库状态，并掌控每一本书的上下架节奏。</text>
  </view>

  <view class="input-shell">
    <text class="input-icon">⌕</text>
    <input
      class="input-field"
      placeholder="搜索书名、作者、分类"
      placeholder-style="color:var(--text-light);"
      value="{{searchValue}}"
      bindinput="handleSearchInput"
    />
  </view>

  <view wx:if="{{filteredBooks.length}}" class="publisher-book-list">
    <view
      wx:for="{{filteredBooks}}"
      wx:key="id"
      class="publisher-book card-panel"
      data-id="{{item.id}}"
      bindtap="handleBookTap"
    >
      <view class="publisher-book-top">
        <view class="book-info-area">
          <text class="publisher-book-title">{{item.title}}</text>
          <text class="publisher-book-author">{{item.author}}</text>
        </view>
        <button
          class="toggle-btn {{item.onlineStatus === 'online' ? '' : 'toggle-btn--active'}}"
          catchtap="handleToggleStatus"
          data-id="{{item.id}}"
          data-status="{{item.onlineStatus}}"
        >
          {{item.onlineStatus === 'online' ? '下架' : '上架'}}
        </button>
      </view>

      <view class="pill-row publisher-pills">
        <status-tag text="{{item.category || ''}}" theme="primary" />
        <status-tag type="build" status="{{item.buildStatus || ''}}" />
        <status-tag type="online" status="{{item.onlineStatus || ''}}" />
      </view>

      <view class="publisher-book-meta">
        <text class="publisher-meta-text">上传时间：{{item.uploadTime}}</text>
        <text class="publisher-meta-text">价格：¥{{item.price}}</text>
      </view>
    </view>
  </view>

  <empty-state
    wx:else
    title="暂时没有书目"
    description="上传一本书后，这里会显示你的出版社书单"
  />
</view>
