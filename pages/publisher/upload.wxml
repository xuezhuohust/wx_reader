<view class="page-shell">
  <!-- Custom Navigation Bar -->
  <view class="custom-nav" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="nav-left" bindtap="handleBack">
        <view class="chevron-left-black"></view>
      </view>
      <text class="nav-title">Document Ingestion</text>
    </view>
  </view>

  <scroll-view class="content-wrap" scroll-y enhanced show-scrollbar="{{false}}" style="padding-top: {{navBarHeight}}px;">
    <view class="page-header">
      <view class="header-intro">
        <view class="intro-badge">
          <text>Ingestion Pipeline</text>
        </view>
        <text class="header-title">Ingest Research Manuscript</text>
        <text class="header-desc">Specify metadata and upload source files to trigger vector pipeline</text>
      </view>
    </view>

  <view class="upload-form">
    <view class="form-group card-base">
      <view class="form-item">
        <text class="form-label">Manuscript Title</text>
        <input class="form-input" value="{{form.title}}" data-field="title" bindinput="handleInput" placeholder="Enter title" />
      </view>

      <view class="form-item">
        <text class="form-label">Author(s) / Investigators</text>
        <input class="form-input" value="{{form.author}}" data-field="author" bindinput="handleInput" placeholder="Enter author(s)" />
      </view>

      <view class="form-item">
        <text class="form-label">Institution / Publisher</text>
        <input class="form-input" value="{{form.publisher}}" data-field="publisher" bindinput="handleInput" placeholder="Enter institution or publisher" />
      </view>

      <view class="form-item">
        <text class="form-label">Research Field</text>
        <picker class="form-picker" range="{{categories}}" value="{{categoryIndex}}" bindchange="handleCategoryChange">
          <view class="picker-inner">
            <text class="picker-value">{{form.category || 'Select research field'}}</text>
            <view class="chevron-down-mini"></view>
          </view>
        </picker>
      </view>
    </view>

    <view class="form-group card-base">
      <view class="form-item">
        <text class="form-label">Abstract</text>
        <textarea class="form-textarea" value="{{form.description}}" data-field="description" bindinput="handleInput" placeholder="Enter manuscript abstract or summary" />
      </view>

      <view class="form-item">
        <text class="form-label">Access Fee / Price ($)</text>
        <input class="form-input" value="{{form.price}}" data-field="price" bindinput="handleInput" placeholder="0.00" type="digit" />
      </view>

      <view class="form-item no-border">
        <text class="form-label">License & Citation Statement</text>
        <textarea class="form-textarea" value="{{form.copyright}}" data-field="copyright" bindinput="handleInput" placeholder="Specify Open Access license, DOI, or rights" />
      </view>
    </view>

    <view class="file-upload-section card-base {{coverPath ? 'file-ready' : ''}}" bindtap="handleChooseCover">
      <block wx:if="{{coverPath}}">
        <image class="cover-preview" src="{{coverPath}}" mode="aspectFill" />
        <view class="upload-info">
          <text class="upload-title">Change Cover</text>
          <text class="upload-hint">Formats: JPG, PNG, WebP</text>
        </view>
      </block>
      <block wx:else>
        <view class="upload-icon-box">
          <view class="icon-svg icon-upload-cloud"></view>
        </view>
        <view class="upload-info">
          <text class="upload-title">Upload Cover Image</text>
          <text class="upload-hint">Formats: JPG, PNG, WebP, ≤5MB</text>
        </view>
      </block>
    </view>

    <view class="file-upload-section card-base {{fileName ? 'file-ready' : ''}}" bindtap="handleChooseFile">
      <view class="upload-icon-box">
        <view class="icon-svg {{fileName ? 'icon-file-ready' : 'icon-upload-cloud'}}"></view>
      </view>
      <view class="upload-info">
        <text class="upload-title">{{fileName || 'Click to upload manuscript source'}}</text>
        <text class="upload-hint">Formats: .pdf / .docx / .txt</text>
      </view>
    </view>

    <view class="submit-section">
      <button class="btn-submit" bindtap="handleSubmit">Submit & Initiate Indexing</button>
    </view>
  </view>

  <view wx:if="{{showUploadPrivacyModal}}" class="privacy-overlay" catchtap="handleDisagreeUploadPrivacy">
    <view class="privacy-sheet" catchtap="handleStopPropagation">
      <view class="privacy-header">
        <text class="privacy-title">文件上传说明</text>
      </view>
      <view class="privacy-content">
        <text class="privacy-text">上传源文件需要读取您主动选择的本地文件。文件将用于书籍内容建库、解析和后续阅读服务，不会读取未选择的其他文件。</text>
      </view>
      <view class="privacy-actions">
        <button class="btn-secondary" bindtap="handleDisagreeUploadPrivacy">取消</button>
        <button
          id="upload-file-privacy-agree"
          class="btn-primary"
          open-type="agreePrivacyAuthorization"
          bindagreeprivacyauthorization="handleAgreeUploadPrivacy"
        >同意并选择</button>
      </view>
    </view>
  </view>
  </scroll-view>
</view>
