.detail-page {
  position: relative;
  overflow-x: hidden;
  background: var(--bg-canvas);
  min-height: 100vh;
}

/* Custom Navigation Bar */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: transparent;
  transition: all 0.3s ease;
}

.nav--scrolled {
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-bottom: 1rpx solid var(--hairline);
}

.nav-inner {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

.back-arrow {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid var(--ink);
  border-bottom: 4rpx solid var(--ink);
  transform: rotate(45deg);
  margin-left: 12rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
  margin-right: calc(10rpx + 32px);
}

.content-body {
  padding: 0 48rpx;
  position: relative;
  z-index: 1;
  padding-bottom: calc(340rpx + env(safe-area-inset-bottom));
}

/* Book Hero */
.book-hero {
  display: flex;
  gap: 48rpx;
  padding: 40rpx 0;
  margin-bottom: 40rpx;
}

.hero-left {
  flex-shrink: 0;
}

.detail-cover-box {
  width: 240rpx;
  height: 330rpx;
  border-radius: var(--radius-sm);
  background: #fff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.15);
  overflow: hidden;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.hero-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.detail-author-row {
  margin-bottom: 20rpx;
}

.detail-author {
  font-size: 28rpx;
  color: var(--steel);
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* Stats Row */
.stats-card {
  display: flex;
  padding: 32rpx 20rpx;
  background: var(--bg-surface-soft);
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--hairline);
  margin-bottom: 48rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  min-width: 0;
}

.stat-value {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  width: 100%;
  line-height: 1.2;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  word-break: break-all;
}

.stat-label {
  font-size: 20rpx;
  color: var(--stone);
  text-transform: uppercase;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: var(--hairline-strong);
  align-self: center;
}

/* Info Cards */
.info-card {
  margin-bottom: 48rpx;
  background: var(--bg-surface-soft);
  padding: 32rpx;
  border-radius: var(--radius-lg);
  border: 1rpx solid var(--hairline-soft);
}

.info-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-card-title::before {
  content: "";
  width: 6rpx;
  height: 24rpx;
  background: var(--notion-primary);
  border-radius: var(--radius-full);
}

.info-card-content {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--charcoal);
  text-align: justify;
  display: block;
}

.chapter-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.chapter-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #ffffff;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--hairline-soft);
  transition: all 0.2s;
}

.chapter-item:active {
  background: var(--bg-surface);
}

.chapter-index {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--stone);
  width: 48rpx;
}

.chapter-name {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

/* Copyright Area */
.copyright-area {
  padding: 40rpx 0;
  text-align: center;
  opacity: 0.5;
}

.copyright-text {
  font-size: 22rpx;
  color: var(--stone);
}

/* Bottom Action Bar */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10px);
  padding: 32rpx 48rpx calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid var(--hairline);
  z-index: 100;
}

.reader-action-stack {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.btn-primary-full {
  width: 100%;
  background: var(--notion-primary);
  color: #fff;
  height: 96rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(19, 30, 56, 0.15);
  transition: all 0.2s;
}

.btn-primary-full:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.btn-clear-sessions {
  width: 100%;
  height: 72rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #d64545;
  background: rgba(214, 69, 69, 0.06);
  border: 1rpx solid rgba(214, 69, 69, 0.35);
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: none;
}

.btn-clear-sessions:active {
  transform: scale(0.98);
  background: rgba(214, 69, 69, 0.1);
}

.publisher-action-row {
  display: flex;
  gap: 24rpx;
}
