.detail-page {
  background-color: #faf8f5;
  color: #1b1b1b;
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

/* Custom Nav */
.detail-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: transparent;
  transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.nav--scrolled {
  background: rgba(250, 248, 245, 0.95);
  backdrop-filter: blur(12px);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.nav-inner {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.nav-back {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #fff;
  border: 1rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-back {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #1b1b1b;
  border-bottom: 4rpx solid #1b1b1b;
  transform: rotate(45deg);
  margin-left: 6rpx;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 28rpx;
  font-weight: 700;
  color: #1b1b1b;
  max-width: 400rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  animation: fadeIn 0.3s both;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* Scroll Area */
.scroll-area {
  flex: 1;
  overflow: hidden;
}

.scroll-content {
  padding: 40rpx 48rpx 240rpx;
}

/* Hero Section New */
.book-hero-new {
  display: flex;
  gap: 32rpx;
  margin-bottom: 56rpx;
  align-items: flex-start;
}

.hero-cover-part {
  flex-shrink: 0;
}

.hero-info-part {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-top: 8rpx;
}

.detail-cover {
  width: 240rpx;
  height: 336rpx;
  border-radius: 12rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-title {
  font-size: 38rpx; word-break: break-word;
  font-weight: 900;
  color: #1b1b1b;
  font-family: "Noto Serif SC", serif;
  line-height: 1.2;
  margin-bottom: 12rpx;
  letter-spacing: -1rpx;
  text-align: left;
}

.detail-author {
  font-size: 26rpx;
  color: #8c8c8c;
  font-weight: 500;
  margin-bottom: 32rpx;
  text-align: left;
}

/* Notion Properties */
.notion-properties {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.prop-item {
  display: flex;
  align-items: center;
  font-size: 24rpx;
}

.prop-label {
  width: 140rpx;
  color: #bfbfbf;
  flex-shrink: 0;
}

.prop-value {
  color: #4a4a4a;
  font-weight: 500;
}

.prop-value.status--active {
  color: #0071e3;
  font-weight: 700;
}

/* Stats Row Removed, sections gap adjusted */
.detail-sections {
  display: flex;
  flex-direction: column;
  gap: 80rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 900;
  color: #1b1b1b;
  margin-bottom: 24rpx;
  letter-spacing: -0.5rpx;
}

.section-content {
  font-size: 28rpx;
  line-height: 1.7;
  color: #4a4a4a;
}

.section-content.description {
  text-align: justify;
}

.section-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-subtitle {
  font-size: 22rpx;
  font-weight: 700;
  color: #8c8c8c;
}

.chapter-list {
  display: flex;
  flex-direction: column;
}

.chapter-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
  background-color: transparent;
  border-radius: 0;
  border: none;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: none;
  transition: all 0.2s ease;
}

.chapter-item:last-child {
  border-bottom: none;
}

.chapter-item:active {
  opacity: 0.6;
}

.chapter-info {
  flex: 1;
  min-width: 0;
}

.chapter-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #4a4a4a;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  display: block;
}

.chapter-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 24rpx;
  flex-shrink: 0;
}

.meta-text {
  font-size: 24rpx;
  color: #bfbfbf;
  font-weight: 500;
}

.icon-play {
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 12rpx solid #bfbfbf;
  margin-left: 4rpx;
}

.expand-btn {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #0071e3;
  padding: 20rpx 0;
  background: transparent;
}

.icon-arrow {
  width: 10rpx;
  height: 10rpx;
  border-right: 3rpx solid #0071e3;
  border-bottom: 3rpx solid #0071e3;
  transition: all 0.3s ease;
}

.arrow-down {
  transform: rotate(45deg);
  margin-top: -6rpx;
}

.arrow-up {
  transform: rotate(-135deg);
  margin-top: 6rpx;
}

/* Footer */
.detail-footer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 64rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f5f5f7 85%, rgba(245, 245, 247, 0));
  z-index: 1000;
}

.action-btn-primary {
  background-color: #1b1b1b;
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  height: 100rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1); /* 大幅减弱投影，去立体感 */
  width: 100% !important;
}

.action-btn-primary:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.publisher-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn-secondary {
  flex: 1;
  background-color: #fff;
  color: #ff4d4f;
  font-size: 28rpx;
  font-weight: 700;
  height: 100rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 77, 79, 0.2);
}

.action-btn-primary {
  flex: 2;
}

.copyright {
  text-align: center;
  font-size: 20rpx;
  color: #bfbfbf;
  margin-top: 80rpx;
  padding-bottom: 40rpx;
}

/* Placeholder Flat */
.book-placeholder-inner-flat {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  opacity: 0.2;
}

.placeholder-title-flat {
  font-weight: 900;
  color: #1b1b1b;
  font-family: "Noto Serif SC", serif;
}

/* Animations & Loading */
.loading-full, .error-full {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  color: #8c8c8c;
  font-size: 26rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.05);
  border-top-color: #0071e3;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.fade-up {
  animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
}
.d1 { animation-delay: 0ms; }
.d2 { animation-delay: 80ms; }
.d3 { animation-delay: 160ms; }
.d4 { animation-delay: 240ms; }
.d5 { animation-delay: 320ms; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* Pad 横屏时不让手机稿的 rpx 随窗口宽度成倍放大。 */
.detail-page--large .scroll-area {
  flex: 1;
  height: 0;
  min-height: 0;
}

.detail-page--large .nav-inner {
  padding: 0 32px;
}

.detail-page--large .nav-back {
  width: 40px;
  height: 40px;
}

.detail-page--large .icon-back {
  width: 11px;
  height: 11px;
  border-left-width: 2px;
  border-bottom-width: 2px;
  margin-left: 3px;
}

.detail-page--large .nav-title {
  max-width: 320px;
  font-size: 16px;
}

.detail-page--large .scroll-content {
  padding: 0 32px 112px;
}

.detail-page--large .book-hero-new {
  gap: 24px;
  margin-bottom: 8px;
}

.detail-page--large .detail-cover {
  width: 160px;
  height: 224px;
  border-radius: 10px;
}

.detail-page--large .detail-title {
  font-size: 30px;
  margin-bottom: 8px;
  text-align: center;
}

.detail-page--large .detail-author {
  font-size: 16px;
  margin-bottom: 20px;
  text-align: center;
}

.detail-page--large .notion-properties {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 18px;
  row-gap: 10px;
}

.detail-page--large .prop-item {
  font-size: 15px;
  min-width: 0;
}

.detail-page--large .prop-label {
  width: 64px;
}

.detail-page--large .detail-sections {
  gap: 24px;
}

.detail-page--large .section-title {
  font-size: 22px;
  margin-bottom: 14px;
}

.detail-page--large .section-content {
  font-size: 16px;
  line-height: 1.75;
}

.detail-page--large .section-header {
  margin-bottom: 14px;
}

.detail-page--large .section-subtitle,
.detail-page--large .meta-text {
  font-size: 13px;
}

.detail-page--large .chapter-item {
  padding: 16px 0;
}

.detail-page--large .chapter-name {
  font-size: 16px;
}

.detail-page--large .chapter-meta {
  gap: 6px;
  margin-left: 16px;
}

.detail-page--large .expand-btn {
  margin-top: 14px;
  gap: 6px;
  font-size: 14px;
  padding: 10px 0;
}

.detail-page--large .detail-footer {
  padding: 12px 32px 20px;
}

.detail-page--large .action-btn-primary,
.detail-page--large .action-btn-secondary {
  height: 56px;
  border-radius: 12px;
  font-size: 17px;
}

.detail-page--large .publisher-actions {
  gap: 12px;
}
