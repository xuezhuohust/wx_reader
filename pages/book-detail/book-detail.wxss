.detail-page {
  position: relative;
  overflow-x: hidden;
  background: var(--bg-paper);
  min-height: 100vh;
}

/* Decorative Backgrounds */
.bg-decor-circle {
  position: fixed;
  top: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(194, 65, 12, 0.05) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
}

.bg-decor-blob {
  position: fixed;
  bottom: 20%;
  left: -150rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(44, 44, 44, 0.03) 0%, transparent 70%);
  z-index: 0;
  pointer-events: none;
  filter: blur(40px);
}

/* Custom Navigation Bar */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(248, 246, 242, 0.85);
  backdrop-filter: blur(20px);
  border-bottom: 1rpx solid rgba(238, 237, 232, 0.8);
}

.nav-inner {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.nav-back {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 10rpx;
}

.back-arrow {
  width: 24rpx;
  height: 24rpx;
  border-left: 4rpx solid var(--text-ink);
  border-bottom: 4rpx solid var(--text-ink);
  transform: rotate(45deg);
  margin-left: 8rpx;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-ink);
  margin-right: calc(10rpx + 32px); /* Compensation for back button width to center title */
}

.content-body {
  padding: 0 40rpx;
  position: relative;
  z-index: 1;
}

.detail-page--reader {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.detail-poster {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 60rpx;
  text-align: center;
}

.poster-cover-wrap {
  margin-bottom: 48rpx;
  filter: drop-shadow(0 20rpx 40rpx rgba(0,0,0,0.12));
}

.poster-info {
  width: 100%;
}

.poster-title {
  display: block;
  font-size: 52rpx;
  font-weight: 800;
  color: var(--text-ink);
  line-height: 1.2;
  margin-bottom: 16rpx;
}

.poster-meta {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.meta-item {
  font-size: 24rpx;
  color: var(--text-muted);
  font-weight: 500;
}

.meta-divider {
  font-size: 20rpx;
  color: var(--border-ink);
}

.poster-tags {
  display: flex;
  justify-content: center;
  gap: 12rpx;
}

/* Price & Stats Hero */
.price-hero {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 48rpx;
  background: #ffffff;
  border-radius: 32rpx;
}

.price-main {
  display: flex;
  flex-direction: column;
}

.price-label, .stat-label {
  font-size: 20rpx;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 4rpx;
}

.price-value {
  font-size: 44rpx;
  font-weight: 800;
  color: var(--accent-literary);
}

.stat-item {
  text-align: right;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text-ink);
}

/* Description Refinement */
.description-section {
  padding: 20rpx 0;
}

.section-header-minimal {
  margin-bottom: 24rpx;
  border-bottom: 1rpx solid var(--border-subtle);
  padding-bottom: 16rpx;
}

.section-title-minimal {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-ink);
  position: relative;
}

.description-content {
  padding: 10rpx 0;
}

.description-text {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--text-body);
  text-align: justify;
}

/* Chapter List Refinement */
.section-header-refined {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 40rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid var(--border-subtle);
}

.header-left {
  position: relative;
}

.title-underline {
  position: absolute;
  bottom: -16rpx;
  left: 0;
  width: 40rpx;
  height: 4rpx;
  background: var(--accent-literary);
  border-radius: 2rpx;
}

.section-subtitle {
  font-size: 20rpx;
  color: var(--text-muted);
  font-weight: 700;
  letter-spacing: 0.15em;
  opacity: 0.6;
}

.chapter-list-refined {
  display: flex;
  flex-direction: column;
}

.chapter-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.chapter-row:last-child {
  border-bottom: none;
}

.chapter-main-info {
  display: flex;
  align-items: baseline;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
}

.chapter-num {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--accent-literary);
  width: 40rpx;
  font-style: italic;
  flex-shrink: 0;
  opacity: 0.8;
}

.chapter-title {
  font-size: 28rpx;
  color: var(--text-ink);
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 70%;
}

.chapter-filler {
  flex: 1;
  margin: 0 16rpx;
  border-bottom: 2rpx dotted rgba(0, 0, 0, 0.1);
  transform: translateY(-4rpx);
}

.chapter-page {
  font-size: 22rpx;
  color: var(--text-muted);
  font-weight: 600;
  flex-shrink: 0;
  font-family: "Charter", serif;
  opacity: 0.6;
}

.action-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(25px);
  z-index: 100;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 -10rpx 40rpx rgba(0, 0, 0, 0.03);
}

.action-main {
  width: 100%;
  height: 104rpx;
  border-radius: 100rpx;
  background: var(--text-ink);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center; 
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.2);
  border: none;
}

.action-main:active {
  transform: scale(0.97);
  background: #000;
}

.publisher-actions {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.action-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 100rpx;
  background: var(--text-ink);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.1);
}

.action-btn--ghost {
  background: #fff;
  color: var(--text-ink);
  border: 1rpx solid var(--border-ink);
  box-shadow: none;
}

.action-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

/* Publisher Ops Grid */
.ops-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
  padding: 10rpx 0;
}

.grid-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.grid-label {
  font-size: 22rpx;
  color: var(--text-muted);
}

.grid-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-ink);
}

.status-online {
  color: #10b981;
}

/* Build Progress */
.build-progress {
  display: block;
  margin: 20rpx 0;
}

.build-desc {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-body);
  opacity: 0.8;
}

.build-task-text {
  display: block;
  font-size: 22rpx;
  color: var(--text-muted);
  margin-top: 12rpx;
}

.build-error-text {
  display: block;
  font-size: 22rpx;
  color: var(--accent-literary);
  margin-top: 12rpx;
}

/* Copyright Section */
.copyright-section {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 40rpx;
  opacity: 0.4;
  justify-content: center;
}

.copyright-mark {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-muted);
}

.copyright-text {
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-muted);
  max-width: 80%;
  text-align: center;
}

/* Nuanced Cover Themes - More Literary */
.cover-sunset { background: linear-gradient(135deg, #e67e22, #d35400); }
.cover-atlas { background: linear-gradient(135deg, #34495e, #2c3e50); }
.cover-graphite { background: linear-gradient(135deg, #7f8c8d, #2c3e50); }
.cover-mint { background: linear-gradient(135deg, #27ae60, #16a085); }
.cover-rose { background: linear-gradient(135deg, #e74c3c, #c0392b); }
.cover-cobalt { background: linear-gradient(135deg, #2980b9, #2c3e50); }
.cover-sand { background: linear-gradient(135deg, #f1c40f, #f39c12); }
.cover-forest { background: linear-gradient(135deg, #2ecc71, #27ae60); }
