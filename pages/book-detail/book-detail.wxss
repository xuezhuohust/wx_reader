.detail-page--reader {
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

.page-intro {
  padding: 12rpx 0 56rpx;
  background: transparent;
}

.intro-eyebrow {
  margin-bottom: 24rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--accent-literary);
  text-transform: uppercase;
  letter-spacing: 0.12em;
}

.page-intro-title {
  display: block;
  font-size: 54rpx;
  font-weight: 600;
  line-height: 1.2;
  color: var(--text-ink);
}

.page-intro-desc {
  display: block;
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-body);
  opacity: 0.78;
}

.section-container {
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.section-title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text-ink);
}

.section-more {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--accent-literary);
  font-weight: 500;
}

.detail-hero {
  padding: 32rpx;
}

.detail-cover {
  height: 440rpx;
  padding: 40rpx 36rpx;
  border-radius: var(--radius-document);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  color: #ffffff;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.14);
  position: relative;
  overflow: hidden;
}

.detail-cover::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.08) 0%, rgba(0, 0, 0, 0.34) 100%);
}

.detail-cover::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  bottom: 0;
  width: 16rpx;
  background: linear-gradient(to right, rgba(0, 0, 0, 0.18), transparent);
}

.cover-sunset { background: #d97706; }
.cover-atlas { background: #1e293b; }
.cover-graphite { background: #4b5563; }
.cover-mint { background: #059669; }
.cover-rose { background: #be123c; }
.cover-cobalt { background: #2563eb; }
.cover-sand { background: #92400e; }
.cover-forest { background: #065f46; }

.detail-cover-category,
.detail-cover-title,
.detail-cover-author {
  position: relative;
  z-index: 1;
}

.detail-cover-category {
  align-self: flex-start;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(8rpx);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: auto;
}

.detail-cover-title {
  font-size: 48rpx;
  line-height: 1.24;
  font-weight: 600;
}

.detail-cover-author {
  margin-top: 16rpx;
  font-size: 26rpx;
  opacity: 0.92;
}

.detail-main {
  margin-top: 40rpx;
}

.pill-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.detail-title {
  display: block;
  font-size: 46rpx;
  font-weight: 600;
  line-height: 1.24;
  color: var(--text-ink);
}

.detail-author,
.detail-publisher {
  display: block;
  margin-top: 10rpx;
  font-size: 28rpx;
  color: var(--text-muted);
}

.detail-price {
  display: block;
  margin-top: 24rpx;
  font-size: 44rpx;
  font-weight: 600;
  color: var(--accent-literary);
}

.detail-desc {
  display: block;
  margin-top: 28rpx;
  font-size: 30rpx;
  line-height: 1.72;
  color: var(--text-body);
}

.info-card {
  padding: 40rpx;
}

.chapter-list {
  margin-top: 8rpx;
}

.chapter-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-subtle);
}

.chapter-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.chapter-index {
  flex-shrink: 0;
  width: 40rpx;
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--accent-literary);
  font-weight: 600;
}

.chapter-name {
  flex: 1;
  font-size: 30rpx;
  line-height: 1.72;
  color: var(--text-ink);
}

.build-progress {
  display: block;
  margin-top: 8rpx;
}

.build-desc,
.build-task-text,
.build-error-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.68;
}

.build-desc {
  margin-top: 28rpx;
  color: var(--text-body);
}

.build-task-text {
  margin-top: 14rpx;
  color: var(--text-muted);
}

.build-error-text {
  margin-top: 16rpx;
  color: var(--accent-literary);
}

.ops-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 32rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-subtle);
}

.ops-item:first-child {
  padding-top: 8rpx;
}

.ops-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.ops-label {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-muted);
}

.ops-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-ink);
}

.ops-value--multiline {
  line-height: 1.72;
}

.copyright-text {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.72;
  color: var(--text-body);
}

.action-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, var(--bg-paper) 80%, transparent);
  z-index: 100;
}

.action-main {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  box-shadow: var(--shadow-soft);
}

.publisher-action-wrap {
  display: flex;
  gap: 24rpx;
  margin-top: 12rpx;
}

.publisher-action-btn {
  flex: 1;
  min-height: 96rpx;
  border-radius: 20rpx;
}
