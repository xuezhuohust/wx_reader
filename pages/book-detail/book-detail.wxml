<view class="page-container detail-page">
  <!-- Custom Navigation Bar -->
  <view class="detail-nav {{scrolled ? 'nav--scrolled' : ''}}" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="nav-back" bindtap="handleBack">
        <view class="icon-back"></view>
      </view>
      <view class="nav-title" wx:if="{{scrolled}}">{{book.title}}</view>
    </view>
  </view>

  <!-- Loading State -->
  <view wx:if="{{loading}}" class="loading-full">
    <view class="loading-spinner"></view>
    <text>正在翻开书页...</text>
  </view>

  <block wx:elif="{{book}}">
    <scroll-view 
      class="scroll-area" 
      scroll-y 
      enhanced 
      show-scrollbar="{{false}}" 
      bindscroll="onPageScroll"
    >
      <view class="scroll-content" style="padding-top: {{navBarHeight + 20}}px;">
        <!-- Hero Section: Left Aligned -->
        <view class="book-hero-new fade-up d1">
          <view class="hero-cover-part">
            <view class="detail-cover" style="background: {{book.coverColor || '#f3efe8'}}">
              <image wx:if="{{book.coverUrl}}" src="{{book.coverUrl}}" mode="aspectFill"></image>
              <view class="book-placeholder-inner-flat" wx:else>
                <view class="placeholder-title-flat" style="font-size: 100rpx;">{{book.title[0]}}</view>
              </view>
            </view>
          </view>
          <view class="hero-info-part">
            <view class="detail-title">{{book.title}}</view>
            <view class="detail-author">{{book.author || '佚名'}}</view>
            
            <!-- Notion Style Properties -->
            <view class="notion-properties">
              <view class="prop-item">
                <view class="prop-label">分类</view>
                <view class="prop-value">{{book.category || '未分类'}}</view>
              </view>
              <view class="prop-item">
                <view class="prop-label">状态</view>
                <view class="prop-value {{book.purchased ? 'status--active' : ''}}">
                  {{book.purchased ? '已解锁全书' : '待解锁'}}
                </view>
              </view>
              <view class="prop-item">
                <view class="prop-label">价格</view>
                <view class="prop-value">{{priceText || '免费'}}</view>
              </view>
              <view class="prop-item">
                <view class="prop-label">章节</view>
                <view class="prop-value">{{chapterCount}} 章节</view>
              </view>
            </view>
          </view>
        </view>

        <!-- Description Section -->
        <view class="detail-sections">
          <view class="section fade-up d2">
            <view class="section-title">简介</view>
            <view class="section-content description">{{book.description || '暂无详细介绍'}}</view>
          </view>

          <view class="section fade-up d4">
            <view class="section-header">
              <view class="section-title">目录</view>
              <view class="section-subtitle">共 {{chapterCount}} 章节</view>
            </view>
            <view class="chapter-list">
              <view 
                class="chapter-item" 
                wx:for="{{visibleChapters}}" 
                wx:key="*this"
                data-index="{{index}}"
                bindtap="handleReadChapter"
              >
                <view class="chapter-info">
                  <text class="chapter-name">{{item}}</text>
                </view>
                <view class="chapter-meta">
                  <text class="meta-text">阅读</text>
                  <view class="icon-play"></view>
                </view>
              </view>
            </view>
            <view 
              class="expand-btn" 
              wx:if="{{hasHiddenChapters}}" 
              bindtap="handleToggleChapters"
            >
              <text>{{chaptersExpanded ? '收起目录' : '展开全部章节'}}</text>
              <view class="icon-arrow {{chaptersExpanded ? 'arrow-up' : 'arrow-down'}}"></view>
            </view>
          </view>
        </view>

        <view class="copyright fade-up d5">
          {{book.copyright || '© 2026 读书系统 · AI 智能导读技术支持'}}
        </view>
        
        <view class="safe-area-bottom"></view>
      </view>
    </scroll-view>

    <!-- Bottom Action Bar -->
    <view class="detail-footer fade-up d5">
      <block wx:if="{{!isPublisherScene}}">
        <button class="action-btn-primary" bindtap="handleAction">
          {{book.purchased ? '进入 AI 沉浸导读' : '立即解锁全书导读'}}
        </button>
      </block>
      <block wx:else>
        <view class="publisher-actions">
          <button class="action-btn-secondary" bindtap="handleDelete">删除书籍</button>
          <button class="action-btn-primary" bindtap="handleToggleOnline">
            {{book.onlineStatus === 'online' ? '下架书籍' : '立即上架'}}
          </button>
        </view>
      </block>
    </view>
  </block>

  <!-- Error State -->
  <view wx:elif="{{!loading}}" class="error-full">
    <view class="error-icon"></view>
    <text>内容加载失败，请重试</text>
    <button class="retry-btn" bindtap="loadBook">重新加载</button>
  </view>
</view>
