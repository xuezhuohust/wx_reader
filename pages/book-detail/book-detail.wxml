<view wx:if="{{book}}" class="page-shell detail-page">
  <!-- Custom Navigation Bar -->
  <view class="custom-nav {{scrolled ? 'nav--scrolled' : ''}}" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px; padding-left: 0;">
      <view class="nav-back" bindtap="handleBack" style="width: {{menuHeight}}px; height: {{menuHeight}}px;">
        <view class="back-arrow"></view>
      </view>
      <view class="nav-title" wx:if="{{scrolled}}">{{book.title}}</view>
    </view>
  </view>

  <view class="content-body" style="padding-top: {{navBarHeight + 20}}px;">
    <!-- Book Hero Section -->
    <view class="book-hero">
      <view class="hero-left">
        <view class="detail-cover-box">
          <image class="cover-image" src="{{book.coverUrl || 'https://mp-8bdc7c18-cba4-4488-8c57-e587ac252b55.cdn.bspapp.com/fengmian.png'}}" mode="aspectFit" />
        </view>
      </view>
      <view class="hero-right">
        <text class="detail-title">{{book.title}}</text>
        <view class="detail-author-row">
          <text class="detail-author">{{book.author}}</text>
        </view>
        <view class="detail-tags">
          <status-tag text="{{book.category}}" theme="primary" />
          <status-tag wx:if="{{book.purchased}}" text="已解锁" theme="success" />
        </view>
      </view>
    </view>

    <!-- Stats Row -->
    <view class="section-container">
      <view class="stats-card">
        <view class="stat-item">
          <text class="stat-value">{{priceText}}</text>
          <text class="stat-label">价格</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{book.chapters.length || 0}}</text>
          <text class="stat-label">章节</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-value">{{book.publisher}}</text>
          <text class="stat-label">出版商</text>
        </view>
      </view>
    </view>

    <!-- Description -->
    <view class="section-container">
      <view class="info-card">
        <text class="info-card-title">简介</text>
        <text class="info-card-content">{{book.description}}</text>
      </view>
    </view>

    <!-- Chapters List -->
    <view class="section-container">
      <view class="info-card">
        <text class="info-card-title">目录</text>
        <view class="chapter-list">
          <view wx:for="{{book.chapters}}" wx:key="*this" class="chapter-item">
            <text class="chapter-index">{{index + 1}}</text>
            <text class="chapter-name">{{item}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Copyright -->
    <view class="section-container copyright-area">
      <text class="copyright-text">{{book.copyright || '© 2026 读书系统. All rights reserved.'}}</text>
    </view>
  </view>

  <!-- Bottom Actions -->
  <view class="bottom-action-bar">
    <block wx:if="{{!isPublisherScene}}">
      <view class="reader-action-stack">
        <button class="btn-primary-full" bindtap="handleAction">
          {{book.purchased ? '进入 AI 沉浸导读' : '立即解锁导读'}}
        </button>
        <button wx:if="{{book.purchased}}" class="btn-clear-sessions" bindtap="handleClearConversations">
          清空历史对话
        </button>
      </view>
    </block>
    <block wx:else>
      <view class="publisher-action-row">
        <button class="btn-secondary" bindtap="handleDelete">删除</button>
        <button class="btn-primary" style="flex: 1;" bindtap="handleToggleOnline">
          {{book.onlineStatus === 'online' ? '下架书籍' : '立即上架'}}
        </button>
      </view>
    </block>
  </view>
</view>
