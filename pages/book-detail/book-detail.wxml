<view class="page-container detail-page {{isLargeScreen ? 'detail-page--large' : ''}}" style="{{windowHeight ? 'height: ' + windowHeight + 'px;' : ''}}">
  <!-- Custom Navigation Bar -->
  <view class="detail-nav {{scrolled ? 'nav--scrolled' : ''}}" style="height: {{navBarHeight}}px;">
    <view class="nav-inner" style="top: {{menuTop}}px; height: {{menuHeight}}px;">
      <view class="nav-back" bindtap="handleBack">
        <view class="icon-back"></view>
      </view>
      <view class="nav-title" wx:if="{{scrolled}}">{{book.title}}</view>
    </view>
  </view>

  <!-- Loading State -->
  <view wx:if="{{loading}}" class="loading-full">
    <view class="loading-spinner"></view>
    <text>Loading manuscript details...</text>
  </view>

  <block wx:elif="{{book}}">
    <scroll-view 
      class="scroll-area" 
      scroll-y 
      enhanced 
      show-scrollbar="{{false}}" 
      bindscroll="onPageScroll"
    >
      <view class="scroll-content" style="padding-top: {{isLargeScreen ? navBarHeight + 32 : navBarHeight + 20}}px;">
        <!-- Hero Section: Left Aligned -->
        <view class="book-hero-new fade-up d1">
          <view class="hero-cover-part">
            <view class="detail-cover" style="background: {{book.coverColor || '#f3efe8'}}">
              <image wx:if="{{book.coverUrl}}" src="{{book.coverUrl}}" mode="aspectFill"></image>
              <view class="book-placeholder-inner-flat" wx:else>
                <view class="placeholder-title-flat" style="font-size: 100rpx;">{{book.title[0]}}</view>
              </view>
            </view>
          </view>
          <view class="hero-info-part">
            <view class="detail-title">{{book.title}}</view>
            <view class="detail-author">{{book.author || 'Anonymous Scholar'}}</view>
            
            <!-- Notion Style Properties -->
            <view class="notion-properties">
              <view class="prop-item">
                <view class="prop-label">Field</view>
                <view class="prop-value">{{book.category || 'General Corpus'}}</view>
              </view>
              <view class="prop-item">
                <view class="prop-label">Status</view>
                <view class="prop-value {{book.purchased ? 'status--active' : ''}}">
                  {{book.purchased ? 'Indexed' : 'Unindexed'}}
                </view>
              </view>
              <view class="prop-item">
                <view class="prop-label">Access</view>
                <view class="prop-value">{{priceText || 'Open Access'}}</view>
              </view>
              <view class="prop-item">
                <view class="prop-label">Sections</view>
                <view class="prop-value">{{chapterCount}} Chapters</view>
              </view>
              <view class="prop-item" wx:if="{{isLargeScreen}}">
                <view class="prop-label">Length</view>
                <view class="prop-value">{{displayWordCount}}</view>
              </view>
              <view class="prop-item" wx:if="{{isLargeScreen}}">
                <view class="prop-label">Score</view>
                <view class="prop-value">{{displayRating}}</view>
              </view>
            </view>
          </view>
        </view>

        <!-- Description Section -->
        <view class="detail-sections">
          <view class="section fade-up d2">
            <view class="section-title">Abstract</view>
            <view class="section-content description">{{book.description || 'No abstract available'}}</view>
          </view>

          <view class="section fade-up d4">
            <view class="section-header">
              <view class="section-title">Table of Contents</view>
              <view class="section-subtitle">Total {{chapterCount}} Sections</view>
            </view>
            <view class="chapter-list">
              <view 
                class="chapter-item" 
                wx:for="{{visibleChapters}}" 
                wx:key="*this"
                data-index="{{index}}"
                bindtap="handleReadChapter"
              >
                <view class="chapter-info">
                  <text class="chapter-name">{{item}}</text>
                </view>
                <view class="chapter-meta">
                  <text class="meta-text">Read</text>
                  <view class="icon-play"></view>
                </view>
              </view>
            </view>
            <view 
              class="expand-btn" 
              wx:if="{{hasHiddenChapters}}" 
              bindtap="handleToggleChapters"
            >
              <text>{{chaptersExpanded ? 'Collapse' : 'Expand All'}}</text>
              <view class="icon-arrow {{chaptersExpanded ? 'arrow-up' : 'arrow-down'}}"></view>
            </view>
          </view>
        </view>

        <view class="copyright fade-up d5" wx:if="{{displayCopyright}}">
          {{displayCopyright}}
        </view>
        
        <view class="safe-area-bottom"></view>
      </view>
    </scroll-view>

    <!-- Bottom Action Bar -->
    <view class="detail-footer fade-up d5">
      <block wx:if="{{!isPublisherScene}}">
        <button class="action-btn-primary" bindtap="handleAction">
          {{book.purchased ? (hasProgress ? 'Resume Reading' : 'Start Reading') : 'Access Full Document'}}
        </button>
      </block>
      <block wx:else>
        <view class="publisher-actions">
          <button class="action-btn-secondary" bindtap="handleDelete">Delete Document</button>
          <button class="action-btn-primary" bindtap="handleToggleOnline">
            {{book.onlineStatus === 'online' ? 'Unpublish' : 'Publish'}}
          </button>
        </view>
      </block>
    </view>
  </block>

  <!-- Error State -->
  <view wx:elif="{{!loading}}" class="error-full">
    <view class="error-icon"></view>
    <text>Failed to load manuscript</text>
    <button class="retry-btn" bindtap="loadBook">Retry</button>
  </view>
</view>
