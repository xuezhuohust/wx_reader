.tab-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  z-index: 99;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.tab-inner {
  display: flex;
  height: 100rpx; /* Slightly reduced height */
  align-items: center;
}

.tab-item {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.3;
  transition: all 0.2s ease;
}

.tab-item--active.tab-item--reader .tab-icon {
  opacity: 1;
  /* Filter for #131e38 (Navy) */
  filter: brightness(0) saturate(100%) invert(9%) sepia(35%) saturate(1142%) hue-rotate(185deg) brightness(95%) contrast(96%);
}

.tab-item--active.tab-item--publisher .tab-icon {
  opacity: 1;
  /* Filter for rgb(10, 120, 105) */
  filter: brightness(0) saturate(100%) invert(35%) sepia(87%) saturate(415%) hue-rotate(125deg) brightness(93%) contrast(96%);
}

.tab-label {
  font-size: 20rpx;
  color: var(--stone);
  margin-top: 6rpx;
  font-weight: 500;
}

.tab-item--active.tab-item--reader .tab-label {
  color: var(--theme-reader);
  font-weight: 600;
}

.tab-item--active.tab-item--publisher .tab-label {
  color: rgb(10, 120, 105);
  font-weight: 600;
}
